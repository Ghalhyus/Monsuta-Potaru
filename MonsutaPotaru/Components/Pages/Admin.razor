@page "/administration"
@attribute [Authorize(Roles = SiteRoles.Admin)]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using MonsutaPotaru.Data
@using MonsutaPotaru.Services
@inject AdminService Administration
@inject DebugService Debug
@inject NavigationManager Navigation

<PageTitle>Administration</PageTitle>

@* Réservée aux administrateurs (SiteRoles). Onglet « Général » : code d'invitation, mode debug, rôles des comptes ; chaque
   action revérifie le rôle en base (AdminService) : le cookie de connexion peut garder un rôle retiré pendant quelques
   minutes. Onglet « Échecs » (?onglet=echecs) : équilibrage des équipes d'échecs (ChessBalanceTables), avec ou sans
   les brouillons (&brouillons=oui). Onglet « Brouillons d'échecs » (?onglet=brouillons-echecs) : équipes proposées,
   jamais jouées (ChessTeamDrafts). *@

<PageHeader Title="Administration" Icon="bi-lock-nav-menu" />

@if (message is not null)
{
    <div class="alert @(messageIsError ? "alert-danger" : "alert-success") alert-dismissible" role="alert">
        @message
        <button type="button" class="btn-close" aria-label="Fermer" @onclick="() => message = null"></button>
    </div>
}

@if (!loaded)
{
    <p class="text-muted">Chargement…</p>
}
else if (inviteCode is null)
{
    <p class="text-danger">@AdminService.NotAdminMessage</p>
}
else
{
    <ul class="nav nav-tabs mb-3" role="tablist">
        @foreach (var (key, label) in Tabs)
        {
            var k = key;
            <li class="nav-item" role="presentation">
                <button type="button" role="tab" class="nav-link @(tab == k ? "active" : "")" aria-selected="@(tab == k ? "true" : "false")"
                        @onclick="() => ShowTab(k)">@label</button>
            </li>
        }
    </ul>

    @if (tab == ChessTab)
    {
        <ChessBalanceTables UserId="@userId" WithDrafts="@withDrafts" WithDraftsChanged="SetWithDrafts" />
    }
    else if (tab == DraftsTab)
    {
        <ChessTeamDrafts UserId="@userId" />
    }
    else
    {
        <Block Title="Code d'invitation">
            <p class="small text-muted">À donner à qui tu veux voir s'inscrire. Majuscules, tirets et espaces ne comptent pas quand on le tape.</p>
            <div class="d-flex flex-wrap align-items-center gap-3 mb-2">
                <span class="font-monospace fw-bold fs-3">@inviteCode</span>
                <button class="btn btn-outline-primary" @onclick="() => confirmRegenerate = true" disabled="@busy">Régénérer</button>
            </div>
            @if (confirmRegenerate)
            {
                <div class="alert alert-warning small">
                    Un nouveau code est tiré au hasard ; l'ancien ne permettra plus de s'inscrire (les comptes déjà créés ne changent pas).
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <button class="btn btn-sm btn-warning" @onclick="Regenerate" disabled="@busy">Tirer un nouveau code</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => confirmRegenerate = false">Annuler</button>
                    </div>
                </div>
            }
        </Block>

        <Block Title="Mode debug">
            <p class="small text-muted">
                Pour tester le site avec ton compte : des boutons pour ajouter de l'argent (page « Banque d'objets ») et pour agrandir
                ou réduire ton parc gratuitement (page « Parc »). Il reste actif jusqu'à ta déconnexion ou au redémarrage du
                serveur, et ne change rien pour les autres comptes.
            </p>
            <div class="d-flex flex-wrap align-items-center gap-3">
                <span class="badge @(debugActive ? "text-bg-warning" : "text-bg-secondary")">@(debugActive ? "Activé" : "Désactivé")</span>
                <button class="btn btn-outline-primary" @onclick="ToggleDebug" disabled="@busy">@(debugActive ? "Désactiver" : "Activer")</button>
            </div>
        </Block>

        <Block Title="Comptes">
            <p class="small text-muted">
                Rôle Standard pour tous ; un administrateur a aussi accès à cette page. Un changement de rôle prend effet à la
                prochaine connexion du compte (il est déconnecté dans les 30 minutes). Tu ne peux pas te retirer le rôle
                toi-même, et il reste toujours au moins un administrateur.
            </p>
            <div class="list-group">
                @foreach (var account in accounts)
                {
                    var a = account;
                    <div class="list-group-item d-flex flex-wrap align-items-center gap-2">
                        <div>
                            @if (a.Pseudo is null)
                            {
                                <em class="text-muted">Pseudo pas encore choisi</em>
                            }
                            else
                            {
                                <strong>@a.Pseudo</strong>
                            }
                            @if (a.Id == userId)
                            {
                                <span class="small text-muted"> (toi)</span>
                            }
                        </div>
                        <span class="badge @(a.IsAdmin ? "text-bg-primary" : "text-bg-secondary")">@(a.IsAdmin ? SiteRoles.Admin : SiteRoles.Standard)</span>
                        @if (a.IsAdmin)
                        {
                            @if (a.Id != userId)
                            {
                                <button class="btn btn-sm btn-outline-danger ms-auto" @onclick="() => SetAdmin(a, false)" disabled="@busy">Retirer le rôle administrateur</button>
                            }
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-primary ms-auto" @onclick="() => SetAdmin(a, true)" disabled="@busy">Rendre administrateur</button>
                        }
                    </div>
                }
            </div>
        </Block>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    /// <summary>Onglet ouvert, gardé dans l'adresse (« echecs », « brouillons-echecs » ; rien : « Général »).</summary>
    [SupplyParameterFromQuery(Name = "onglet")] private string? TabFromQuery { get; set; }

    /// <summary>Case « Avec les brouillons » de l'onglet « Échecs » (« oui »), gardée dans l'adresse d'un onglet à l'autre.</summary>
    [SupplyParameterFromQuery(Name = "brouillons")] private string? DraftsFromQuery { get; set; }

    private const string ChessTab = "echecs";
    private const string DraftsTab = "brouillons-echecs";

    /// <summary>Les onglets : valeur dans l'adresse (vide : « Général ») et nom.</summary>
    private static readonly (string Key, string Label)[] Tabs = [("", "Général"), (ChessTab, "Échecs"), (DraftsTab, "Brouillons d'échecs")];

    private string userId = "";
    private bool loaded;
    private bool busy;
    private string? message;
    private bool messageIsError;
    private string? inviteCode; // null : pas (ou plus) administrateur
    private List<AdminAccount> accounts = [];
    private bool confirmRegenerate;
    private bool debugActive; // mode debug de ce compte (DebugService)
    private string tab = ""; // onglet ouvert (Tabs)
    private bool withDrafts; // case « Avec les brouillons » de l'onglet « Échecs »

    protected override async Task OnInitializedAsync()
    {
        userId = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
        await Reload();
        loaded = true;
    }

    protected override void OnParametersSet()
    {
        tab = Tabs.Any(t => t.Key == TabFromQuery) ? TabFromQuery! : "";
        withDrafts = DraftsFromQuery == "oui";
    }

    private void ShowTab(string key)
    {
        tab = key;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("onglet", key.Length == 0 ? null : key), replace: true);
    }

    private void SetWithDrafts(bool on)
    {
        withDrafts = on;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("brouillons", on ? "oui" : null), replace: true);
    }

    private async Task Reload()
    {
        inviteCode = await Administration.InviteCodeAsync(userId);
        accounts = await Administration.ListAccountsAsync(userId);
        debugActive = await Debug.IsActiveAsync(userId);
    }

    private Task ToggleDebug() =>
        RunBusy(async () =>
        {
            var result = await Debug.SetActiveAsync(userId, !debugActive);
            Show(result.Message, !result.Ok);
        });

    private Task Regenerate() =>
        RunBusy(async () =>
        {
            confirmRegenerate = false;
            var result = await Administration.RegenerateInviteCodeAsync(userId);
            Show(result.Message, !result.Ok);
        });

    private Task SetAdmin(AdminAccount account, bool admin) =>
        RunBusy(async () =>
        {
            var result = await Administration.SetAdminAsync(userId, account.Id, admin);
            Show(result.Message, !result.Ok);
        });

    private async Task RunBusy(Func<Task> action)
    {
        busy = true;
        try
        {
            await action();
            await Reload();
        }
        finally
        {
            busy = false;
        }
    }

    private void Show(string text, bool isError = false)
    {
        message = text;
        messageIsError = isError;
    }
}
