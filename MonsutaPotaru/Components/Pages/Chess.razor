    // ---------- Pendant la partie ----------

    /// <summary>Clic sur une case du plateau (numéro venu du navigateur : tout est revérifié par ChessHub).</summary>
    [JSInvokable]
    public async Task OnSquareClicked(int square)
    {
        if (session is null || square is < 0 or > 63)
            return;
        var unit = session.At(square);
        if (!CanAct)
        {
            await OnSquareWhileWaiting(square, unit);
            return;
        }
        if (snapshot?.BonusSquare is { } bonus && selected != bonus)
        {
            // Tour bonus : la pièce qui rejoue est choisie, même si le clic arrive avant que la page l'ait fait
            selected = bonus;
            options = session.Options(userId, bonus);
        }
        if (selected is { } from && from != square && await TryTarget(from, square))
            return;
        await OnPieceOrEmptySquare(square, unit);
        StateHasChanged();
    }

    /// <summary>Clic quand ce n'est pas à moi de jouer : l'aperçu des coups de l'autre, ou la fiche de la pièce.</summary>
    private async Task OnSquareWhileWaiting(int square, ChessUnit? unit)
    {
        if (CanPreview)
        {
            await Preview(square, unit);
            return;
        }
        info = unit is null ? null : Describe(unit);
        StateHasChanged();
    }

    /// <summary>
    /// Clic sur une case où la pièce choisie peut aller (le coup se joue, ou le choix du K.O. qui revient s'ouvre) ou sur
    /// une pièce qu'elle ne peut pas manger (pourquoi). Faux : rien de cela, le clic est traité comme un autre.
    /// </summary>
    private async Task<bool> TryTarget(int from, int square)
    {
        if (options.Targets.FirstOrDefault(t => t.To == square) is { } target)
        {
            if (target.Revives.Count > 0)
            {
                pendingTo = square;
                swapChoices = target.Revives;
                info = null;
                StateHasChanged();
                return true;
            }
            await PlayMove(new ChessMove(from, square));
            return true;
        }
        if (options.Blocked.FirstOrDefault(b => b.Square == square) is not { } blocked)
            return false;
        info = Refusal(session!.At(from)!, UnitOf(blocked.VictimId)!, blocked.Effect);
        StateHasChanged();
        return true;
    }

    /// <summary>Clic sur une de mes pièces (choisie), une pièce de l'autre (sa fiche) ou une case vide (plus de sélection).</summary>
    private async Task OnPieceOrEmptySquare(int square, ChessUnit? unit)
    {
        var bonusTurn = snapshot?.BonusSquare is not null;
        var mine = session!.ColorOf(userId);
        if (unit is not null && unit.Color == mine && !bonusTurn)
        {
            await Select(square);
        }
        else if (unit is not null && unit.Color != mine)
        {
            info = Describe(unit);
            if (!bonusTurn)
                ClearSelection(keepInfo: true);
            await Highlight();
        }
        else if (!bonusTurn)
        {
            ClearSelection();
            await Highlight();
        }
    }

    /// <summary>
    /// Tour de l'autre : clic sur une de ses pièces (aperçu : ses cases, ses cadres), sur une pièce qu'elle ne peut pas
    /// manger (pourquoi), ou ailleurs (la sélection s'efface). Rien ne se joue.
    /// </summary>
    private async Task Preview(int square, ChessUnit? unit)
    {
        if (session is null)
            return;
        if (selected is { } from && from != square && options.Blocked.FirstOrDefault(b => b.Square == square) is { } blocked)
            info = Refusal(session.At(from)!, UnitOf(blocked.VictimId)!, blocked.Effect);
        else if (unit is not null && unit.Color == session.ColorOf(userId))
            await Select(square);
        else
        {
            ClearSelection();
            info = unit is null ? null : Describe(unit);
        }
        await Highlight();
        StateHasChanged();
    }

    private async Task Select(int square)
    {
        if (session is null)
            return;
        selected = square;
        pendingTo = null;
        options = session.Options(userId, square);
        swapChoices = options.Swaps.Count > 0 ? options.Swaps : null;
        var unit = session.At(square);
        var legend = MatchupLegend();
        if (unit is null)
            info = null;
        else if (options.Any || !CanAct)
            info = $"{Describe(unit)}{legend}"; // aperçu : pas de cases, il ne bouge pas encore
        else if (unit.Piece == ChessPiece.Pawn && ChessGame.RankOf(square) is 0 or 7)
            info = $"{unit.Mon.Name} attend au bout du plateau qu'un Pokémon de ton équipe soit K.O. pour lui laisser sa place.{legend}";
        else
            info = $"{unit.Mon.Name} ne peut pas bouger.{legend}";
        if (info is not null && !CanAct)
            info = $"Aperçu (au tour de {session.Other(userId).Pseudo}) : {info}";
        await Highlight();
    }

    /// <summary>
    /// Ce que disent les marques de la pièce choisie, seulement celles qui sont là : cadres vert et rouge en contraste élevé,
    /// sinon Pokémon teintés en rouge (bouclier cassé) ou en bleu (bouclier) ; croix, en contraste élevé seulement.
    /// </summary>
    private string MatchupLegend()
    {
        var parts = new List<string>();
        if (options.Matchups.Any(m => m.Effect > 1))
            parts.Add(contrast ? "cadre vert : il leur est super efficace" : "en rouge, bouclier cassé : il leur est super efficace");
        if (options.Matchups.Any(m => m.Effect < 1))
            parts.Add(contrast ? "cadre rouge : il ne peut pas les manger" : "en bleu, bouclier : il ne peut pas les manger");
        if (contrast && options.Blocked.Count > 0)
            parts.Add("croix rouge : à sa portée, mais son type l'empêche de les manger");
        return parts.Count == 0 ? "" : $" Sur le plateau, {string.Join(" ; ", parts)}.";
    }

    private void ClearSelection() => ClearSelection(false);

    private void ClearSelection(bool keepInfo)
    {
        selected = null;
        pendingTo = null;
        options = ChessOptions.None;
        swapChoices = null;
        if (!keepInfo)
            info = null;
    }

    private async Task Swap(int from, int revive) => await PlayMove(new ChessMove(from, pendingTo ?? from, revive));

    private async Task Pass() => await PlayMove(ChessMove.Pass);

    private async Task PlayMove(ChessMove move)
    {
        if (session is null)
            return;
        if (Hub.Play(session, userId, move) is { } error)
        {
            info = error;
            ClearSelection(keepInfo: true);
            await Highlight();
            return;
        }
        ClearSelection();
        // la session prévient les deux pages (OnSessionChanged) : le coup s'anime
    }

    /// <summary>
    /// Case « Désactiver les animations » (cochée : Pokémon figés au repos) : le plateau suit tout de suite ; enregistrée
    /// dans le compte (sans compte : gardée pour la page seulement).
    /// </summary>
    private async Task IdleChanged(ChangeEventArgs e)
    {
        idleAnimated = !(e.Value is true || (e.Value is string text && bool.TryParse(text, out var on) && on));
        if (board is not null)
        {
            try
            {
                await board.InvokeVoidAsync("setIdle", idleAnimated);
            }
            catch (JSDisconnectedException)
            {
                return; // onglet fermé
            }
        }
        if (signedIn && !(await PreferenceStore.SetChessIdleAsync(userId, idleAnimated)).Ok)
            info = "Ton choix vaut pour cette partie, mais il n'a pas pu être gardé dans ton compte.";
    }

    /// <summary>
    /// Case « Contraste élevé » (cochée : cadres vert et rouge ; décochée : filtres, boucliers et animations) : le plateau et
    /// la légende suivent tout de suite ; enregistrée dans le compte (sans compte : gardée pour la page seulement).
    /// </summary>
    private async Task ContrastChanged(ChangeEventArgs e)
    {
        var before = MatchupLegend();
        contrast = e.Value is true || (e.Value is string text && bool.TryParse(text, out var on) && on);
        if (before.Length > 0 && info is not null)
            info = info.Replace(before, MatchupLegend()); // légende de la pièce choisie dans le nouveau mode, le reste ne bouge pas
        if (board is not null)
        {
            try
            {
                await board.InvokeVoidAsync("setContrast", contrast);
            }
            catch (JSDisconnectedException)
            {
                return; // onglet fermé
            }
        }
        if (signedIn && !(await PreferenceStore.SetChessContrastAsync(userId, contrast)).Ok)
            info = "Ton choix vaut pour cette partie, mais il n'a pas pu être gardé dans ton compte.";
    }

    private async Task Forfeit()
    {
        if (session is null || !await JS.InvokeAsync<bool>("confirm", "Abandonner la partie ? Tu perdras."))
            return;
        Hub.Forfeit(session, userId);
    }

    /// <summary>
    /// Marques du plateau : pièce choisie, cases permises (super efficace à part), pièces adverses faibles (cadre vert, ou
    /// rouge et bouclier cassé) ou qui résistent (cadre rouge, ou bleu et bouclier), pièces atteintes que son type ne peut
    /// pas manger (croix rouge, en contraste élevé), dernier coup, roi en échec.
    /// </summary>
    private async Task Highlight()
    {
        if (board is null || session is null)
            return;
        int? check = null;
        var bonusTurn = snapshot?.BonusSquare is not null;
        if (lastStep is { Check: true, End: ChessEnd.None or ChessEnd.Checkmate } step)
        {
            var enemy = step.Color == ChessColor.White ? ChessColor.Black : ChessColor.White;
            check = step.After.Board.FirstOrDefault(p => UnitOf(p.Id) is { Piece: ChessPiece.King } k && k.Color == enemy)?.Square;
        }
        try
        {
            await board.InvokeVoidAsync("highlight", new
            {
                selected,
                // Coins dorés : la pièce rejouera ; pas pendant son tour bonus (un seul)
                moves = options.Targets.Select(t => new { to = t.To, capture = t.VictimId is not null, super = t.Effect > 1 && !bonusTurn }).ToArray(),
                blocked = options.Blocked.Select(b => b.Square),
                weak = options.Matchups.Where(m => m.Effect > 1).Select(m => m.Square),
                resist = options.Matchups.Where(m => m.Effect < 1).Select(m => m.Square),
                last = lastStep is { Move.IsPass: false } l ? new[] { l.Move.From, l.Move.To } : [],
                check,
            });
        }
        catch (JSDisconnectedException)
        {
            // onglet fermé
        }
    }

    // ---------- Fin ----------

    private void CancelGame()
    {
        if (session is not null)
            Hub.Leave(session, userId);
        Navigation.NavigateTo("");
    }

    private async Task BeforeLeaving(LocationChangingContext context)
    {
        if (!InGame)
            return;
        var question = session!.Stage == ChessStage.Playing
            ? "Quitter cette page abandonne la partie : tu perdras. Continuer ?"
            : "Quitter cette page annule la partie, pour toi et pour ton adversaire. Continuer ?";
        if (!await JS.InvokeAsync<bool>("confirm", question))
        {
            context.PreventNavigation();
            return;
        }
        Hub.Leave(session, userId, $"{pseudo} a quitté la partie.");
    }

    private async Task NewGame()
    {
        DeclineGuestOffers();
        if (session is not null)
            session.Changed -= OnSessionChanged;
        session = null;
        snapshot = null;
        units = [];
        played = 0;
        lastText = null;
        lastStep = null;
        message = null;
        showPieces = false;
        showHelp = false;
        ClearSelection();
        await DisposeBoard();
    }

    /// <summary>
    /// Sans compte, une proposition de recommencer ne se voit que sur l'écran de fin (pas de liste d'invitations) : quand il
    /// le quitte, elle est refusée plutôt que d'attendre son expiration.
    /// </summary>
    private void DeclineGuestOffers()
    {
        if (signedIn)
            return;
        foreach (var offer in Hub.Incoming(userId))
            Hub.Leave(offer, userId, $"{pseudo} a quitté la page.");
    }

    private async Task DisposeBoard()
    {
        if (board is null)
            return;
        try
        {
            await board.InvokeVoidAsync("dispose");
            await board.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // onglet fermé
        }
        board = null;
    }

    // ---------- Affichage ----------

    private ChessUnit? UnitOf(int id) => units.FirstOrDefault(u => u.Id == id);

    private static string TypeName(ChessUnit unit) => PokeTypes.Name(unit.Type);

    /// <summary>« Gardevoir (Fée) · Reine adverse ».</summary>
    private string Describe(ChessUnit unit) =>
        $"{unit.Mon.Name} ({TypeName(unit)}) · {ChessTeams.PieceName(unit.Piece)}{(session?.ColorOf(userId) == unit.Color ? "" : " adverse")}.";

    /// <summary>Pourquoi la prise est impossible (« Pas très efficace : Salamèche (Feu) ne peut pas manger Roigada (Eau). »).</summary>
    private static string Refusal(ChessUnit attacker, ChessUnit victim, double effect) =>
        $"{(effect == 0 ? "Aucun effet" : "Pas très efficace")} : {attacker.Mon.Name} ({TypeName(attacker)}) ne peut pas manger {victim.Mon.Name} ({TypeName(victim)}).";

    private string StatusText()
    {
        if (session is null || snapshot is null)
            return "";
        if (snapshot.Stage == ChessStage.Cancelled)
            return "Partie annulée.";
        if (snapshot.Stage == ChessStage.Done && !animating && played >= snapshot.StepCount)
            return ResultText(session, snapshot);
        if (animating || played < snapshot.StepCount)
            return "…";
        return snapshot.MyTurn ? MyTurnText(session, snapshot) : $"Au tour de {session.Other(userId).Pseudo}…";
    }

    /// <summary>Fin de la partie : « Victoire ! (échec et mat) », « Match nul (pat) »…</summary>
    private string ResultText(ChessSession current, ChessSnapshot shown)
    {
        var mine = current.ColorOf(userId);
        var result = shown.Winner switch
        {
            null => "Match nul",
            var winner when winner == mine => "Victoire !",
            _ => "Défaite…",
        };
        var why = shown.End switch
        {
            ChessEnd.Checkmate => "échec et mat",
            ChessEnd.KingEaten => "roi mangé",
            ChessEnd.Stalemate => "pat",
            ChessEnd.OnlyKings => "il ne reste que les rois",
            ChessEnd.Forfeit => "abandon",
            ChessEnd.Timeout => "temps écoulé",
            ChessEnd.Left => "partie quittée",
            _ => "",
        };
        return why.Length > 0 ? $"{result} ({why})" : result;
    }

    /// <summary>À moi de jouer : le tour bonus (rejouer ou passer), ou un coup normal (roi en échec ou non).</summary>
    private string MyTurnText(ChessSession current, ChessSnapshot shown)
    {
        if (shown.BonusSquare is { } bonus && current.At(bonus) is { } unit)
            return shown.CanPass
                ? $"Super efficace ! {unit.Mon.Name} rejoue : choisis sa case, ou passe."
                : $"Super efficace ! {unit.Mon.Name} rejoue : ton roi est en échec, choisis une case qui le met à l'abri.";
        return lastStep is { Check: true } && lastStep.Color != current.ColorOf(userId) ? "À toi de jouer : ton roi est en échec !" : "À toi de jouer.";
    }

    private string StatusClass() => snapshot switch
    {
        { Stage: ChessStage.Done, Winner: null } => "draw",
        { Stage: ChessStage.Done } when session is not null && snapshot.Winner == session.ColorOf(userId) => "won",
        { Stage: ChessStage.Done } => "lost",
        { MyTurn: true } => "my-turn",
        _ => "",
    };

    private static string Clock(int seconds) => $"{seconds / 60}:{seconds % 60:00}";

    /// <summary>
    /// Les Pokémon d'une équipe, une ligne par pièce (sprite, symbole et nom de la pièce, Pokémon, type) ; pendant la partie
    /// (<paramref name="color"/>), combien sont sur le plateau et combien sont K.O.
    /// </summary>
    private RenderFragment TeamList(ChessTeam team, ChessColor? color, bool shiny = false) => __builder =>
    {
        <ChessTeamList Team="team" Shiny="shiny" Extra="@(color is { } c ? piece => PieceCount(c, piece) : null)" />
    };

    /// <summary>Pendant la partie : combien de pièces de ce camp sont sur le plateau, et combien sont K.O.</summary>
    private RenderFragment PieceCount(ChessColor color, ChessPiece piece) => __builder =>
    {
        @if (snapshot?.Position is { } position)
        {
            var ids = units.Where(u => u.Color == color && u.Piece == piece).Select(u => u.Id).ToHashSet();
            var onBoard = position.Board.Count(p => ids.Contains(p.Id));
            var ko = (color == ChessColor.White ? position.WhiteKo : position.BlackKo).Count(ids.Contains);
            <span class="chess-piece-count small text-muted">· @onBoard sur le plateau@(ko > 0 ? $" · {ko} K.O." : "")</span>
        }
    };

    /// <summary>Les règles, dans l'aide des blocs « Nouvelle partie » et « Rejoindre une partie ».</summary>
    private static RenderFragment Rules => __builder =>
    {
        <p>Des échecs où chaque pièce est un Pokémon avec un seul type :</p>
        <ul>
            <li>Une pièce ne mange une autre que si son type est au moins neutre contre elle (pas très efficace ou sans effet : impossible).</li>
            <li>Super efficace : le Pokémon qui a mangé rejoue aussitôt (il peut passer), une fois seulement : une prise super efficace pendant ce tour bonus ne le fait pas rejouer encore. S'il mange le roi, la partie est gagnée.</li>
            <li>Sinon, échec et mat comme aux échecs : un roi n'est en échec que si une pièce adverse peut vraiment le manger.</li>
            <li>Un pion au bout du plateau prend la place d'un Pokémon K.O. de son équipe (pas d'un pion). Sans K.O., il attend.</li>
            <li>Celui qui invite (ou qui crée la partie publique) joue les blancs. Passé le temps par coup, ou en quittant la page, on perd.</li>
            <li>À la fin, « Recommencer » propose une autre partie au même adversaire, au même temps par coup : les couleurs s'inversent.</li>
        </ul>
    };

    /// <summary>
    /// « Rejoindre une partie » : le code d'une partie publique et, sans compte, un prénom. Bouton et non formulaire : un
    /// formulaire envoyé avant que la page soit interactive partirait au serveur sans être attendu.
    /// </summary>
    private RenderFragment JoinBlock => __builder =>
    {
        <Block Title="Rejoindre une partie">
            <Help>@Rules</Help>
            <ChildContent>
                <p class="small text-muted mb-2">
                    Quelqu'un a créé une partie publique ? Saisis le code qu'il t'a donné@(signedIn ? "" : ", et ton prénom").
                </p>
                <div class="chess-join">
                    <input type="text" class="form-control chess-code-input" aria-label="Code de la partie" placeholder="Code (8 caractères)"
                           maxlength="16" autocomplete="off" spellcheck="false" @bind="joinCode" />
                    @if (!signedIn)
                    {
                        <input type="text" class="form-control chess-guest-name" aria-label="Ton prénom" placeholder="Ton prénom"
                               maxlength="@ChessHub.GuestNameMax" autocomplete="given-name" @bind="guestName" />
                    }
                    <button type="button" class="btn btn-primary chess-join-button" @onclick="JoinWithCode">Rejoindre</button>
                </div>
                @if (joinError is not null)
                {
                    <p class="chess-join-error text-danger small mt-2 mb-0" role="alert">@joinError</p>
                }
                @if (!signedIn)
                {
                    <p class="small text-muted mt-2 mb-0">
                        Tu as un compte ? <a href="@LoginLink">Connecte-toi</a> pour jouer sous ton pseudo.
                    </p>
                }
            </ChildContent>
        </Block>
    };

    /// <summary>Connexion, puis retour ici (avec le code du lien, s'il y en a un).</summary>
    private string LoginLink => "Account/Login?ReturnUrl=" + Uri.EscapeDataString(
        "/mini-jeux/echecs" + (CodeFromLink is null ? "" : "?code=" + Uri.EscapeDataString(ChessHub.NormalizeCode(CodeFromLink))));

    /// <summary>Ordre des pièces dans les tableaux de l'aide : celui des listes d'équipes.</summary>
    private static readonly ChessPiece[] PieceOrder = ChessTeamList.Order;

    /// <summary>
    /// Fenêtre « Aide » : un tableau croisé, les Pokémon de <paramref name="attackers"/> en lignes, ceux de
    /// <paramref name="victims"/> en colonnes ; chaque case dit si la pièce de la ligne mange celle de la colonne. Une
    /// ligne (ou colonne) par pièce : les huit pions n'en ont qu'une, même à deux espèces (Nidoran♂ et Nidoran♀, deux
    /// images).
    /// </summary>
    private static RenderFragment HelpTable(string title, (ChessTeam Team, bool Shiny) attacking, (ChessTeam Team, bool Shiny) eaten) => __builder =>
    {
        var (attackers, victims) = (attacking.Team, eaten.Team);
        <div class="chess-help-scroll">
            <table class="chess-help-table">
                <caption>@title</caption>
                <thead>
                    <tr>
                        <th scope="col" class="chess-help-corner small text-muted">mange&nbsp;→</th>
                        @foreach (var piece in PieceOrder)
                        {
                            <th scope="col" class="chess-help-col">
                                @HelpImages(victims, piece, eaten.Shiny)
                                @HelpLabel(victims, piece)
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var piece in PieceOrder)
                    {
                        <tr>
                            <th scope="row" class="chess-help-row">
                                <div class="chess-help-row-content">
                                    @HelpImages(attackers, piece, attacking.Shiny)
                                    <div>@HelpLabel(attackers, piece)</div>
                                </div>
                            </th>
                            @foreach (var column in PieceOrder)
                            {
                                @ChessMarkCell.Cell(ChessBalance.Mark(attackers, piece, victims, column))
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    };

    /// <summary>
    /// Nom, type et pièce d'un Pokémon, dans les en-têtes des tableaux de l'aide : le nom au-dessus du type dans les
    /// colonnes (étroites), sur la même ligne dans les lignes (le tableau tient ainsi en hauteur).
    /// </summary>
    private static RenderFragment HelpLabel(ChessTeam team, ChessPiece piece) => __builder =>
    {
        var mon = team.Of(piece);
        <span class="chess-help-title">
            <span class="chess-mon-name">@team.NamesOf(piece)</span>
            <span class="chess-type type-@PokeTypes.Key(mon.Type)">@PokeTypes.Name(mon.Type)</span>
        </span>
        <span class="chess-help-piece d-block">
            <span class="chess-piece-symbol" aria-hidden="true">@ChessTeams.Symbol(mon.Piece)</span>
            <span class="chess-piece-name">@ChessTeams.PieceName(mon.Piece)</span>
        </span>
    };

    /// <summary>Images des Pokémon d'une pièce dans les en-têtes de la table de type (deux pour les pions Nidoran).</summary>
    private static RenderFragment HelpImages(ChessTeam team, ChessPiece piece, bool shiny) => __builder =>
    {
        <div class="chess-mon-images">
            @foreach (var mon in team.MembersOf(piece))
            {
                <img src="@mon.SpriteUrlOf(shiny)" alt="" data-remplacement="images/pokemon/inconnu.png" />
            }
        </div>
    };

    public async ValueTask DisposeAsync()
    {
        if (clock is not null)
            await clock.DisposeAsync();
        Hub.RequestsChanged -= OnRequestsChanged;
        DeclineGuestOffers();
        if (session is not null)
        {
            session.Changed -= OnSessionChanged;
            Hub.Leave(session, userId, $"{pseudo} a quitté la partie."); // onglet fermé, connexion perdue : sans effet si finie
        }
        await DisposeBoard();
        try
        {
            if (module is not null)
                await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // onglet fermé
        }
        selfRef?.Dispose();
    }
}
