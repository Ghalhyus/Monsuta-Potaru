@page "/collection"
@page "/joueurs/{Pseudo}/collection"
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using MonsutaPotaru.Components.Shared
@using MonsutaPotaru.Data
@using MonsutaPotaru.Services
@inject BankService BankStore
@inject StoredSaveService Saves
@inject PokemonInfo Info
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject PlayerService Players
@inject PreferencesService Preferences

<PageTitle>@PageName</PageTitle>

@* Tous les Pokémon de l'utilisateur sur une seule page, sans boîtes : ceux du stockage interne et ceux des sauvegardes
   stockées (lecture seule, gérées dans « Mes sauvegardes »). Seules les lignes visibles à l'écran (plus une petite marge) sont rendues et lues
   en base : les autres arrivent au fil du défilement. *@

@* Collection d'un autre joueur (Multijoueurs, /joueurs/{pseudo}/collection) : lecture seule, sans jauge ni achat,
   sans noms de fichiers, ID de dresseur ni téléchargement. *@
@if (Visitor && player is null)
{
    @if (playerChecked)
    {
        <PlayerHidden />
    }
}
else
{
@if (player is not null)
{
    <PlayerHeader Player="player" Current="PublicPages.Collection" />
}
<PageHeader Title="@(Visitor ? "Collection" : "Ma collection")" Count="@total.ToString()" Small="Visitor" Icon="@(Visitor ? null : "bi-grid-nav-menu")" />

@if (message is not null)
{
    <div class="alert @(messageIsError ? "alert-danger" : "alert-success") alert-dismissible" role="alert">
        @message
        <button type="button" class="btn-close" aria-label="Fermer" @onclick="() => message = null"></button>
    </div>
}

@* ---------- Taille de la collection (stockage interne + sauvegardes stockées) ---------- *@
@if (!Visitor)
{
    <CollectionGauge Usage="usage" OnPurchase="OnPurchase" />
}

<div class="collection-toolbar">
    <input class="form-control form-control-sm" placeholder="Rechercher (espèce ou surnom)…"
           @bind="search" @bind:event="oninput" @bind:after="Reload" />
    <select class="form-select form-select-sm collection-filter" aria-label="Origine des Pokémon"
            @bind="source" @bind:after="SourceChanged">
        <option value="">Tout</option>
        <option value="@BankSource">Stockage interne</option>
        @foreach (var s in saves)
        {
            <option value="@s.Id">💾 @(Visitor ? s.Label : s.LabelAndFile)</option>
        }
    </select>
    @* Tri : critère, puis sens (les œufs restent à la fin) ; sans tri dans l'adresse, celui du compte (« Mon compte » → « Préférences »). *@
    <div class="collection-sort">
        <select class="form-select form-select-sm" aria-label="Trier par" value="@SortChoices.First(c => c.By == sort.By).Slug" @onchange="SortChanged">
            @foreach (var choice in SortChoices)
            {
                <option value="@choice.Slug">Tri : @choice.Label</option>
            }
        </select>
        <button type="button" class="btn btn-sm btn-outline-secondary text-nowrap" title="Inverser l'ordre" @onclick="ReverseSort">@OrderLabel</button>
    </div>
    @* Mode compact : un dossier par espèce, gardé dans l'adresse (?compact=1). *@
    <div class="form-check form-switch small collection-compact" title="Regroupe les Pokémon d'une même espèce dans un dossier">
        <input class="form-check-input" type="checkbox" role="switch" id="collection-compact" checked="@compact" @onchange="CompactChanged" />
        <label class="form-check-label" for="collection-compact">Mode compact</label>
    </div>
    @if (!Visitor)
    {
        <a class="small" href="sauvegardes">Gérer mes sauvegardes</a>
    }
    <label class="collection-columns small">
        Colonnes
        <input type="range" class="form-range" min="@GridColumns.Min" max="@GridColumns.Max"
               @bind="columns" @bind:event="oninput" @bind:after="ColumnsChanged" @onchange="RememberColumns" />
        <span class="fw-semibold">@columns</span>
    </label>
    @* Filtres en pastilles (type, sexe, nature, talent, IV, forme, Méga, chromatique, œuf), gardés dans l'adresse. *@
    <CollectionFilterChips Value="criteria" ValueChanged="CriteriaChanged" Abilities="abilities" />
</div>

@if (total == 0)
{
    <p class="text-muted">
        @(string.IsNullOrWhiteSpace(search) && source == "" && criteria.IsEmpty ? "Ta collection est vide pour l'instant. Dépose des Pokémon depuis « Dépôt / Retrait » ou ajoute une sauvegarde dans « Mes sauvegardes »." : "Aucun Pokémon ne correspond.")
    </p>
}
else
{
    <div class="collection" style="--columns: @columns">
        @* Changer de recherche, d'origine ou de nombre de colonnes recrée la liste (et remonte en haut). *@
        <Virtualize @key="listVersion" @ref="list" TItem="CollectionCell[]" ItemsProvider="LoadRows" Context="row" ItemSize="60" OverscanCount="4">
            <ItemContent>
                <div class="collection-row">
                    @foreach (var cell in row)
                    {
                        if (cell.Folder is { } folder)
                        {
                            @* Dossier du mode compact : un clic l'ouvre (ses Pokémon prennent les cases suivantes) ou le referme. *@
                            var open = layout.IsOpen(folder);
                            <PokemonSlot Sprite="@folder.SpriteUrl"
                                         Title="@FolderTitle(folder, open)"
                                         Count="folder.Count"
                                         Expanded="open"
                                         Class="@(open ? "folder open" : "folder")"
                                         OnClick="() => ToggleFolder(folder.Key)" />
                        }
                        else if (cell.Item is { } item)
                        {
                            var stored = item.StoredSaveId is { } sid ? saves.FirstOrDefault(x => x.Id == sid) : null;
                            <PokemonSlot Sprite="@item.SpriteUrl"
                                         Title="@SlotTitle(item, stored)"
                                         Level="item.Level"
                                         Shiny="item.IsShiny"
                                         Marker="@(item.StoredSaveId is null ? null : "💾")"
                                         Selected="@(selected?.Id == item.Id)"
                                         Class="@(cell.InFolder ? "in-folder" : null)"
                                         OnClick="() => Open(item)" />
                        }
                        else
                        {
                            <div class="slot empty"></div>
                        }
                    }
                </div>
            </ItemContent>
            <Placeholder>
                <div class="collection-row">
                    @for (int i = 0; i < columns; i++)
                    {
                        <div class="slot empty"></div>
                    }
                </div>
            </Placeholder>
        </Virtualize>
    </div>
}

@* ---------- Fiche du Pokémon cliqué ---------- *@
@if (selected is not null && selectedView is not null)
{
    <div class="collection-backdrop" @onclick="Close"></div>
    <div class="collection-dialog" role="dialog" aria-modal="true" aria-label="@selectedView.Nickname">
        <PokemonCard Pokemon="@selectedView" HideTrainerId="Visitor">
            <div class="d-flex flex-wrap align-items-center gap-2">
                @if (selected.StoredSaveId is { } sid)
                {
                    @* Sauvegarde stockée : lecture seule, pas de fichier .pkX à télécharger. *@
                    var save = saves.FirstOrDefault(s => s.Id == sid);
                    <small class="text-muted">
                        💾 @(save?.Label ?? "Sauvegarde stockée") · @selected.Location
                        @if (save is not null && !Visitor)
                        {
                            <span class="d-block">@save.FileName</span>
                        }
                    </small>
                }
                else
                {
                    <small class="text-muted">Déposé le @selected.DepositedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                    @if (!Visitor)
                    {
                        <button class="btn btn-outline-secondary btn-sm ms-auto" @onclick="DownloadPkm">Télécharger le fichier .@selected.Extension</button>
                    }
                }
                <button class="btn btn-secondary btn-sm @(selected.StoredSaveId is null && !Visitor ? "" : "ms-auto")" @onclick="Close">Fermer</button>
            </div>
        </PokemonCard>
    </div>
}
}

@code {
    /// <summary>Titre de l'onglet : la page du compte, ou celle d'un autre joueur.</summary>
    private string PageName
    {
        get
        {
            if (!Visitor)
                return "Ma collection";
            return player is null ? "Joueur introuvable" : $"Collection de {player.Pseudo}";
        }
    }

    private const string BankSource = "banque";

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    /// <summary>Pseudo d'un autre joueur (adresse /joueurs/{pseudo}/collection) : sa collection, en lecture seule.</summary>
    [Parameter] public string? Pseudo { get; set; }

    private bool Visitor => Pseudo is not null;
    private PlayerProfile? player; // joueur consulté, si sa collection est publique
    private bool playerChecked;

    /// <summary>
    /// Nombre de colonnes choisi au curseur, gardé dans l'adresse (?colonnes=12) pour survivre à un rechargement.
    /// Absent : il suit la largeur de la fenêtre (<see cref="screenColumns"/>, réglages dans <see cref="GridColumns"/>).
    /// </summary>
    [SupplyParameterFromQuery(Name = GridColumns.QueryName)] private int? ColumnsFromQuery { get; set; }
    /// <summary>Origine affichée, gardée dans l'adresse : vide (tout), « banque » ou l'identifiant d'une sauvegarde stockée.</summary>
    [SupplyParameterFromQuery(Name = "source")] private string? SourceFromQuery { get; set; }
    /// <summary>Tri gardé dans l'adresse : « arrivee » (absent), « nom » ou « pokedex ».</summary>
    [SupplyParameterFromQuery(Name = "tri")] private string? SortFromQuery { get; set; }
    /// <summary>Sens gardé dans l'adresse (« asc », « desc ») quand il n'est pas celui du critère (récents d'abord, ou croissant).</summary>
    [SupplyParameterFromQuery(Name = "ordre")] private string? OrderFromQuery { get; set; }
    /// <summary>Mode compact gardé dans l'adresse (« ?compact=1 ») : un dossier par espèce.</summary>
    [SupplyParameterFromQuery(Name = CompactQueryName)] private string? CompactFromQuery { get; set; }

    private const string CompactQueryName = "compact";

    /// <summary>Nom de chaque critère dans l'adresse et dans la liste.</summary>
    private static IReadOnlyList<(CollectionSortBy By, string Slug, string Label)> SortChoices => SiteSorts.CollectionChoices;

    private CollectionSort sort;
    private CollectionSort defaultSort; // tri par défaut du compte qui regarde (visiteur compris)

    private string userId = "";
    private string search = "";
    private string source = "";
    private bool sourceInitialized;
    private int columns = GridColumns.Default;
    private int screenColumns = GridColumns.Default; // largeur de fenêtre inconnue tant que la page n'est pas interactive
    private DotNetObjectReference<Collection>? selfRef;
    private IJSObjectReference? screenWatcher;
    private int total;
    private int listVersion;   // clé de Virtualize : l'incrémenter recrée la liste
    private int reloadRequest;
    private Virtualize<CollectionCell[]>? list;

    // ---------- Mode compact ----------
    private bool compact;
    private readonly HashSet<CollectionGroupKey> openFolders = []; // dossiers ouverts (non gardés dans l'adresse)
    private List<CollectionGroup> groups = [];
    private CollectionFolderLayout layout = CollectionFolderLayout.Empty;

    /// <summary>
    /// Case de la grille : un Pokémon (<paramref name="InFolder"/> s'il est le contenu d'un dossier ouvert), un dossier du
    /// mode compact, ou une case vide (Pokémon disparu entre-temps).
    /// </summary>
    private sealed record CollectionCell(BankListItem? Item, CollectionGroup? Folder = null, bool InFolder = false);

    private static readonly CollectionCell Gone = new(null);

    private List<StoredSaveInfo> saves = []; // pour le filtre et l'origine affichée des Pokémon stockés
    private PokemonCriteria criteria = PokemonCriteria.None; // filtres des pastilles, gardés dans l'adresse
    private List<int> abilities = []; // talents de la collection, proposés par le filtre « Talent »

    private CollectionUsage usage = new(0, CollectionCapacity.DefaultLimit);

    private string? message;
    private bool messageIsError;

    private BankPokemon? selected;
    private PokemonView? selectedView;

    private CollectionFilter Filter => SourceFilter with { Criteria = criteria };

    /// <summary>Origine choisie : le stockage interne, une sauvegarde, ou tout.</summary>
    private CollectionFilter SourceFilter
    {
        get
        {
            if (source == BankSource)
                return CollectionFilter.Bank;
            return int.TryParse(source, out var id) ? CollectionFilter.Save(id) : CollectionFilter.All;
        }
    }

    /// <summary>Bulle d'un Pokémon : surnom, espèce, niveau, et sa sauvegarde s'il y est.</summary>
    private string SlotTitle(BankListItem item, StoredSaveInfo? stored)
    {
        var title = $"{item.Nickname} ({item.SpeciesName}) N.{item.Level}";
        if (stored is null)
            return title;
        return $"{title} — sauvegarde {(Visitor ? stored.Label : stored.LabelAndFile)}";
    }

    /// <summary>Bulle d'un dossier : son espèce, son nombre de Pokémon et ce que fait un clic.</summary>
    private static string FolderTitle(CollectionGroup folder, bool open) =>
        $"{folder.Label} : {folder.Count} Pokémon — clique pour {(open ? "refermer" : "ouvrir")} le dossier";

    protected override async Task OnInitializedAsync()
    {
        // Le tri par défaut est celui du joueur connecté, même sur la collection d'un autre : sa façon de lire une liste.
        defaultSort = (await Preferences.SortsAsync((await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier))).Collection;
        if (Visitor)
        {
            player = await Players.FindAsync((await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier), Pseudo, PublicPages.Collection);
            playerChecked = true;
            if (player is null)
                return;
            userId = player.Id;
        }
        else
            userId = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
        saves = await Saves.ListAsync(userId);
        usage = await BankStore.GetUsageAsync(userId);
        abilities = await BankStore.ListAbilitiesAsync(userId);
    }

    // Les paramètres d'adresse sont lus ici (et non dans OnInitialized) pour suivre aussi les navigations ultérieures.
    protected override async Task OnParametersSetAsync()
    {
        columns = GridColumns.Clamp(ColumnsFromQuery ?? screenColumns);
        var fromQuery = SourceFromQuery ?? "";
        var sortFromQuery = SortFromAddress();
        var query = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        var criteriaFromQuery = PokemonCriteria.FromQuery(name => query.TryGetValue(name, out var value) ? value.ToString() : null);
        var compactFromQuery = CompactFromQuery == "1";
        if (!sourceInitialized || fromQuery != source || sortFromQuery != sort || criteriaFromQuery.Key != criteria.Key || compactFromQuery != compact)
        {
            sourceInitialized = true;
            source = fromQuery;
            sort = sortFromQuery;
            criteria = criteriaFromQuery;
            compact = compactFromQuery;
            await Reload();
        }
    }

    /// <summary>Tri lu dans l'adresse (sens par défaut du critère, sauf « ordre » contraire) ; sans tri, celui du compte.</summary>
    private CollectionSort SortFromAddress() => SiteSorts.CollectionFromQuery(new(SortFromQuery, OrderFromQuery)) ?? defaultSort;

    private bool Descending => SiteSorts.IsDescending(sort);

    /// <summary>Texte du bouton de sens : l'ordre affiché (cliquer l'inverse).</summary>
    private string OrderLabel => (sort.By, Descending) switch
    {
        (CollectionSortBy.Arrival, true) => "↓ Récents d'abord",
        (CollectionSortBy.Arrival, false) => "↑ Anciens d'abord",
        (CollectionSortBy.Name, false) => "↑ A → Z",
        (CollectionSortBy.Name, true) => "↓ Z → A",
        (_, false) => "↑ Croissant",
        (_, true) => "↓ Décroissant",
    };

    private async Task SortChanged(ChangeEventArgs e)
    {
        var by = SortChoices.FirstOrDefault(c => c.Slug == e.Value?.ToString(), SortChoices[0]).By;
        sort = new(by); // nouveau critère : son sens par défaut
        await ApplySort();
    }

    private async Task ReverseSort()
    {
        sort = sort with { Reversed = !sort.Reversed };
        await ApplySort();
    }

    private async Task ApplySort()
    {
        // Rien dans l'adresse pour le tri du compte ; sinon critère et sens en entier (« ?tri=arrivee » si le compte trie par nom).
        Nav.NavigateTo(Nav.GetUriWithQueryParameters(
            SiteSorts.AddressFor(SiteSorts.CollectionQuery(sort), SiteSorts.CollectionQuery(defaultSort))), replace: true);
        await Reload();
    }

    /// <summary>Appelé par Virtualize pour les lignes à afficher : on ne lit que ces Pokémon-là en base.</summary>
    private async ValueTask<ItemsProviderResult<CollectionCell[]>> LoadRows(ItemsProviderRequest request)
    {
        var cols = columns;
        var first = request.StartIndex * cols;
        if (compact)
        {
            var current = layout; // celle de la demande, même si un dossier s'ouvre pendant la lecture
            var cells = await LoadCompactCells(current, first, first + request.Count * cols, request.CancellationToken);
            return new ItemsProviderResult<CollectionCell[]>(cells.Chunk(cols), (current.CellCount + cols - 1) / cols);
        }
        var items = await BankStore.GetRangeAsync(userId, search, first, request.Count * cols, Filter, sort, request.CancellationToken);
        var rowCount = (total + cols - 1) / cols;
        return new ItemsProviderResult<CollectionCell[]>(items.Select(i => new CollectionCell(i)).Chunk(cols), rowCount);
    }

    /// <summary>
    /// Cases [<paramref name="first"/>, <paramref name="end"/>[ du mode compact : les dossiers, les Pokémon seuls de leur
    /// espèce (lus en une requête), et la tranche visible du contenu de chaque dossier ouvert.
    /// </summary>
    private async Task<List<CollectionCell>> LoadCompactCells(CollectionFolderLayout current, int first, int end, CancellationToken ct)
    {
        var parts = current.Slice(first, end);
        var singleIds = parts.Where(p => p.IsHead && p.Group.IsSingle).Select(p => p.Group.FirstId).ToList();
        var singles = (await BankStore.GetItemsAsync(userId, singleIds, ct)).ToDictionary(i => i.Id);
        var cells = new List<CollectionCell>();
        foreach (var part in parts)
        {
            if (part.IsHead)
            {
                if (!part.Group.IsSingle)
                    cells.Add(new(null, part.Group));
                else
                    cells.Add(singles.TryGetValue(part.Group.FirstId, out var item) ? new(item) : Gone);
                continue;
            }
            var members = await BankStore.GetRangeAsync(userId, search, part.MemberSkip, part.MemberCount,
                Filter with { Group = part.Group.Key }, sort, ct);
            cells.AddRange(members.Select(m => new CollectionCell(m, InFolder: true)));
            cells.AddRange(Enumerable.Repeat(Gone, part.MemberCount - members.Count)); // la suite reste à sa place
        }
        return cells;
    }

    /// <summary>Nouvelle recherche ou origine : recompte (ou regroupe, en mode compact), puis recrée la liste.</summary>
    private async Task Reload()
    {
        var request = ++reloadRequest;
        if (compact)
        {
            var found = await BankStore.GetGroupsAsync(userId, search, Filter, sort);
            if (request != reloadRequest) return;
            groups = found;
            layout = new(groups, openFolders);
            total = layout.PokemonCount;
        }
        else
        {
            var count = await BankStore.CountAsync(userId, search, Filter);
            if (request != reloadRequest) return; // une demande plus récente a déjà relancé le chargement
            total = count;
        }
        listVersion++;
    }

    /// <summary>Interrupteur du mode compact : nouvelle adresse (sans ajout à l'historique), dossiers refermés, rechargement.</summary>
    private async Task CompactChanged(ChangeEventArgs e)
    {
        compact = e.Value is true;
        openFolders.Clear();
        Nav.NavigateTo(Nav.GetUriWithQueryParameter(CompactQueryName, compact ? "1" : null), replace: true);
        await Reload();
    }

    /// <summary>
    /// Ouvre ou referme un dossier : ses Pokémon prennent (ou libèrent) les cases qui le suivent. La liste est relue sans
    /// être recréée, pour rester à la même hauteur de défilement.
    /// </summary>
    private async Task ToggleFolder(CollectionGroupKey key)
    {
        if (!openFolders.Remove(key))
            openFolders.Add(key);
        layout = new(groups, openFolders);
        if (list is not null)
            await list.RefreshDataAsync();
    }

    private async Task SourceChanged()
    {
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("source", source == "" ? null : source), replace: true);
        await Reload();
    }

    /// <summary>Pastilles modifiées : nouvelle adresse (sans ajout à l'historique), puis rechargement.</summary>
    private async Task CriteriaChanged(PokemonCriteria value)
    {
        criteria = value;
        Nav.NavigateTo(Nav.GetUriWithQueryParameters(value.ToQuery()), replace: true);
        await Reload();
    }

    private void ColumnsChanged() => listVersion++;

    /// <summary>Choix au curseur ; revenir à la valeur de la fenêtre rend la main à sa largeur.</summary>
    private void RememberColumns() =>
        Nav.NavigateTo(Nav.GetUriWithQueryParameter(GridColumns.QueryName, columns == screenColumns ? null : columns), replace: true);

    // ---------- Largeur de la fenêtre ----------

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        selfRef = DotNetObjectReference.Create(this);
        screenWatcher = await JS.InvokeAsync<IJSObjectReference>("watchScreenSize", GridColumns.NarrowWidth, GridColumns.WindowWidths, selfRef);
        ApplyScreenSize(await screenWatcher.InvokeAsync<int>("size"));
    }

    /// <summary>Appelé par le navigateur quand la largeur de la fenêtre change de tranche (redimensionnée, déplacée sur un autre écran).</summary>
    [JSInvokable]
    public Task OnScreenSizeChanged(int size) => InvokeAsync(() => ApplyScreenSize(size));

    private void ApplyScreenSize(int size)
    {
        screenColumns = GridColumns.ForScreen(size);
        if (ColumnsFromQuery is not null || columns == screenColumns)
            return; // nombre choisi au curseur : la taille de la fenêtre n'y touche pas
        columns = screenColumns;
        listVersion++;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (screenWatcher is not null)
        {
            try
            {
                await screenWatcher.InvokeVoidAsync("dispose");
                await screenWatcher.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // onglet fermé : plus rien à nettoyer côté navigateur
            }
        }
        selfRef?.Dispose();
    }

    /// <summary>Fin d'un achat d'emplacements (fenêtre de la jauge).</summary>
    private async Task OnPurchase(PurchaseResult result)
    {
        if (Visitor)
            return;
        message = result.Message;
        messageIsError = !result.Ok;
        usage = await BankStore.GetUsageAsync(userId);
    }

    // ---------- Fiche ----------

    private async Task Open(BankListItem item)
    {
        var entry = await BankStore.GetAsync(userId, item.Id);
        var pk = entry is null ? null : BankService.ToPkm(entry);
        if (entry is null || pk is null) return;
        selected = entry;
        selectedView = Info.Describe(pk, entry.IsLegal);
    }

    private void Close()
    {
        selected = null;
        selectedView = null;
    }

    private async Task DownloadPkm()
    {
        if (Visitor)
            return; // pas de copie des Pokémon d'un autre joueur
        if (selected is null || selected.StoredSaveId is not null) return; // lecture seule pour les sauvegardes stockées
        await Download($"{selected.Species:000} - {selected.Nickname}.{selected.Extension}", selected.Data);
    }

    private async Task Download(string fileName, byte[] data)
    {
        using var streamRef = new DotNetStreamReference(new MemoryStream(data));
        await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
    }
}
