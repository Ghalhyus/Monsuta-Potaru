@page "/combats"
@attribute [Authorize]
@implements IDisposable
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using MonsutaPotaru.Services
@using PKHeX.Core
@inject BattleHub Hub
@inject BattleService BattleStore
@inject FriendService FriendStore
@inject PreferencesService PreferenceStore
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Combat</PageTitle>

@* Multijoueurs → Combats : avec un ami, entre deux sauvegardes stockées de même génération (la 3e pour l'instant).
   Demande (valable BattleHub.RequestLifetime), choix des équipes, puis combat en direct dans le simulateur de Showdown
   (BattleHub), affiché sur deux écrans comme dans un jeu de 4e génération : celui du haut (terrain, PV, messages), celui
   du bas (Pokéballs des équipes, menu principal, capacités, équipe), empilés, côte à côte ou « hybride » (terrain en
   grand, menu dans un panneau à droite) au choix du joueur (retenu dans son compte, PreferencesService), à leur taille
   normale ou agrandis (bouton « Agrandir » : toute la place du contenu de la page, sans cacher le menu du site ; retenu aussi). Chaque choix a
   BattleTiming.Decision ; quitter la page pendant le combat demande confirmation, puis abandonne. *@
<NavigationLock ConfirmExternalNavigation="InBattle" OnBeforeInternalNavigation="BeforeLeaving" />

<PageHeader Title="Combat" Icon="bi-lightning-nav-menu" />

@if (message is not null)
{
    <div class="alert @(messageIsError ? "alert-danger" : "alert-success") alert-dismissible" role="alert">
        @message
        <button type="button" class="btn-close" aria-label="Fermer" @onclick="() => message = null"></button>
    </div>
}

@if (session is { } s)
{
    var me = s.Me(userId);
    var other = s.Other(userId);
    var preparing = s.Stage is BattleStage.Requested or BattleStage.TeamBuilding;
    @* .battle-block : conteneur CSS (bouton « Agrandir » caché quand la zone est trop étroite) ; .en-cours : bouton
       « Agrandir » juste à côté du titre (demande de l'utilisateur) ; .agrandi : écrans agrandis. *@
    <Block Title="@($"Combat contre {other.Pseudo}")"
           Class="@($"battle-block{(preparing ? "" : " en-cours")}{(enlarged && !preparing ? " agrandi" : "")}")">
        <Actions>
            @if (preparing)
            {
                <button type="button" class="btn btn-outline-danger" @onclick="CancelBattle">Annuler le combat</button>
            }
            else
            {
                <button type="button" class="btn btn-sm btn-outline-secondary battle-agrandir" aria-pressed="@(enlarged ? "true" : "false")"
                        @onclick="ToggleEnlarged">@(enlarged ? "Réduire" : "Agrandir")</button>
            }
        </Actions>
        <ChildContent>
            <p class="small text-muted battle-saves">Ta sauvegarde : @me.SaveLabel · Sa sauvegarde : @other.SaveLabel</p>

            @switch (s.Stage)
            {
                case BattleStage.Requested:
                    <p>En attente de la réponse de @other.Pseudo… La demande vaut jusqu'à @s.ExpiresAt.ToLocalTime().ToString("HH:mm"), tant que tu restes sur cette page.</p>
                    break;

                case BattleStage.TeamBuilding:
                    @if (s.TeamReady(userId))
                    {
                        <p>Ton équipe est prête. En attente de l'équipe de @other.Pseudo…</p>
                    }
                    else if (candidates is null)
                    {
                        <p class="text-muted">Chargement de tes Pokémon…</p>
                    }
                    else
                    {
                        var size = BattleService.TeamSize(candidates.Count);
                        <div class="battle-team-hint help-tip-anchor small text-muted mb-2">
                            <span>Choisis @size Pokémon de ta sauvegarde, dans l'ordre : le premier entre en combat.</span>
                            <HelpTip Label="Aide : choix de l'équipe">
                                Combat simple, niveaux réels, sans objet du sac. Ta sauvegarde n'est pas modifiée.
                            </HelpTip>
                        </div>
                        <div class="battle-team mb-3">
                            @for (var i = 0; i < size; i++)
                            {
                                var member = i < team.Count ? team[i] : null;
                                <div class="battle-team-slot @(member is null ? "empty" : "")">
                                    @if (member is not null)
                                    {
                                        <img src="@member.SpriteUrl" alt="" data-remplacement="images/pokemon/inconnu.png" />
                                        <span>@member.Name</span>
                                        <button type="button" class="btn-close btn-sm" aria-label="Retirer @member.Name" @onclick="() => Toggle(member)"></button>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">@(i + 1)</span>
                                    }
                                </div>
                            }
                            <button type="button" class="btn btn-primary ms-auto" @onclick="SubmitTeam" disabled="@(busy || team.Count != size)">Valider l'équipe</button>
                        </div>
                        <PokemonPickerSearch @bind-Search="search" @bind-Criteria="criteria" NoEggs="true"
                                             Abilities="PokemonSearch.Abilities(candidates, c => c.Traits)" />
                        var shown = PokemonSearch.Filter(candidates, search, criteria, c => c.Traits);
                        @if (shown.Count == 0)
                        {
                            <p class="text-muted small">Aucun Pokémon ne correspond.</p>
                        }
                        <div class="trade-candidates">
                            @foreach (var candidate in shown)
                            {
                                var c = candidate;
                                var order = team.IndexOf(c);
                                <button type="button" class="trade-candidate @(order >= 0 ? "selected" : "")" @onclick="() => Toggle(c)"
                                        title="@($"{c.SpeciesName} · Talent : {c.Ability} · Objet : {c.Item} · {string.Join(", ", c.Moves)}")"
                                        disabled="@(order < 0 && team.Count >= size)">
                                    @if (order >= 0)
                                    {
                                        <span class="battle-order">@(order + 1)</span>
                                    }
                                    <img src="@c.SpriteUrl" alt="" loading="lazy" data-remplacement="images/pokemon/inconnu.png" />
                                    <span class="trade-candidate-name">@c.Name@(c.IsShiny ? " ✨" : "")</span>
                                    <span class="small text-muted">N.@c.Level · @c.Location</span>
                                    @if (!c.IsLegal)
                                    {
                                        <span class="badge text-bg-warning">Illégal</span>
                                    }
                                </button>
                            }
                        </div>
                    }
                    break;

                default:
                    @if (s.OtherIllegal(userId) is > 0 and var illegal)
                    {
                        <div class="alert alert-warning py-2 small">
                            Attention : @(illegal == 1 ? "1 Pokémon" : $"{illegal} Pokémon") de l'équipe de @other.Pseudo @(illegal == 1 ? "est signalé illégal" : "sont signalés illégaux").
                        </div>
                    }
                    @if (s.Stage == BattleStage.Cancelled)
                    {
                        <div class="alert alert-secondary">@s.Notice</div>
                    }
                    @* Les deux écrans, dans la disposition choisie (boutons cachés quand la place manque pour les mettre côte à côte). *@
                    <div class="battle-zone">
                        <div class="battle-layout">
                            <span class="small text-muted">Écrans</span>
                            <div class="btn-group btn-group-sm" role="group" aria-label="Disposition des écrans">
                                @foreach (var (choice, _, label) in SiteSorts.BattleLayoutChoices)
                                {
                                    var c = choice;
                                    <button type="button" class="btn btn-outline-secondary @(layout == c ? "active" : "")"
                                            aria-pressed="@(layout == c ? "true" : "false")" @onclick="() => SetLayout(c)">@label</button>
                                }
                            </div>
                        </div>
                        @* --alertes : nombre d'alertes affichées au-dessus, pour que les écrans tiennent quand même dans la fenêtre *@
                        <div class="battle @(layout switch { BattleLayout.SideBySide => "cote", BattleLayout.Hybrid => "hybride", _ => "" })"
                             style="--alertes: @((s.OtherIllegal(userId) > 0 ? 1 : 0) + (s.Stage == BattleStage.Cancelled ? 1 : 0))">
                            @{
                                var scene = shownScene ?? snapshot?.Scene;
                            }
                            @* ---------- Écran du haut : le terrain ---------- *@
                            <div class="battle-top">
                                <div class="battle-field">
                                    <div class="battle-base foe"></div>
                                    <div class="battle-base mine"></div>
                                    @if (scene?.Foe is { } foe)
                                    {
                                        <div class="battle-info foe">
                                            <div class="battle-info-box">
                                                <div class="battle-info-name">
                                                    <span>@foe.Name</span><span class="battle-gender @foe.Gender">@Gender(foe.Gender)</span>
                                                    <span class="battle-level">N.@foe.Level</span>
                                                </div>
                                                <div class="battle-hp">
                                                    @if (Status(foe.Status) is { } status)
                                                    {
                                                        <span class="battle-status @foe.Status">@status</span>
                                                    }
                                                    @HpMeter(foe.Percent)
                                                </div>
                                            </div>
                                        </div>
                                        @if (foe.Hp > 0 || animated?.Cue == BattleCue.Faint)
                                        {
                                            <img @key="@($"foe-{animationKey}")" class="battle-sprite foe @Animation(false)" src="@sprites.Url(foe, false)" alt="@foe.SpeciesName"
                                                 data-remplacement="@BattleSprites.Fallback(foe)" />
                                        }
                                    }
                                    @if (scene?.Me is { } mine)
                                    {
                                        @if (mine.Hp > 0 || animated?.Cue == BattleCue.Faint)
                                        {
                                            <img @key="@($"mine-{animationKey}")" class="battle-sprite mine @Animation(true)" src="@sprites.Url(mine, true)" alt="@mine.SpeciesName"
                                                 data-remplacement="@BattleSprites.Fallback(mine)" />
                                        }
                                        <div class="battle-info mine">
                                            <div class="battle-info-box">
                                                <div class="battle-info-name">
                                                    <span>@mine.Name</span><span class="battle-gender @mine.Gender">@Gender(mine.Gender)</span>
                                                    <span class="battle-level">N.@mine.Level</span>
                                                </div>
                                                <div class="battle-hp">
                                                    @if (Status(mine.Status) is { } status)
                                                    {
                                                        <span class="battle-status @mine.Status">@status</span>
                                                    }
                                                    @HpMeter(mine.Percent)
                                                </div>
                                                <div class="battle-hp-text">@mine.Hp/@mine.MaxHp</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="battle-text" aria-live="polite"><div>@TextBox()</div></div>
                            </div>

                            @* ---------- Écran du bas : le menu tactile ---------- *@
                            <div class="battle-bottom @(ShowsTeam ? "equipe" : "")">
                                @* Pokéballs des deux équipes (les miennes à gauche), minuteur entre les deux. Quand le menu
                                   de l'équipe prend tout l'écran (.equipe), la barre n'est montrée qu'en mode hybride. *@
                                <div class="battle-bar">
                                    @BallRow(true, scene?.MyLeft ?? 0, scene?.MyTeam ?? 0)
                                    @if (CanAct && SecondsLeft is { } seconds)
                                    {
                                        <div class="battle-timer @(seconds <= 10 ? "urgent" : "")">@seconds s</div>
                                    }
                                    @BallRow(false, scene?.FoeLeft ?? 0, scene?.FoeTeam ?? 0)
                                </div>
                                @if (s.Stage == BattleStage.Done || s.Stage == BattleStage.Cancelled)
                                {
                                    <div class="battle-end">
                                        @if (s.Stage == BattleStage.Done && !Playing)
                                        {
                                            <div class="battle-result @(snapshot?.Outcome.ToString().ToLowerInvariant())">
                                                @(snapshot?.Outcome switch { BattleOutcome.Won => "Victoire !", BattleOutcome.Lost => "Défaite…", _ => "Match nul" })
                                            </div>
                                        }
                                        <div class="battle-after">
                                            <a class="btn btn-outline-secondary" href="">Retour à l'accueil</a>
                                            <button type="button" class="btn btn-primary" @onclick="NewBattle">Nouveau combat</button>
                                        </div>
                                    </div>
                                }
                                else if (CanAct && snapshot!.Request is { } request)
                                {
                                    @if (ShowsTeam && Shown != Menu.Team)
                                    {
                                        @* Fiche d'un Pokémon de l'équipe (carte Trello 111) : écran de sélection (CHANGER, RÉSUMÉ,
                                           CAPACITÉS), résumé, capacités, détail d'une capacité. Tout vient de la requête. *@
                                        var count = request.Side.Pokemon.Count;
                                        var index = Math.Clamp(opened, 0, count - 1);
                                        var sheet = BattleSheet.Of(request.Side.Pokemon[index]);
                                        @switch (Shown)
                                        {
                                            case Menu.Summary:
                                                <div class="battle-sheet resume">
                                                    @SheetHead(sheet)
                                                    <div class="battle-sheet-body">
                                                        <div class="battle-sheet-left">
                                                            <div class="battle-sheet-label niveau"><span>N.</span><span>@sheet.Level</span></div>
                                                            <div class="battle-sheet-label">@sheet.Ability</div>
                                                            <div class="battle-sheet-text">@sheet.AbilityText</div>
                                                            <div class="battle-sheet-item">
                                                                <span class="battle-sheet-item-icon">
                                                                    @if (sheet.ItemUrl is { } itemUrl)
                                                                    {
                                                                        <img src="@itemUrl" alt="" data-cacher-si-absente />
                                                                    }
                                                                </span>
                                                                <span>@(sheet.Item ?? "Aucun objet tenu")</span>
                                                            </div>
                                                        </div>
                                                        <div class="battle-sheet-stats">
                                                            <div class="battle-stat"><span>PV</span><span>@sheet.Hp/@sheet.MaxHp</span></div>
                                                            <div class="battle-hp">
                                                                @if (sheet.Fainted)
                                                                {
                                                                    <span class="battle-status fnt">K.O.</span>
                                                                }
                                                                else if (Status(sheet.Status) is { } status)
                                                                {
                                                                    <span class="battle-status @sheet.Status">@status</span>
                                                                }
                                                                @HpMeter(sheet.Percent)
                                                            </div>
                                                            @if (sheet.Stats is { } stats)
                                                            {
                                                                <div class="battle-stat"><span>ATTAQUE</span><span>@stats.Atk</span></div>
                                                                <div class="battle-stat"><span>DÉFENSE</span><span>@stats.Def</span></div>
                                                                <div class="battle-stat"><span>ATQ. SPÉ.</span><span>@stats.SpA</span></div>
                                                                <div class="battle-stat"><span>DÉF. SPÉ.</span><span>@stats.SpD</span></div>
                                                                <div class="battle-stat"><span>VITESSE</span><span>@stats.Spe</span></div>
                                                            }
                                                        </div>
                                                    </div>
                                                    @SheetFoot("CAPACITÉS", Menu.MemberMoves, Menu.Member, "Pokémon", count, i => opened = (index + i + count) % count)
                                                </div>
                                                break;

                                            case Menu.MemberMoves:
                                                <div class="battle-sheet capacites">
                                                    @SheetHead(sheet)
                                                    <div class="battle-sheet-moves">
                                                        @for (var i = 0; i < Math.Max(4, sheet.Moves.Count); i++)
                                                        {
                                                            if (i >= sheet.Moves.Count)
                                                            {
                                                                <div class="battle-sheet-move vide"></div>
                                                                continue;
                                                            }
                                                            var slot = i;
                                                            <button type="button" class="battle-btn battle-sheet-move type-@sheet.Moves[i].Type.Key"
                                                                    @onclick="() => { openedMove = slot; menu = Menu.MoveDetail; }">
                                                                @SheetMove(sheet.Moves[i])
                                                            </button>
                                                        }
                                                    </div>
                                                    @SheetFoot("RÉSUMÉ", Menu.Summary, Menu.Member, "Pokémon", count, i => opened = (index + i + count) % count)
                                                </div>
                                                break;

                                            case Menu.MoveDetail when sheet.Moves.Count > 0:
                                                var moves = sheet.Moves.Count;
                                                var shownMove = Math.Clamp(openedMove, 0, moves - 1);
                                                var info = sheet.Moves[shownMove];
                                                <div class="battle-sheet detail">
                                                    @SheetHead(sheet)
                                                    <div class="battle-sheet-detail">
                                                        <div class="battle-sheet-move type-@info.Type.Key">@SheetMove(info)</div>
                                                        <div class="battle-sheet-facts">
                                                            <div class="battle-stat"><span>CATÉGORIE</span><span>@info.CategoryName</span></div>
                                                            <div class="battle-stat"><span>PUISSANCE</span><span>@info.PowerText</span></div>
                                                            <div class="battle-stat"><span>PRÉCISION</span><span>@info.AccuracyText</span></div>
                                                        </div>
                                                        <div class="battle-sheet-text">@info.Text</div>
                                                    </div>
                                                    @SheetFoot(null, Menu.MoveDetail, Menu.MemberMoves, "Capacité", moves, i => openedMove = (shownMove + i + moves) % moves)
                                                </div>
                                                break;

                                            default:
                                                @* Écran de sélection : le grand panneau envoie le Pokémon au combat (grisé pour celui qui
                                                   y est déjà et pour un K.O., dont la fiche reste consultable) *@
                                                <div class="battle-sheet selection">
                                                    <button type="button" class="battle-btn battle-shift" disabled="@(sheet.Active || sheet.Fainted)"
                                                            @onclick="() => Choose(BattleChoice.SwitchTo(index + 1))">
                                                        <span class="battle-shift-name">
                                                            <span>@sheet.Name</span><span class="battle-gender @sheet.Gender">@Gender(sheet.Gender)</span>
                                                        </span>
                                                        <img src="@sheet.IconUrl" alt="@sheet.SpeciesName" data-remplacement="images/pokemon/inconnu.png" />
                                                        <span class="battle-shift-word">@(sheet.Active ? "AU COMBAT" : sheet.Fainted ? "K.O." : "CHANGER")</span>
                                                    </button>
                                                    @SheetTimer()
                                                    <div class="battle-sheet-foot">
                                                        <button type="button" class="battle-btn battle-sheet-btn" @onclick="() => menu = Menu.Summary"><span>RÉSUMÉ</span></button>
                                                        <button type="button" class="battle-btn battle-sheet-btn" @onclick="() => menu = Menu.MemberMoves"><span>CAPACITÉS</span></button>
                                                        <button type="button" class="battle-btn battle-sheet-btn retour" aria-label="Retour" title="Retour" @onclick="() => menu = Menu.Team"><span aria-hidden="true">↵</span></button>
                                                    </div>
                                                </div>
                                                break;
                                        }
                                    }
                                    else if (ShowsTeam)
                                    {
                                        @* Menu POKéMON : six panneaux sur deux colonnes décalées, le message et le retour en bas. Chaque
                                           panneau ouvre l'écran de sélection du Pokémon (celui qui est au combat et les K.O. compris). *@
                                        <div class="battle-team-menu">
                                            @for (var i = 0; i < request.Side.Pokemon.Count; i++)
                                            {
                                                var place = i;
                                                var teammate = request.Side.Pokemon[i];
                                                var (hp, max, memberStatus) = BattleProtocol.Condition(teammate.Condition);
                                                var (species, _, speciesName) = BattleNames.SpeciesOf(teammate.Details);
                                                var (level, gender, _) = BattleProtocol.Details(teammate.Details);
                                                var fainted = memberStatus == "fnt";
                                                var percent = max > 0 ? (int)Math.Ceiling(hp * 100.0 / max) : 0;
                                                <button type="button" class="battle-btn battle-member @(teammate.Active ? "active" : "") @(fainted ? "fainted" : "")"
                                                        @onclick="() => { opened = place; menu = Menu.Member; }">
                                                    <img src="@PokemonSprites.Url(species, 0, EntityContext.Gen3, false, 0, false)" alt="" data-remplacement="images/pokemon/inconnu.png" />
                                                    <span class="battle-member-name">@BattleProtocol.Who(teammate.Ident).Name</span>
                                                    <span class="battle-gender @gender">@Gender(gender)</span>
                                                    <span class="battle-hp">@HpMeter(percent)</span>
                                                    <span class="battle-member-foot">
                                                        @if (fainted)
                                                        {
                                                            <span class="battle-status fnt">K.O.</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="battle-member-level">N.@level</span>
                                                            @if (Status(memberStatus) is { } status)
                                                            {
                                                                <span class="battle-status @memberStatus">@status</span>
                                                            }
                                                            <span class="battle-member-hp">@hp/@max</span>
                                                        }
                                                    </span>
                                                    <span class="visually-hidden">@speciesName@(teammate.Active ? ", au combat" : "")</span>
                                                </button>
                                            }
                                            <div class="battle-team-text">
                                                <div>
                                                    <span>Choisis un Pokémon.</span>
                                                    @if (SecondsLeft is { } remaining)
                                                    {
                                                        <span class="battle-timer @(remaining <= 10 ? "urgent" : "")">@remaining s</span>
                                                    }
                                                </div>
                                            </div>
                                            @if (!request.MustSwitch)
                                            {
                                                <button type="button" class="battle-btn battle-back retour" aria-label="Annuler" title="Annuler" @onclick="() => menu = Menu.Main"><span aria-hidden="true">↵</span></button>
                                            }
                                        </div>
                                    }
                                    else if (menu == Menu.Moves && request.Active is [var active, ..])
                                    {
                                        @* Capacités : quatre emplacements (les vides restent gris), ANNULER en bas *@
                                        <div class="battle-moves">
                                            @for (var i = 0; i < Math.Max(4, active.Moves.Count); i++)
                                            {
                                                if (i >= active.Moves.Count)
                                                {
                                                    <div class="battle-move vide"></div>
                                                    continue;
                                                }
                                                var index = i + 1;
                                                var move = active.Moves[i];
                                                <button type="button" class="battle-btn battle-move type-@BattleNames.MoveTypeKey(move.Move)" disabled="@move.IsDisabled"
                                                        @onclick="() => Choose(BattleChoice.Move(index))">
                                                    <span class="battle-move-name">@BattleNames.Move(move.Move)</span>
                                                    <span class="battle-move-foot">
                                                        <span class="battle-move-type">@BattleNames.MoveType(move.Move)</span>
                                                        @if (move.MaxPp is { } maxPp)
                                                        {
                                                            <span class="battle-move-pp">PP @move.Pp/@maxPp</span>
                                                        }
                                                    </span>
                                                </button>
                                            }
                                            <button type="button" class="battle-btn battle-back" @onclick="() => menu = Menu.Main"><span>ANNULER</span></button>
                                        </div>
                                    }
                                    else
                                    {
                                        @* Menu principal : pas de bouton SAC (pas de sac en combat de câble) ; « Abandonner » fait
                                           perdre. Mode hybride : les trois boutons en colonne, ABANDONNER en dernier. *@
                                        RenderFragment run = @<button type="button" class="battle-btn battle-run" @onclick="Forfeit"><span>ABANDONNER</span></button>;
                                        <div class="battle-menu">
                                            <button type="button" class="battle-btn battle-fight" @onclick="() => menu = Menu.Moves">
                                                @if (scene?.Me is { } lead)
                                                {
                                                    <img src="@BattleSprites.Fallback(lead)" alt="" data-cacher-si-absente />
                                                }
                                                <span>ATTAQUE</span>
                                            </button>
                                            @if (layout != BattleLayout.Hybrid)
                                            {
                                                @run
                                            }
                                            <button type="button" class="battle-btn battle-pokemon" @onclick="() => menu = Menu.Team"><span>POKéMON</span></button>
                                            @if (layout == BattleLayout.Hybrid)
                                            {
                                                @run
                                            }
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="battle-waiting">@(Playing ? "" : $"En attente de {s.Other(userId).Pseudo}…")</div>
                                }
                            </div>
                        </div>
                    </div>
                    break;
            }
        </ChildContent>
    </Block>
}
else
{
    @* ---------- Demandes reçues ---------- *@
    var incoming = Hub.Incoming(userId);
    @if (incoming.Count > 0)
    {
        <Block Title="Demandes reçues" Flush="true">
            <div class="list-group">
                @foreach (var request in incoming)
                {
                    var r = request;
                    <div class="list-group-item d-flex flex-wrap align-items-center gap-2">
                        <span>
                            <strong>@r.First.Pseudo</strong> te propose un combat : sa sauvegarde « @r.First.SaveLabel » contre ta sauvegarde « @r.Second.SaveLabel ».
                            <span class="d-block small text-muted">Jusqu'à @r.ExpiresAt.ToLocalTime().ToString("HH:mm").</span>
                        </span>
                        <button type="button" class="btn btn-sm btn-primary ms-auto" @onclick="() => Accept(r)">Accepter</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => Hub.Leave(r, userId)">Refuser</button>
                    </div>
                }
            </div>
        </Block>
    }

    @* ---------- Nouveau combat : l'ami, puis la paire de sauvegardes ---------- *@
    <Block Title="Nouveau combat">
        <Help>
            <p>
                Le combat se fait en direct, avec un ami connecté, entre deux sauvegardes stockées de la même génération (la 3e pour
                l'instant : Rubis, Saphir, Émeraude, Rouge Feu, Vert Feuille).
            </p>
            <ul>
                <li>Combat simple, équipes de 6, niveaux réels, comme un combat de câble.</li>
                <li>Chaque joueur a @((int)BattleTiming.Decision.TotalSeconds) secondes pour choisir son action : passé ce délai, il perd.</li>
                <li>Les sauvegardes ne sont pas modifiées.</li>
            </ul>
        </Help>
        <ChildContent>
            @if (friends is null)
            {
                <p class="text-muted">Chargement…</p>
            }
            else if (friends.Count == 0)
            {
                <p class="text-muted">Il te faut un ami pour combattre : ajoute-en dans <a href="amis">Amis</a>.</p>
            }
            else
            {
                <select class="form-select mb-3 battle-friend" aria-label="Ami" value="@friendId" @onchange="FriendChosen">
                    <option value="">Choisis un ami…</option>
                    @foreach (var f in friends)
                    {
                        <option value="@f.UserId">@(f.Pseudo ?? FriendService.NoPseudo)</option>
                    }
                </select>
                @if (pairs is not null)
                {
                    @if (pairs.Count == 0)
                    {
                        <p class="text-muted">Vous n'avez aucune sauvegarde stockée de la même génération parmi celles qui ont déjà leurs combats.</p>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (var pair in pairs)
                            {
                                var p = pair;
                                <div class="list-group-item d-flex flex-wrap align-items-center gap-2">
                                    <span>Ta sauvegarde : <strong>@p.Mine.Label</strong></span>
                                    <span class="mx-2">⚔</span>
                                    <span>Sa sauvegarde : <strong>@p.Theirs.Label</strong></span>
                                    <button type="button" class="btn btn-sm btn-primary ms-auto" @onclick="() => Propose(p)" disabled="@busy">Proposer le combat</button>
                                </div>
                            }
                        </div>
                    }
                }
            }
        </ChildContent>
    </Block>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    /// <summary>
    /// Écran du bas : menu principal, capacités du Pokémon au combat, équipe, puis la fiche d'un Pokémon de l'équipe
    /// (écran de sélection, résumé, ses capacités, détail d'une capacité).
    /// </summary>
    private enum Menu { Main, Moves, Team, Member, Summary, MemberMoves, MoveDetail }

    private string userId = "";
    private string pseudo = "";
    private BattleSession? session;
    private BattleSnapshot? snapshot;
    private List<FriendEntry>? friends;
    private string friendId = "";
    private List<BattleSavePair>? pairs;
    private List<BattleCandidate>? candidates;
    private readonly List<BattleCandidate> team = [];
    private string search = ""; // recherche et pastilles de « Ma collection » sur mes Pokémon, gardées le temps de la page
    private PokemonCriteria criteria = PokemonCriteria.None;
    private bool busy;
    private string? message;
    private bool messageIsError;
    private Menu menu;
    private int opened; // fiche ouverte : place du Pokémon dans la requête
    private int openedMove; // capacité détaillée sur la fiche
    private BattleLayout layout; // écrans empilés, côte à côte ou hybride : préférence du compte
    private bool enlarged; // écrans agrandis : préférence du compte

    // Lecture des étapes : une à une, au rythme de BattleTiming.
    private int played;
    private bool playing;
    private BattleStep? animated; // étape en cours (animation)
    private BattleSprites sprites = BattleSprites.None; // ceux du jeu de ma sauvegarde, connus quand mon équipe est acceptée
    private int animationKey; // change à chaque étape : relance l'animation CSS
    private BattleScene? shownScene;
    private string? shownText;
    private Timer? clock; // compte à rebours

    /// <summary>Un combat est en cours (ou en préparation) : quitter la page l'annulerait, ou ferait perdre.</summary>
    private bool InBattle => session is { IsOver: false };

    private bool Playing => playing || (snapshot is not null && played < snapshot.StepCount);

    /// <summary>Écran affiché : après un K.O., l'équipe remplace le menu principal (il faut choisir un remplaçant).</summary>
    private Menu Shown => snapshot?.Request is { MustSwitch: true } && menu is Menu.Main or Menu.Moves ? Menu.Team : menu;

    /// <summary>L'équipe ou la fiche d'un de ses Pokémon occupe tout l'écran du bas (choisie, ou remplacement forcé après un K.O.).</summary>
    private bool ShowsTeam => CanAct && snapshot?.Request is not null && Shown is not (Menu.Main or Menu.Moves);

    /// <summary>Le joueur doit choisir (toutes les étapes jouées, requête en attente, pas encore de choix).</summary>
    private bool CanAct => !Playing && snapshot is { Stage: BattleStage.Fighting, Chosen: false, Request.MustAct: true } && !(session?.IsOver ?? true);

    private int? SecondsLeft => snapshot?.Deadline is { } deadline
        ? Math.Clamp((int)Math.Ceiling((deadline - DateTime.UtcNow).TotalSeconds), 0, (int)BattleTiming.Decision.TotalSeconds)
        : null;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        userId = user.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
        pseudo = user.Identity?.Name ?? "";
        var preferences = await PreferenceStore.SortsAsync(userId);
        layout = preferences.Battle;
        enlarged = preferences.BattleEnlarged;
        Hub.RequestsChanged += OnRequestsChanged;
        if (Hub.Active(userId) is { } active) // page rechargée pendant un combat : on reprend où il en est
            await Join(active, skipHistory: true);
        friends = (await FriendStore.ListAsync(userId)).Friends.ToList();
    }

    private async Task Join(BattleSession joined, bool skipHistory = false)
    {
        if (session is not null)
            session.Changed -= OnSessionChanged;
        session = joined;
        session.Changed += OnSessionChanged;
        snapshot = session.Snapshot(userId);
        played = skipHistory ? snapshot.StepCount : 0;
        shownScene = skipHistory ? snapshot.Scene : null;
        clock ??= new Timer(_ => InvokeAsync(() => { if (session?.Stage == BattleStage.Fighting) StateHasChanged(); }), null, 500, 500);
        await Refresh();
    }

    private async Task Refresh()
    {
        if (session is null)
            return;
        snapshot = session.Snapshot(userId);
        if (snapshot.Error is { } error)
            message = error;
        if (session.Stage == BattleStage.TeamBuilding && candidates is null && !session.TeamReady(userId))
            candidates = await BattleStore.CandidatesAsync(userId, session.Me(userId).SaveId);
        if (session.Stage != BattleStage.Requested && message?.StartsWith("Demande envoyée") == true)
            message = null;
        _ = PlayAsync();
    }

    /// <summary>Joue les nouvelles étapes une à une (message, animation, PV), puis rend la main au menu.</summary>
    private async Task PlayAsync()
    {
        // Rien de nouveau (l'autre joueur a seulement choisi) : surtout ne pas refermer le menu ouvert.
        if (playing || session is null || session.Steps(userId, played).Count == 0)
            return;
        playing = true;
        try
        {
            while (session.Steps(userId, played) is { Count: > 0 } steps)
            {
                foreach (var step in steps)
                {
                    played++;
                    animated = step;
                    animationKey++;
                    shownScene = step.Scene;
                    if (step.Text is not null)
                        shownText = step.Text;
                    StateHasChanged();
                    await Task.Delay(step.Text is null ? BattleTiming.AnimationStep : BattleTiming.TextStep);
                }
            }
        }
        finally
        {
            playing = false;
            animated = null;
            menu = Menu.Main;
            snapshot = session.Snapshot(userId);
            StateHasChanged();
        }
    }

    private void OnSessionChanged() => InvokeAsync(async () =>
    {
        await Refresh();
        StateHasChanged();
    });

    private void OnRequestsChanged(string user)
    {
        if (user == userId)
            InvokeAsync(StateHasChanged);
    }

    private async Task FriendChosen(ChangeEventArgs e)
    {
        friendId = e.Value?.ToString() ?? "";
        pairs = null;
        if (friendId.Length > 0)
            pairs = await BattleStore.SavePairsAsync(userId, friendId);
    }

    private async Task Propose(BattleSavePair pair)
    {
        var friend = friends?.FirstOrDefault(f => f.UserId == friendId);
        if (friend is null)
            return;
        var (created, text) = Hub.Request(new BattleParty(userId, pseudo, pair.Mine.Id, pair.Mine.Label),
            new BattleParty(friend.UserId, friend.Pseudo ?? FriendService.NoPseudo, pair.Theirs.Id, pair.Theirs.Label), pair.Format);
        message = text;
        messageIsError = created is null;
        if (created is not null)
            await Join(created);
    }

    private async Task Accept(BattleSession request)
    {
        if (Hub.Accept(request, userId) is { } error)
        {
            message = error;
            messageIsError = true;
            return;
        }
        message = null;
        await Join(request);
    }

    private void Toggle(BattleCandidate candidate)
    {
        if (!team.Remove(candidate) && candidates is not null && team.Count < BattleService.TeamSize(candidates.Count))
            team.Add(candidate);
    }

    private async Task SubmitTeam()
    {
        if (session is not { } s)
            return;
        busy = true;
        try
        {
            var result = await BattleStore.TeamAsync(userId, s.Me(userId).SaveId, pseudo, team);
            var error = result.Team is null ? result.Error : Hub.SubmitTeam(s, userId, result.Team, result.Illegal);
            if (error is null)
                sprites = result.Sprites ?? BattleSprites.None;
            if (error is not null)
            {
                message = error;
                messageIsError = true;
                candidates = null; // relue : la sauvegarde a peut-être changé
                team.Clear();
                await Refresh();
            }
        }
        finally
        {
            busy = false;
        }
    }

    private void Choose(BattleChoice choice)
    {
        if (session is null)
            return;
        if (BattleHub.Choose(session, userId, choice) is { } error)
        {
            message = error;
            messageIsError = true;
            return;
        }
        message = null;
        menu = Menu.Main;
        snapshot = session.Snapshot(userId);
    }

    private async Task Forfeit()
    {
        if (session is null || !await JS.InvokeAsync<bool>("confirm", "Abandonner le combat ? Tu perdras."))
            return;
        BattleHub.Forfeit(session, userId);
    }

    /// <summary>Disposition des écrans : appliquée tout de suite, et retenue dans le compte (comme dans « Préférences »).</summary>
    private async Task SetLayout(BattleLayout chosen)
    {
        if (layout == chosen)
            return;
        layout = chosen;
        await PreferenceStore.SetBattleLayoutAsync(userId, chosen);
    }

    /// <summary>« Agrandir » / « Réduire » : appliqué tout de suite, et retenu dans le compte (comme dans « Préférences »).</summary>
    private async Task ToggleEnlarged()
    {
        enlarged = !enlarged;
        await PreferenceStore.SetBattleEnlargedAsync(userId, enlarged);
    }

    /// <summary>« Annuler le combat » (demande ou choix des équipes) : annulé pour les deux, retour à l'accueil.</summary>
    private void CancelBattle()
    {
        if (session is not null)
            Hub.Leave(session, userId);
        Navigation.NavigateTo("");
    }

    private async Task BeforeLeaving(LocationChangingContext context)
    {
        if (!InBattle)
            return;
        var question = session!.Stage == BattleStage.Fighting
            ? "Quitter cette page abandonne le combat : tu perdras. Continuer ?"
            : "Quitter cette page annule le combat, pour toi et pour ton ami. Continuer ?";
        if (!await JS.InvokeAsync<bool>("confirm", question))
        {
            context.PreventNavigation();
            return;
        }
        Hub.Leave(session, userId, $"{pseudo} a quitté le combat.");
    }

    private void NewBattle()
    {
        if (session is not null)
            session.Changed -= OnSessionChanged;
        session = null;
        snapshot = null;
        candidates = null;
        team.Clear();
        played = 0;
        shownScene = null;
        shownText = null;
        message = null;
    }

    // ---------- Affichage ----------

    private string TextBox()
    {
        if (Playing && shownText is not null)
            return shownText;
        if (snapshot is null || session is null)
            return "";
        if (session.Stage is BattleStage.Done or BattleStage.Cancelled)
            return shownText ?? session.Notice ?? "";
        if (CanAct)
        {
            return snapshot.Request!.MustSwitch
                ? "Choisis le Pokémon à envoyer."
                : $"Que doit faire {snapshot.Scene.Me?.Name ?? "ton Pokémon"} ?";
        }
        return shownText ?? "";
    }

    private string Animation(bool mine) => animated is not { } step || step.Mine != mine ? "" : step.Cue switch
    {
        BattleCue.Attack => "attaque",
        BattleCue.Damage => "touche",
        BattleCue.Faint => "ko",
        BattleCue.SwitchIn => "entree",
        _ => "",
    };

    private static string HpClass(int percent) => percent switch { > 50 => "hp-high", > 20 => "hp-mid", _ => "hp-low" };

    private static string Gender(string gender) => gender switch { "M" => "♂", "F" => "♀", _ => "" };

    private static string? Status(string? status) => status switch
    {
        "brn" => "BRU", "par" => "PAR", "slp" => "SOM", "frz" => "GEL", "psn" or "tox" => "PSN", _ => null,
    };

    /// <summary>Barre de PV : l'étiquette « PV » et la jauge, dans la même capsule sombre.</summary>
    private static RenderFragment HpMeter(int percent) => __builder =>
    {
        <span class="battle-hp-meter"><span class="battle-hp-label">PV</span><span class="battle-hp-bar"><span class="@HpClass(percent)" style="width: @(percent)%"></span></span></span>
    };

    // ---------- Fiche d'un Pokémon de l'équipe ----------

    /// <summary>Temps restant pour choisir : il continue de courir pendant qu'on lit une fiche.</summary>
    private RenderFragment SheetTimer() => __builder =>
    {
        if (SecondsLeft is { } remaining)
        {
            <span class="battle-timer @(remaining <= 10 ? "urgent" : "")">@remaining s</span>
        }
    };

    /// <summary>Bandeau du haut d'une fiche : icône, nom, sexe et types du Pokémon, puis le minuteur.</summary>
    private RenderFragment SheetHead(BattleSheet sheet) => __builder =>
    {
        <div class="battle-sheet-head">
            <img src="@sheet.IconUrl" alt="@sheet.SpeciesName" data-remplacement="images/pokemon/inconnu.png" />
            <span class="battle-sheet-name">@sheet.Name</span>
            <span class="battle-gender @sheet.Gender">@Gender(sheet.Gender)</span>
            <span class="battle-sheet-types">
                @foreach (var type in sheet.Types)
                {
                    <span class="battle-move-type type-@type.Key">@type.Name</span>
                }
            </span>
            @SheetTimer()
        </div>
    };

    /// <summary>Panneau d'une capacité sur la fiche : nom, puis type et PP.</summary>
    private static RenderFragment SheetMove(BattleSheetMove move) => __builder =>
    {
        <span class="battle-sheet-move-name">@move.Name</span>
        <span class="battle-sheet-move-foot">
            <span class="battle-move-type">@move.Type.Name</span>
            @if (move.MaxPp is { } maxPp)
            {
                <span class="battle-move-pp">PP @move.Pp/@maxPp</span>
            }
        </span>
    };

    /// <summary>
    /// Bas d'une fiche : flèches (Pokémon précédent ou suivant de l'équipe ; capacité, sur le détail), bouton vers l'autre
    /// écran de la fiche (<paramref name="other"/>, absent du détail) et retour.
    /// </summary>
    private RenderFragment SheetFoot(string? other, Menu otherMenu, Menu back, string what, int count, Action<int> step) => __builder =>
    {
        var feminine = what == "Capacité";
        <div class="battle-sheet-foot">
            <button type="button" class="battle-btn battle-sheet-btn fleche" disabled="@(count < 2)" @onclick="() => step(-1)"
                    aria-label="@($"{what} {(feminine ? "précédente" : "précédent")}")" title="@($"{what} {(feminine ? "précédente" : "précédent")}")"><span aria-hidden="true">▲</span></button>
            <button type="button" class="battle-btn battle-sheet-btn fleche" disabled="@(count < 2)" @onclick="() => step(1)"
                    aria-label="@($"{what} {(feminine ? "suivante" : "suivant")}")" title="@($"{what} {(feminine ? "suivante" : "suivant")}")"><span aria-hidden="true">▼</span></button>
            @if (other is not null)
            {
                <button type="button" class="battle-btn battle-sheet-btn autre" @onclick="() => menu = otherMenu"><span>@other</span></button>
            }
            <button type="button" class="battle-btn battle-sheet-btn retour" aria-label="Retour" title="Retour" @onclick="() => menu = back"><span aria-hidden="true">↵</span></button>
        </div>
    };

    /// <summary>
    /// Les six Pokéballs d'une équipe, comme en jeu : une Ball par Pokémon en état de se battre, une Ball grise par
    /// Pokémon K.O., un rond vide par place libre.
    /// </summary>
    private static RenderFragment BallRow(bool mine, int left, int team) => __builder =>
    {
        <div class="battle-balls @(mine ? "mine" : "foe")" role="img"
             aria-label="@($"{(mine ? "Ton équipe" : "Équipe adverse")} : {left} Pokémon sur {team} en état de se battre")">
            @for (var i = 0; i < 6; i++)
            {
                <span class="battle-ball @(i < left ? "ok" : i < team ? "ko" : "vide")"></span>
            }
        </div>
    };

    public void Dispose()
    {
        clock?.Dispose();
        Hub.RequestsChanged -= OnRequestsChanged;
        if (session is null)
            return;
        session.Changed -= OnSessionChanged;
        Hub.Leave(session, userId, $"{pseudo} a quitté le combat."); // onglet fermé, connexion perdue : sans effet si fini
    }
}
