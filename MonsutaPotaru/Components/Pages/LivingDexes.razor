@page "/livingdex"
@page "/joueurs/{Pseudo}/livingdex"
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using MonsutaPotaru.Components.Shared
@using MonsutaPotaru.Data
@using MonsutaPotaru.Services
@inject LivingDexService Dexes
@inject NavigationManager Navigation
@inject PlayerService Players
@inject PreferencesService Preferences

<PageTitle>@PageName</PageTitle>

@* Living dex du compte : une carte par jeu (jaquette, sauvegarde, progression), et la création d'un nouveau sur une
   sauvegarde stockée de 1re à 9e génération ; ou le living dex global, sur le stockage interne, toujours en tête. *@

@* Living dex d'un autre joueur (Multijoueurs, /joueurs/{pseudo}/livingdex) : consultation seule, sans création ni noms
   de fichiers. *@
@if (Visitor && player is null)
{
    @if (playerChecked)
    {
        <PlayerHidden />
    }
}
else
{
@if (player is not null)
{
    <PlayerHeader Player="player" Current="PublicPages.LivingDex" />
}
@if (Visitor)
{
    <PageHeader Title="Living dex" Small="true" />
}
else
{
    <PageHeader Title="Living dex" Icon="bi-book-nav-menu">
        <Description>
            Un exemplaire de chaque Pokémon du Pokédex d'un jeu, dans l'équipe et les boîtes d'une de tes sauvegardes stockées : il
            se met à jour avec elle (« Mettre à jour » dans « Mes sauvegardes », ou depuis ta 3DS). Un living dex par jeu ; pour
            l'instant les jeux de 1re à 9e génération (Rouge, Bleu, Jaune, Or, Argent, Cristal, Rubis, Saphir, Émeraude, Rouge Feu,
            Vert Feuille, Diamant, Perle, Platine, Or HeartGold, Argent SoulSilver, Noire, Blanche, Noire 2, Blanche 2, X, Y,
            Rubis Oméga, Saphir Alpha, Soleil, Lune, Ultra-Soleil, Ultra-Lune, Let's Go Pikachu, Let's Go Évoli, Épée, Bouclier,
            Diamant Étincelant, Perle Scintillante, Légendes Arceus, Écarlate, Violet). Le <strong>living dex global</strong>, lui,
            compte les Pokémon de ton stockage interne (« Dépôt / Retrait »), tous jeux confondus, avec un mode de plus : Ultime, chaque
            forme de chaque espèce ; le <strong>global chromatique</strong>, pareil avec tes chromatiques. Chaque jeu (sauf la
            1re génération) peut aussi avoir son <strong>living dex chromatique</strong>, sur une autre sauvegarde : seuls ses
            chromatiques comptent, dans le Pokédex régional pour l'instant.
        </Description>
    </PageHeader>
}

@if (message is not null)
{
    <div class="alert @(messageIsError ? "alert-danger" : "alert-success") alert-dismissible" role="alert">
        @message
        <button type="button" class="btn-close" aria-label="Fermer" @onclick="() => message = null"></button>
    </div>
}

@if (creating && !Visitor)
{
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5">Nouveau living dex</h2>
            @* D'abord le jeu (un living dex par jeu), puis les sauvegardes stockées qui peuvent être une partie de ce jeu
               (Rouge / Bleu : PKHeX ne distingue pas les deux, une sauvegarde Rouge / Bleu va avec l'un comme l'autre). *@
            @* Générations repliées au départ, dépliées une à une par leur titre ; repliée, celle du jeu choisi le montre encore. *@
            @* Normal ou chromatique d'abord : chromatique, le global chromatique et les jeux qui en ont un (pas la 1re génération). *@
            <div class="btn-group btn-group-sm mb-3 livingdex-choice" role="group" aria-label="Type de living dex">
                <button type="button" class="btn @(!shinyKind ? "btn-primary" : "btn-outline-primary")" @onclick="() => KindChosen(false)">Normal</button>
                <button type="button" class="btn @(shinyKind ? "btn-primary" : "btn-outline-primary")" @onclick="() => KindChosen(true)">Chromatique</button>
            </div>
            <div class="form-label">Jeu</div>
            <div class="livingdex-games mb-3">
                @foreach (var info in new[] { shinyKind ? GlobalLivingDex.ShinyGame : GlobalLivingDex.Game })
                {
                    var value = info.Game;
                    var globalTaken = taken.Contains(value);
                    <label class="livingdex-game @(game == value ? "selected" : "") @(globalTaken ? "taken" : "")" title="@(globalTaken ? "Tu as déjà ce living dex" : null)">
                        <input type="radio" class="visually-hidden" name="dexGame" checked="@(game == value)" disabled="@globalTaken" @onchange="() => GameChosen(value)" />
                        <LivingDexCover Game="info" />
                        <span>@info.Name@(globalTaken ? " (déjà créé)" : "")</span>
                    </label>
                }
            </div>
            @foreach (var generation in LivingDexGames.All.Where(g => !shinyKind || LivingDexGames.HasShiny(g))
                          .Select(g => LivingDexGames.Get(g.Game, shinyKind)).GroupBy(g => g.Generation))
            {
            var number = generation.Key;
            var open = openGenerations.Contains(number);
            var shownGames = open ? generation.ToList() : generation.Where(g => g.Game == game).ToList();
            <div class="mb-2">
                <button type="button" class="livingdex-generation-toggle" aria-expanded="@(open ? "true" : "false")"
                        @onclick="() => ToggleGeneration(number)">
                    <span class="chevron" aria-hidden="true">▸</span>@(number == 1 ? "1re" : $"{number}e") génération (@generation.Count() jeux)
                </button>
            </div>
            @if (shownGames.Count > 0)
            {
            <div class="livingdex-games mb-3">
                @foreach (var info in shownGames)
                {
                    var value = info.Game;
                    var isTaken = (shinyKind ? takenShiny : taken).Contains(value);
                    <label class="livingdex-game @(game == value ? "selected" : "") @(isTaken ? "taken" : "")" title="@(isTaken ? "Tu as déjà ce living dex" : null)">
                        <input type="radio" class="visually-hidden" name="dexGame" checked="@(game == value)" disabled="@isTaken" @onchange="() => GameChosen(value)" />
                        <LivingDexCover Game="info" />
                        <span>@info.Name@(isTaken ? " (déjà créé)" : "")</span>
                    </label>
                }
            </div>
            }
            }
            @if (game is { } globalGame && GlobalLivingDex.IsGlobal(globalGame))
            {
                <p class="small text-muted mb-3">
                    Il compte les Pokémon de ton stockage interne (« Dépôt / Retrait »), pas ceux des sauvegardes : pas de sauvegarde à
                    choisir. Modes National, Complet et Ultime (toutes les formes, femelles, Méga, Gigamax...).
                    @(globalGame == LivingDexGame.GlobalShiny
                        ? "Seuls tes chromatiques comptent ; ce qui n'a jamais existé en chromatique n'est pas demandé."
                        : "Les chromatiques n'y comptent pas : ils ont leur living dex global chromatique.")
                </p>
            }
            else if (game is { } chosenGame)
            {
                @if (shinyKind)
                {
                    <p class="small text-muted mb-3">
                        Seuls les chromatiques de la sauvegarde comptent, dans son Pokédex régional (Let's Go : son Pokédex) ; ce qui
                        n'a jamais existé en chromatique n'est pas demandé. Il lui faut sa propre sauvegarde : pas celle d'un autre
                        living dex.
                    </p>
                }
                @if (Saves().Count == 0)
                {
                    <p class="text-muted mb-3">
                        Aucune sauvegarde de @LivingDexGames.Get(chosenGame).Name disponible : stockes-en une dans
                        <a href="sauvegardes">« Mes sauvegardes »</a> (une sauvegarde qui a déjà son living dex ne compte pas).
                    </p>
                }
                else
                {
                    <label class="form-label" for="dexSave">Sauvegarde</label>
                    <select id="dexSave" class="form-select mb-3" value="@saveId" @onchange="SaveChosen">
                        @foreach (var c in Saves())
                        {
                            <option value="@c.SaveId">@c.Label</option>
                        }
                    </select>
                }
            }
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-primary" @onclick="Create"
                        disabled="@(busy || game is not { } g || !GlobalLivingDex.IsGlobal(g) && Saves().All(c => c.SaveId != saveId))">Créer</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="() => creating = false">Annuler</button>
            </div>
        </div>
    </div>
}

@* Juste au-dessus de la liste, à gauche : plus visible. *@
@if (!creating && !Visitor)
{
    <div class="mb-3">
        <button type="button" class="btn btn-primary" @onclick="OpenCreation">+ Créer un living dex</button>
    </div>
}

@if (dexes is null)
{
    <p class="text-muted">Chargement…</p>
}
else if (taken.Count == 0 && takenShiny.Count == 0)
{
    <p class="text-muted">@(Visitor ? $"{player!.Pseudo} n'a pas encore de living dex." : "Tu n'as pas encore de living dex.")</p>
}
else
{
    @* Progression de toutes les cartes dans un mode, gardé dans l'adresse (?mode=regional) ; une carte s'ouvre dans ce mode.
       Filtre Tous / Normaux / Chromatiques (?filtre=chromatiques) et tri à côté, gardés aussi (?tri=completion&ordre=desc) :
       par complétion, dans le mode affiché ; sans tri dans l'adresse, celui du compte (« Mon compte » → « Préférences »). *@
    <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
        <div class="btn-group btn-group-sm livingdex-choice" role="group" aria-label="Living dex affichés">
            @foreach (var (k, label) in Kinds)
            {
                var value = k;
                <button type="button" class="btn @(kind == value ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetKind(value)">
                    @label
                </button>
            }
        </div>
        <div class="btn-group btn-group-sm livingdex-choice" role="group" aria-label="Progression affichée">
            @foreach (var m in AllModes)
            {
                var value = m;
                <button type="button" class="btn @(mode == value ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetMode(value)">
                    @LivingDexGames.ModeName(value)
                </button>
            }
        </div>
        <div class="d-flex align-items-center gap-2 livingdex-choice">
            <label class="small text-nowrap" for="dexSort">Trier par</label>
            <select id="dexSort" class="form-select form-select-sm w-auto" value="@SiteSorts.Slug(sort)" @onchange="SortChosen">
                @foreach (var (_, slug, label) in SiteSorts.LivingDexChoices)
                {
                    <option value="@slug">@label</option>
                }
            </select>
            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ToggleOrder"
                    title="@(descending ? "Décroissant : clique pour trier en croissant" : "Croissant : clique pour trier en décroissant")"
                    aria-label="@(descending ? "Ordre décroissant" : "Ordre croissant")">@(descending ? "↓" : "↑")</button>
        </div>
    </div>
    var shownDexes = dexes.Where(d => LivingDexGames.Matches(d.Game, kind)).ToList();
    @if (shownDexes.Count == 0)
    {
        @* Ultime : seuls les living dex qui ont ce mode sont montrés ; le filtre peut aussi ne rien laisser. *@
        <p class="text-muted">@EmptyMessage</p>
    }
    <div class="livingdex-cards">
        @foreach (var d in LivingDexGames.Sort(shownDexes, sort, descending))
        {
            <a class="livingdex-card" href="@CardLink(d)">
                <LivingDexCover Game="d.Game" Alt="@(GlobalLivingDex.IsGlobal(d.Game.Game) ? d.Game.Name : $"Jaquette de {d.Game.Name}")" />
                <div class="livingdex-card-body">
                    <strong>@d.Game.Name</strong>
                    <div class="small text-muted">@(Visitor ? d.PublicSaveLabel : d.SaveLabel)</div>
                    <LivingDexProgress Owned="d.Owned" Total="d.Total" Class="mt-2" />
                    <div class="small mt-1">
                        @d.Owned / @d.Total
                        @if (d.Mode != mode)
                        {
                            <span class="text-muted ms-1" title="@(d.Game.Shiny ? "Ce living dex chromatique" : "Ce jeu") n'a pas le mode @LivingDexGames.ModeName(mode)">· @LivingDexGames.ModeName(d.Mode) seul</span>
                        }
                    </div>
                </div>
            </a>
        }
    </div>
}
}

@code {
    /// <summary>Titre de l'onglet : la page du compte, ou celle d'un autre joueur.</summary>
    private string PageName
    {
        get
        {
            if (!Visitor)
                return "Living dex";
            return player is null ? "Joueur introuvable" : $"Living dex de {player.Pseudo}";
        }
    }

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    /// <summary>Pseudo d'un autre joueur (adresse /joueurs/{pseudo}/livingdex) : ses living dex, en lecture seule.</summary>
    [Parameter] public string? Pseudo { get; set; }

    private bool Visitor => Pseudo is not null;
    private PlayerProfile? player; // joueur consulté, si ses living dex sont publics
    private bool playerChecked;
    [SupplyParameterFromQuery(Name = "mode")] private string? ModeFromQuery { get; set; }
    [SupplyParameterFromQuery(Name = "tri")] private string? SortFromQuery { get; set; }
    [SupplyParameterFromQuery(Name = "ordre")] private string? OrderFromQuery { get; set; }
    [SupplyParameterFromQuery(Name = "filtre")] private string? KindFromQuery { get; set; }

    private static readonly LivingDexMode[] AllModes = [LivingDexMode.Regional, LivingDexMode.National, LivingDexMode.Complete, LivingDexMode.Ultimate];

    private static readonly (LivingDexKind Kind, string Label)[] Kinds =
        [(LivingDexKind.All, "Tous"), (LivingDexKind.Normal, "Normaux"), (LivingDexKind.Shiny, "Chromatiques")];

    private string userId = "";
    private LivingDexMode mode = LivingDexMode.National;
    private LivingDexKind kind;
    private LivingDexSort sort;
    private bool descending;
    private LivingDexOrder? defaultOrder; // tri par défaut du compte qui regarde (visiteur compris) ; null : pas encore lu
    private readonly HashSet<byte> openGenerations = [];
    private List<LivingDexSummary>? dexes;
    private HashSet<LivingDexGame> taken = []; // jeux qui ont déjà leur living dex normal (globaux compris, même cachés par le mode Ultime)
    private HashSet<LivingDexGame> takenShiny = []; // jeux qui ont déjà leur living dex chromatique
    private List<LivingDexCandidate> candidates = [];
    private bool creating;
    private bool shinyKind; // création d'un living dex chromatique
    private int saveId;
    private LivingDexGame? game;
    private bool busy;
    private string? message;
    private bool messageIsError;

    /// <summary>Sauvegardes qui peuvent recevoir le living dex du jeu choisi.</summary>
    private List<LivingDexCandidate> Saves() => game is { } g ? candidates.Where(c => c.Games.Contains(g)).ToList() : [];

    protected override async Task OnParametersSetAsync()
    {
        // Le tri par défaut est celui du joueur connecté, même chez un autre joueur : sa façon de lire une liste.
        defaultOrder ??= (await Preferences.SortsAsync((await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier))).LivingDex;
        if (Visitor)
        {
            player = await Players.FindAsync((await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier), Pseudo, PublicPages.LivingDex);
            playerChecked = true;
            if (player is null)
                return;
            userId = player.Id;
        }
        else
            userId = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
        mode = LivingDexGames.ModeFromSlug(ModeFromQuery);
        (sort, descending) = SiteSorts.LivingDexFromQuery(new(SortFromQuery, OrderFromQuery)) ?? defaultOrder.Value;
        kind = LivingDexGames.KindFromSlug(KindFromQuery);
        dexes = await Dexes.ListAsync(userId, mode);
        taken = await Dexes.TakenGamesAsync(userId);
        takenShiny = await Dexes.TakenGamesAsync(userId, shiny: true);
    }

    private void SetMode(LivingDexMode value) =>
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("mode", LivingDexGames.ModeSlug(value)), replace: true);

    /// <summary>Filtre Tous / Normaux / Chromatiques, gardé dans l'adresse (« Tous » n'y est pas écrit).</summary>
    private void SetKind(LivingDexKind value) =>
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("filtre", LivingDexGames.KindSlug(value)), replace: true);

    /// <summary>Aucune carte à montrer : mode Ultime sans living dex global, ou filtre qui ne laisse rien.</summary>
    private string EmptyMessage
    {
        get
        {
            var create = Visitor ? "." : " : crée-en un avec « + Créer un living dex ».";
            if (mode == LivingDexMode.Ultimate)
                return kind == LivingDexKind.Shiny ? $"Seul le living dex global chromatique a le mode Ultime{create}" : $"Seuls les living dex globaux ont le mode Ultime{create}";
            return kind == LivingDexKind.Shiny ? $"Aucun living dex chromatique{create}" : $"Aucun living dex normal{create}";
        }
    }

    /// <summary>Critère de tri choisi, gardé dans l'adresse (le sens ne change pas).</summary>
    private void SortChosen(ChangeEventArgs e) =>
        ApplyOrder(new(SiteSorts.LivingDexChoices.FirstOrDefault(c => c.Slug == e.Value?.ToString(), SiteSorts.LivingDexChoices[0]).By, descending));

    /// <summary>Inverse le sens du tri.</summary>
    private void ToggleOrder() => ApplyOrder(new(sort, !descending));

    /// <summary>Tri gardé dans l'adresse : rien pour celui du compte, sinon critère et sens en entier (« ?tri=generation »).</summary>
    private void ApplyOrder(LivingDexOrder order) =>
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(
            SiteSorts.AddressFor(SiteSorts.LivingDexQuery(order), SiteSorts.LivingDexQuery(defaultOrder ?? default))), replace: true);

    /// <summary>Page du living dex, dans le mode de la vue générale s'il le propose (le National n'est pas écrit).</summary>
    private string CardLink(LivingDexSummary d)
    {
        var page = player is null ? $"livingdex/{d.Id}" : PlayerService.Link(player.Pseudo, $"livingdex/{d.Id}");
        return LivingDexGames.ModeSlug(d.Mode) is { } slug ? $"{page}?mode={slug}" : page;
    }

    private void ToggleGeneration(byte generation)
    {
        if (!openGenerations.Remove(generation))
            openGenerations.Add(generation);
    }

    private async Task OpenCreation()
    {
        if (Visitor)
            return;
        message = null;
        shinyKind = false;
        candidates = await Dexes.ListCandidatesAsync(userId);
        game = null;
        saveId = 0;
        openGenerations.Clear(); // toutes repliées au départ
        creating = true;
    }

    /// <summary>Normal ou chromatique : les jeux et les sauvegardes proposés changent, le jeu choisi est oublié.</summary>
    private async Task KindChosen(bool shiny)
    {
        if (shiny == shinyKind)
            return;
        shinyKind = shiny;
        candidates = await Dexes.ListCandidatesAsync(userId, shiny);
        game = null;
        saveId = 0;
    }

    /// <summary>Jeu choisi : la première de ses sauvegardes est proposée d'office.</summary>
    private void GameChosen(LivingDexGame value)
    {
        game = value;
        saveId = Saves().FirstOrDefault()?.SaveId ?? 0;
    }

    private void SaveChosen(ChangeEventArgs e) => saveId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;

    private async Task Create()
    {
        if (Visitor || game is not { } chosenGame)
            return;
        busy = true;
        var result = GlobalLivingDex.IsGlobal(chosenGame) ? await Dexes.CreateGlobalAsync(userId, chosenGame == LivingDexGame.GlobalShiny)
            : await Dexes.CreateAsync(userId, saveId, chosenGame, shinyKind);
        busy = false;
        if (result.Ok)
        {
            Navigation.NavigateTo($"livingdex/{result.Id}");
            return;
        }
        message = result.Message;
        messageIsError = true;
    }
}
