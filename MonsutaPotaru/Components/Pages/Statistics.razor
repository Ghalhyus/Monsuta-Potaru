@page "/statistiques"
@page "/joueurs/{Pseudo}/statistiques"
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using MonsutaPotaru.Components.Shared
@using MonsutaPotaru.Data
@using MonsutaPotaru.Services
@inject StatisticsService Stats
@inject TradeService Trades
@inject BattleService Battles
@inject MiniGameService MiniGameStore
@inject PlayerService Players
@inject NavigationManager Navigation

<PageTitle>@(player is null ? "Statistiques" : $"Statistiques de {player.Pseudo}")</PageTitle>

@* Statistiques du joueur (menu de son pseudo), base des futurs succès : onglets à gauche (en ligne au-dessus sur un
   écran étroit), « ?onglet=defis » dans l'adresse. Chaque onglet calcule ses chiffres quand on l'ouvre (StatisticsService,
   sans cache), gardés pour la visite. Aussi sur le profil d'un autre joueur (/joueurs/{pseudo}/statistiques), si sa
   « Visibilité » le permet : les mêmes chiffres, sans les liens vers ses pages. *@
@if (Visitor && player is null)
{
    @if (playerChecked)
    {
        <PlayerHidden />
    }
}
else
{
    @if (player is not null)
    {
        <PlayerHeader Player="player" Current="PublicPages.Statistics" />
        <PageHeader Title="Statistiques" Small="true" />
    }
    else
    {
        <PageHeader Title="Statistiques" Icon="bi-grid-nav-menu">
            <Help>Ton argent, tes living dex, tes rubans, tes complétions, tes échanges, tes combats et tes parties de mini-jeux.</Help>
        </PageHeader>
    }

    <div class="row">
        <div class="col-lg-3 col-xxl-2">
            <ul class="nav nav-pills flex-lg-column mb-3 stats-tabs" aria-label="Statistiques">
                @foreach (var (value, title) in Tabs)
                {
                    <li class="nav-item">
                        <a class="nav-link @(tab == value ? "active" : "")" aria-current="@(tab == value ? "page" : null)"
                           href="@TabHref(value)">@title</a>
                    </li>
                }
            </ul>
        </div>
        <div class="col-lg-9 col-xxl-10">
            @switch (tab)
            {
                case StatsTab.General:
                    <Block Title="Argent">
                        @if (money is null)
                        {
                            <p class="text-muted">Chargement…</p>
                        }
                        else
                        {
                            <div class="stat-tiles">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="small text-muted">Argent déposé</div>
                                        <div class="stat-value">@InventoryService.FormatMoney(money.Deposited)</div>
                                    </div>
                                </div>
                                <div class="card">
                                    <div class="card-body">
                                        <div class="small text-muted">Argent dépensé</div>
                                        <div class="stat-value">@InventoryService.FormatMoney(money.Spent)</div>
                                    </div>
                                </div>
                            </div>
                            <p class="text-muted small mt-3 mb-0">
                                Argent déposé : @(Visitor ? "son" : "ton") porte-monnaie (@InventoryService.FormatMoney(money.Balance)) et ce
                                qui a été dépensé sur le site. Argent dépensé : emplacements de stockage, parcs et agrandissements.
                            </p>
                        }
                    </Block>
                    break;

                case StatsTab.Challenges:
                    @if (livingDex is not { } dex)
                    {
                        <Block Title="Living dex">
                            <p class="text-muted">Chargement…</p>
                        </Block>
                    }
                    else
                    {
                        <LivingDexStatsBlock Title="Living dex" Stats="dex.Normal" Visitor="Visitor" />
                        <LivingDexStatsBlock Title="Living dex chromatiques" Stats="dex.Shiny" Visitor="Visitor" Shiny="true" />
                    }
                    @if (ribbons is null)
                    {
                        <Block Title="Rubans">
                            <p class="text-muted">Chargement…</p>
                        </Block>
                    }
                    else
                    {
                        <RibbonStatsBlock Stats="ribbons" Visitor="Visitor" />
                    }
                    @if (completions is null)
                    {
                        <Block Title="Complétion (100 %)">
                            <p class="text-muted">Chargement…</p>
                        </Block>
                    }
                    else
                    {
                        <CompletionStatsBlock Stats="completions" Visitor="Visitor" />
                    }
                    break;

                case StatsTab.MiniGames:
                    @if (miniGames is not { } games)
                    {
                        <Block Title="Générale">
                            <p class="text-muted">Chargement…</p>
                        </Block>
                    }
                    else
                    {
                        @* Tous les mini-jeux, puis un bloc par mini-jeu, en groupes : parties, puis ce qui est propre au jeu
                           (pièces et équipe favorite aux échecs, Pokémon trouvés au cache-cache) *@
                        <Block Title="Générale">
                            <h3 class="stat-group-title">Parties</h3>
                            <div class="stat-tiles">
                                @GameTiles(games.General, "Joueurs différents")
                            </div>
                            <h3 class="stat-group-title">Favori</h3>
                            <div class="stat-tiles">
                                @Tile("Mini-jeu le plus joué", games.General.Favorite ?? "—", games.General.Favorite is null ? null : Games(games.General.FavoriteGames))
                            </div>
                            @if (games.General.Total == 0 && !Visitor)
                            {
                                <p class="text-muted small mt-3 mb-0">Aucune partie pour l'instant : essaie les <a href="mini-jeux/echecs">Échecs</a> ou le <a href="mini-jeux/cache-cache">Cache-cache</a>.</p>
                            }
                        </Block>

                        <Block Title="Échecs">
                            @if (games.Chess.Games.Total == 0 && !Visitor)
                            {
                                <p class="text-muted small">Aucune partie pour l'instant : invite un ami, ou crée une partie publique, dans <a href="mini-jeux/echecs">Échecs</a>.</p>
                            }
                            <h3 class="stat-group-title">Parties</h3>
                            <div class="stat-tiles">
                                @GameTiles(games.Chess.Games, "Adversaires différents")
                            </div>
                            <p class="text-muted small mt-2 mb-0">Les invités sans compte des parties publiques ne comptent pas dans les adversaires différents.</p>

                            <h3 class="stat-group-title">Pièces</h3>
                            <div class="stat-tiles">
                                @Tile("Prises", games.Chess.PiecesTaken.ToString())
                                @Tile("Perdues", games.Chess.PiecesLost.ToString())
                            </div>
                            <p class="text-muted small mt-2 mb-0">
                                Prises : les Pokémon adverses mangés par @(Visitor ? "ses" : "tes") pièces ; perdues : les @(Visitor ? "siens" : "tiens")
                                mangés. L'échange d'un pion au bout du plateau n'en est pas une.
                            </p>

                            <h3 class="stat-group-title">Équipe favorite</h3>
                            @if (games.Chess.FavoriteTeam is { } team)
                            {
                                @* Une seule carte : l'équipe la plus jouée, puis le détail de ses Pokémon (comme au choix des équipes) *@
                                <div class="card stat-team">
                                    <div class="card-body">
                                        <div class="stat-value">@team.ShortName</div>
                                        <div class="small text-muted stat-note">@Games(games.Chess.FavoriteTeamGames)</div>
                                        <ChessTeamList Team="team" />
                                    </div>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted mb-0">—</p>
                            }
                        </Block>

                        <Block Title="Cache-cache" Class="stat-hide-seek">
                            @if (games.HideSeek.Games.Total == 0 && !Visitor)
                            {
                                <p class="text-muted small">Aucune partie pour l'instant : crée une partie dans <a href="mini-jeux/cache-cache">Cache-cache</a>.</p>
                            }
                            <h3 class="stat-group-title">Parties</h3>
                            <div class="stat-tiles">
                                @GameTiles(games.HideSeek.Games, "Adversaires différents")
                            </div>
                            <p class="text-muted small mt-2 mb-0">
                                Gagnée : le plus de Pokémon trouvés ; nulle : à égalité en tête. Les invités sans compte ne comptent pas
                                dans les adversaires différents.
                            </p>

                            <h3 class="stat-group-title">Recherche</h3>
                            <div class="stat-tiles">
                                @Tile("Pokémon trouvés", games.HideSeek.Found.ToString())
                            </div>
                        </Block>
                    }
                    break;

                default:
                    <Block Title="Échange">
                        @if (trades is null)
                        {
                            <p class="text-muted">Chargement…</p>
                        }
                        else
                        {
                            <div class="stat-tiles">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="small text-muted">Échanges réussis</div>
                                        <div class="stat-value">@trades.Total</div>
                                    </div>
                                </div>
                                <div class="card">
                                    <div class="card-body">
                                        <div class="small text-muted">Partenaires différents</div>
                                        <div class="stat-value">@trades.Partners</div>
                                    </div>
                                </div>
                            </div>
                            @if (trades.Total == 0 && !Visitor)
                            {
                                <p class="text-muted small mt-3 mb-0">Aucun échange pour l'instant : propose-en un à un ami dans <a href="echanges">Échange</a>, ou passe par la <a href="gts">GTS</a>.</p>
                            }
                        }
                    </Block>

                    <Block Title="Combat">
                        @if (battles is null)
                        {
                            <p class="text-muted">Chargement…</p>
                        }
                        else
                        {
                            <div class="stat-tiles">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="small text-muted">Victoires</div>
                                        <div class="stat-value">@battles.Won</div>
                                    </div>
                                </div>
                                <div class="card">
                                    <div class="card-body">
                                        <div class="small text-muted">Défaites</div>
                                        <div class="stat-value">@battles.Lost</div>
                                    </div>
                                </div>
                                <div class="card">
                                    <div class="card-body">
                                        <div class="small text-muted">Matchs nuls</div>
                                        <div class="stat-value">@battles.Draws</div>
                                    </div>
                                </div>
                                <div class="card">
                                    <div class="card-body">
                                        <div class="small text-muted">Adversaires différents</div>
                                        <div class="stat-value">@battles.Opponents</div>
                                    </div>
                                </div>
                            </div>
                            @if (battles.Total == 0 && !Visitor)
                            {
                                <p class="text-muted small mt-3 mb-0">Aucun combat pour l'instant : défie un ami dans <a href="combats">Combat</a>.</p>
                            }
                        }
                    </Block>
                    break;
            }
        </div>
    </div>
}

@code {
    /// <summary>Onglets de la page, dans l'ordre affiché.</summary>
    public enum StatsTab { General, Challenges, Multiplayer, MiniGames }

    /// <summary>Onglet et son titre ; le nom dans l'adresse vient de <see cref="TabSlug"/>.</summary>
    private static readonly (StatsTab Tab, string Title)[] Tabs =
        [(StatsTab.General, "Générale"), (StatsTab.Challenges, "Défis"), (StatsTab.Multiplayer, "Multijoueurs"),
            (StatsTab.MiniGames, "Mini-jeux")];

    /// <summary>Nom de l'onglet dans l'adresse (« ?onglet=defis ») ; rien pour « Générale », l'onglet par défaut.</summary>
    public static string? TabSlug(StatsTab tab) => tab switch
    {
        StatsTab.Challenges => "defis",
        StatsTab.Multiplayer => "multijoueurs",
        StatsTab.MiniGames => "mini-jeux",
        _ => null,
    };

    /// <summary>Onglet d'après l'adresse : « Générale » pour un nom inconnu.</summary>
    public static StatsTab TabFromSlug(string? slug) => slug?.ToLowerInvariant() switch
    {
        "defis" => StatsTab.Challenges,
        "multijoueurs" => StatsTab.Multiplayer,
        "mini-jeux" => StatsTab.MiniGames,
        _ => StatsTab.General,
    };

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    /// <summary>Pseudo d'un autre joueur (Multijoueurs) : ses statistiques, si sa visibilité le permet.</summary>
    [Parameter] public string? Pseudo { get; set; }

    [SupplyParameterFromQuery(Name = "onglet")] private string? TabFromQuery { get; set; }

    private bool Visitor => Pseudo is not null;
    private PlayerProfile? player;
    private bool playerChecked;
    private string? userId;
    private StatsTab tab;

    // Chiffres de chaque onglet, calculés à sa première ouverture et gardés pour la visite.
    private MoneyStats? money;
    private (LivingDexStats Normal, LivingDexStats Shiny)? livingDex;
    private RibbonStats? ribbons;
    private CompletionStats? completions;
    private TradeStats? trades;
    private BattleRecordStats? battles;
    private MiniGameOverview? miniGames;

    protected override async Task OnParametersSetAsync()
    {
        tab = TabFromSlug(TabFromQuery);
        var viewerId = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier);
        string? shown;
        if (Visitor)
        {
            player = await Players.FindAsync(viewerId, Pseudo, PublicPages.Statistics);
            playerChecked = true;
            shown = player?.Id;
        }
        else
        {
            player = null;
            shown = viewerId ?? "";
        }
        if (shown is null)
            return;
        if (shown != userId)
        {
            // Autre joueur (lien d'un profil à l'autre) : on recompte tout.
            userId = shown;
            money = null;
            livingDex = null;
            ribbons = null;
            completions = null;
            trades = null;
            battles = null;
            miniGames = null;
        }
        switch (tab)
        {
            case StatsTab.General:
                money ??= await Stats.MoneyAsync(userId);
                break;
            case StatsTab.Challenges:
                livingDex ??= await Stats.LivingDexAsync(userId);
                ribbons ??= await Stats.RibbonsAsync(userId);
                completions ??= await Stats.CompletionsAsync(userId);
                break;
            case StatsTab.MiniGames:
                miniGames ??= await MiniGameStore.StatsAsync(userId);
                break;
            default:
                trades ??= await Trades.StatsAsync(userId);
                battles ??= await Battles.StatsAsync(userId);
                break;
        }
    }

    /// <summary>Une tuile : intitulé, valeur, et une précision dessous (« 12 parties »).</summary>
    private static RenderFragment Tile(string label, string value, string? note = null) => __builder =>
    {
        <div class="card">
            <div class="card-body">
                <div class="small text-muted">@label</div>
                <div class="stat-value">@value</div>
                @if (note is not null)
                {
                    <div class="small text-muted stat-note">@note</div>
                }
            </div>
        </div>
    };

    /// <summary>Groupe « Parties » des blocs de l'onglet Mini-jeux : jouées, gagnées, perdues, nulles, adversaires.</summary>
    private static RenderFragment GameTiles(MiniGameStats stats, string opponents) => __builder =>
    {
        @Tile("Jouées", stats.Total.ToString())
        @Tile("Gagnées", stats.Won.ToString())
        @Tile("Perdues", stats.Lost.ToString())
        @Tile("Nulles", stats.Draws.ToString())
        @Tile(opponents, stats.Players.ToString())
    };

    /// <summary>« 1 partie », « 12 parties ».</summary>
    private static string Games(int count) => count == 1 ? "1 partie" : $"{count} parties";

    private string TabHref(StatsTab value) => Navigation.GetUriWithQueryParameter("onglet", TabSlug(value));
}
