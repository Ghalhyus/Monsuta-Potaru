@page "/completion"
@page "/joueurs/{Pseudo}/completion"
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using MonsutaPotaru.Components.Shared
@using MonsutaPotaru.Data
@using MonsutaPotaru.Services
@inject CompletionService Completions
@inject NavigationManager Navigation
@inject PlayerService Players

<PageTitle>@PageName</PageTitle>

@* Complétions du compte : une carte par partie suivie (jaquette, sauvegarde, progression globale et par section), et la
   création d'une nouvelle sur une sauvegarde stockée (1re à 7e génération pour l'instant). *@

@* Complétions d'un autre joueur (Multijoueurs, /joueurs/{pseudo}/completion) : consultation seule, sans création ni noms
   de fichiers. *@
@if (Visitor && player is null)
{
    @if (playerChecked)
    {
        <PlayerHidden />
    }
}
else
{
@if (player is not null)
{
    <PlayerHeader Player="player" Current="PublicPages.Completion" />
}
@if (Visitor)
{
    <PageHeader Title="Complétion" Small="true" />
}
else
{
    <PageHeader Title="Complétion (100 %)" Icon="bi-check2-circle-nav-menu">
        <Help>
            <p>Suis une de tes parties jusqu'au 100 % : elle se met à jour avec sa sauvegarde stockée.</p>
            <ul>
                <li>Sections : <strong>histoire, Pokédex, dresseurs, objets, rencontres uniques</strong> (et quêtes annexes à partir de la 2e génération).</li>
                <li>Chaque section compte <strong>autant</strong> dans le total, même si elle est plus longue.</li>
                <li>Pour l'instant : de Rouge / Bleu à Let's Go, Pikachu / Évoli (1re à 7e génération ; pas encore de dresseurs en 6e et 7e génération).</li>
            </ul>
        </Help>
    </PageHeader>
}

@if (message is not null)
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        @message
        <button type="button" class="btn-close" aria-label="Fermer" @onclick="() => message = null"></button>
    </div>
}

@if (creating && !Visitor)
{
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5">Nouvelle complétion</h2>
            @* D'abord le jeu (une complétion par jeu), puis les sauvegardes stockées qui peuvent être une partie de ce jeu
               (Rouge / Bleu, Or / Argent : PKHeX ne distingue pas les deux, une telle sauvegarde va avec l'un comme l'autre). *@
            <div class="form-label">Jeu</div>
            <div class="livingdex-games mb-3">
                @foreach (var info in CompletionGames.All.Select(LivingDexGames.Get))
                {
                    var value = info.Game;
                    var isTaken = taken.Contains(value);
                    <label class="livingdex-game @(game == value ? "selected" : "") @(isTaken ? "taken" : "")" title="@(isTaken ? "Tu as déjà cette complétion" : null)">
                        <input type="radio" class="visually-hidden" name="completionGame" checked="@(game == value)" disabled="@isTaken" @onchange="() => GameChosen(value)" />
                        <LivingDexCover Game="info" />
                        <span>@info.Name@(isTaken ? " (déjà créée)" : "")</span>
                    </label>
                }
            </div>
            @if (game is { } chosenGame)
            {
                @if (Saves().Count == 0)
                {
                    <p class="text-muted mb-3">
                        Aucune sauvegarde de @LivingDexGames.Get(chosenGame).Name disponible : stockes-en une dans
                        <a href="sauvegardes">« Mes sauvegardes »</a> (une sauvegarde qui a déjà sa complétion ne compte pas ;
                        les sauvegardes japonaises et coréennes ne sont pas encore prises en charge).
                    </p>
                }
                else
                {
                    <label class="form-label" for="completionSave">Sauvegarde</label>
                    <select id="completionSave" class="form-select mb-3" value="@saveId" @onchange="SaveChosen">
                        @foreach (var c in Saves())
                        {
                            <option value="@c.SaveId">@c.Label</option>
                        }
                    </select>
                }
            }
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-primary" @onclick="Create"
                        disabled="@(busy || game is null || Saves().All(c => c.SaveId != saveId))">Créer</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="() => creating = false">Annuler</button>
            </div>
        </div>
    </div>
}

@* Juste au-dessus de la liste, à gauche : plus visible. *@
@if (!creating && !Visitor)
{
    <div class="mb-3">
        <button type="button" class="btn btn-primary" @onclick="OpenCreation">+ Ajouter une sauvegarde</button>
    </div>
}

@if (completions is null)
{
    <p class="text-muted">Chargement…</p>
}
else if (completions.Count == 0)
{
    <p class="text-muted">@(Visitor ? $"{player!.Pseudo} n'a aucune sauvegarde de suivie." : "Tu n'as aucune sauvegarde de suivie.")</p>
}
else
{
    <div class="livingdex-cards">
        @foreach (var c in completions)
        {
            <a class="livingdex-card" href="@CardLink(c)">
                <LivingDexCover Game="c.Game" Alt="@($"Jaquette de {c.Game.Name}")" />
                <div class="livingdex-card-body">
                    <strong>@c.Game.Name</strong>
                    <div class="small text-muted">@(Visitor ? c.PublicSaveLabel : c.SaveLabel)</div>
                    <LivingDexProgress Owned="c.Progress.Tenths" Total="1000" Class="mt-2"
                                       ValueText="@($"{c.Progress.Percent}, moyenne des sections")" />
                    <div class="small mt-1 completion-card-sections">
                        @foreach (var s in c.Progress.Sections)
                        {
                            <span title="@s.Done / @s.Total">@s.Name @LivingDexGames.Percent(s.Done, s.Total)</span>
                        }
                    </div>
                </div>
            </a>
        }
    </div>
}
}

@code {
    /// <summary>Titre de l'onglet : la page du compte, ou celle d'un autre joueur.</summary>
    private string PageName
    {
        get
        {
            if (!Visitor)
                return "Complétion";
            return player is null ? "Joueur introuvable" : $"Complétion de {player.Pseudo}";
        }
    }

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    /// <summary>Pseudo d'un autre joueur (adresse /joueurs/{pseudo}/completion) : ses complétions, en lecture seule.</summary>
    [Parameter] public string? Pseudo { get; set; }

    private bool Visitor => Pseudo is not null;
    private PlayerProfile? player; // joueur consulté, si ses complétions sont publiques
    private bool playerChecked;
    private string userId = "";
    private List<CompletionSummary>? completions;
    private HashSet<LivingDexGame> taken = [];
    private List<CompletionCandidate> candidates = [];
    private bool creating;
    private int saveId;
    private LivingDexGame? game;
    private bool busy;
    private string? message;

    /// <summary>Sauvegardes qui peuvent recevoir la complétion du jeu choisi.</summary>
    private List<CompletionCandidate> Saves() => game is { } g ? candidates.Where(c => c.Games.Contains(g)).ToList() : [];

    protected override async Task OnParametersSetAsync()
    {
        if (Visitor)
        {
            player = await Players.FindAsync((await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier), Pseudo, PublicPages.Completion);
            playerChecked = true;
            if (player is null)
                return;
            userId = player.Id;
        }
        else
            userId = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
        completions = await Completions.ListAsync(userId);
        taken = await Completions.TakenGamesAsync(userId);
    }

    private string CardLink(CompletionSummary c) =>
        player is null ? $"completion/{c.Id}" : PlayerService.Link(player.Pseudo, $"completion/{c.Id}");

    private async Task OpenCreation()
    {
        if (Visitor)
            return;
        message = null;
        candidates = await Completions.ListCandidatesAsync(userId);
        game = null;
        saveId = 0;
        creating = true;
    }

    /// <summary>Jeu choisi : la première de ses sauvegardes est proposée d'office.</summary>
    private void GameChosen(LivingDexGame value)
    {
        game = value;
        saveId = Saves().FirstOrDefault()?.SaveId ?? 0;
    }

    private void SaveChosen(ChangeEventArgs e) => saveId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;

    private async Task Create()
    {
        if (Visitor || game is not { } chosenGame)
            return;
        busy = true;
        var result = await Completions.CreateAsync(userId, saveId, chosenGame);
        busy = false;
        if (result.Ok)
        {
            Navigation.NavigateTo($"completion/{result.Id}");
            return;
        }
        message = result.Message;
    }
}
