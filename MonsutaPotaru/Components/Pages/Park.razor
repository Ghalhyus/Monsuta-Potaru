@page "/parc"
@page "/joueurs/{Pseudo}/parc"
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using MonsutaPotaru.Components.Shared
@using MonsutaPotaru.Data
@using MonsutaPotaru.Services
@inject ParkService Parks
@inject InventoryService InventoryStore
@inject WalletState Wallet
@inject BankService BankStore
@inject PokemonInfo Info
@inject IJSRuntime JS
@inject PlayerService Players
@inject DebugService Debug

<PageTitle>@PageName</PageTitle>

@* De 20 à 80 Pokémon de la collection (selon les agrandissements achetés) se promènent sur une carte faite dans Tiled
   (wwwroot/parc/{carte}-{taille}.json, outils/generer-parc.py, generer-plage.py et carte-parc.py) : l'affichage (Phaser)
   et leur comportement sont dans wwwroot/js/parc.js, la page ne gère que la liste, les achats et les fenêtres. Un parc par
   paysage (la Forêt, puis ceux achetés), choisi dans la liste déroulante.
   Parc d'un autre joueur (Multijoueurs, /joueurs/{pseudo}/parc) : on le regarde, sans choisir ni retirer de Pokémon. *@

@if (Visitor && player is null)
{
    @if (playerChecked)
    {
        <PlayerHidden />
    }
}
else
{
@if (player is not null)
{
    <PlayerHeader Player="player" Current="PublicPages.Park" />
}
<PageHeader Title="Parc" Count="@($"{members.Count} / {Capacity}")" Small="Visitor" Icon="@(Visitor ? null : "bi-tree-nav-menu")">
    <Description>
        @(Visitor ? $"Les Pokémon de {player!.Pseudo} vivent ici" : "Tes Pokémon vivent ici") : ils se promènent, se reposent,
        rendent visite à leur famille et dorment quand ils sont fatigués (plus tôt le soir). Clique sur l'un d'eux pour voir sa fiche,
        fais glisser la carte pour explorer les alentours.
    </Description>
    <Actions>
        @if (parks.Count > 1)
        {
            <select class="form-select w-auto park-choice" aria-label="Parc affiché" value="@ParkId" @onchange="ChangePark" disabled="@busy">
                @foreach (var p in parks)
                {
                    <option value="@p.Id">@p.Name (@p.Count / @p.Capacity)</option>
                }
            </select>
        }
        @if (!Visitor)
        {
            <button type="button" class="btn btn-outline-danger" @onclick="() => confirmClear = true"
                    disabled="@(busy || members.Count == 0)">Vider le parc</button>
            <button type="button" class="btn btn-primary" @onclick="OpenChooser">Choisir les Pokémon</button>
            @if (expansions < ParkService.MaxExpansions)
            {
                <button type="button" class="btn btn-outline-success" @onclick="OpenExpand" disabled="@busy">Agrandir le parc</button>
            }
            @if (Purchasable.Count > 0)
            {
                <button type="button" class="btn btn-outline-success" @onclick="OpenBuy" disabled="@busy">Acheter un parc</button>
            }
            @if (debug)
            {
                @* Mode debug (page « Administration ») : gratuit, revérifié par DebugService *@
                <button type="button" class="btn btn-outline-warning" @onclick="() => Resize(true)"
                        disabled="@(busy || expansions >= ParkService.MaxExpansions)">+ taille (debug)</button>
                <button type="button" class="btn btn-outline-warning" @onclick="() => Resize(false)"
                        disabled="@(busy || expansions <= 0)">− taille (debug)</button>
                <button type="button" class="btn @(showHabitats ? "btn-warning" : "btn-outline-warning")"
                        @onclick="ToggleHabitats" aria-pressed="@(showHabitats ? "true" : "false")">Habitats (debug)</button>
            }
        }
    </Actions>
</PageHeader>

@* data-hors-mesure : parc.js ne compte pas ce message dans la hauteur du parc (sinon, affiché au redémarrage après un
   agrandissement ou un achat, il rétrécirait la carte jusqu'à l'actualisation de la page). *@
@if (message is not null)
{
    <div class="alert @(messageIsError ? "alert-danger" : "alert-success") alert-dismissible" role="alert" data-hors-mesure>
        @message
        <button type="button" class="btn-close" aria-label="Fermer" @onclick="() => message = null"></button>
    </div>
}

<div class="park" @ref="parkBlock">
    <div class="park-stage" @ref="stage"></div>
    @if (loaded && members.Count == 0)
    {
        <div class="park-empty">
            <p>Le parc est vide.</p>
            @if (!Visitor)
            {
                <button type="button" class="btn btn-light" @onclick="OpenChooser">Choisir des Pokémon</button>
            }
        </div>
    }
    @* ---------- Fiche du Pokémon cliqué : dans le bloc du parc, pour rester visible en plein écran ---------- *@
    @if (selected is not null && selectedView is not null)
    {
        <div class="collection-backdrop" @onclick="CloseDetail"></div>
        <div class="collection-dialog" role="dialog" aria-modal="true" aria-label="@selectedView.Nickname">
            <PokemonCard Pokemon="@selectedView" HideTrainerId="Visitor" Portrait="@selectedPortrait"
                         PortraitTitle="@selectedMood?.Message">
                <Summary>
                    @if (selectedMood is not null)
                    {
                        <div class="small mt-1 park-mood park-mood-@selectedMood.Mood.ToString().ToLowerInvariant()">@selectedMood.Message</div>
                    }
                </Summary>
                <ChildContent>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    @if (!Visitor)
                    {
                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="RemoveSelected" disabled="@busy">Retirer du parc</button>
                    }
                    @if (debug && !Visitor)
                    {
                        @* Mode debug : il attaque le Pokémon le plus proche, quel que soit son bonheur (parc.js) *@
                        <button type="button" class="btn btn-outline-warning btn-sm" @onclick="AttackSelected">Attaquer (debug)</button>
                    }
                    <button type="button" class="btn btn-secondary btn-sm ms-auto" @onclick="CloseDetail">Fermer</button>
                </div>
                </ChildContent>
            </PokemonCard>
        </div>
    }
</div>
@if (showHabitats && current is not null && ParkHabitats.Map(current.Landscape, expansions + 1) is { } habitatMap)
{
    @* Mode debug : légende des couleurs des cases, et leur nombre dans la zone du parc (ParkHabitats, côté serveur) *@
    <div class="park-habitats small mt-2">
        @foreach (var habitat in ParkHabitats.All.Prepend(Habitat.None))
        {
            <span class="park-habitat">
                <span class="park-habitat-color" style="background: @ParkHabitats.Color(habitat)"></span>
                @ParkHabitats.Name(habitat) : @habitatMap.Counts[habitat]
            </span>
        }
    </div>
}

@* ---------- Choix des Pokémon du parc ---------- *@
@if (candidates is not null)
{
    var shown = candidates.Where(Matches).ToList();
    <div class="dialog-backdrop" @onclick="CloseChooser"></div>
    <div class="dialog-panel card" role="dialog" aria-modal="true" aria-label="Pokémon du parc">
        <div class="card-body">
            <h5>Pokémon du parc@(parks.Count > 1 ? $" « {current?.Name} »" : "") <small class="text-muted">· @chosen.Count / @Capacity</small></h5>
            <p class="small text-muted">
                Tes Pokémon du stockage interne et de tes sauvegardes stockées (💾) : clique pour en ajouter ou en retirer.
                Ceux dont les sprites n'existent pas encore (🔒) ne peuvent pas venir.
                @if (parks.Count > 1)
                {
                    @($"Ceux d'un autre parc ({string.Join(", ", parks.Where(p => p.Id != ParkId).Select(p => $"{ParkLandscapes.Icon(p.Landscape)} {ParkLandscapes.Where(p.Landscape)}"))}) le quittent pour venir ici.")
                }
                @if (current is not null && ParkLandscapes.ChooserNote(current.Landscape) is { } note)
                {
                    @(" " + note)
                }
            </p>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <input type="search" class="form-control form-control-sm flex-grow-1 w-auto" placeholder="Rechercher (espèce ou surnom)…"
                       aria-label="Rechercher un Pokémon" @bind="search" @bind:event="oninput" />
                <select class="form-select form-select-sm w-auto park-shown" aria-label="Pokémon affichés" @bind="shownFilter">
                    <option value="@ShownFilter.All">Tous les Pokémon</option>
                    <option value="@ShownFilter.ThisPark">Ceux de ce parc</option>
                    <option value="@ShownFilter.NoPark">Dans aucun parc</option>
                </select>
            </div>
            <div class="mb-2">
                <CollectionFilterChips Value="criteria" ValueChanged="CriteriaChanged" Abilities="abilities" />
            </div>
            @if (candidates.Count == 0)
            {
                <p class="text-muted small">@(criteria.IsEmpty ? "Ta collection n'a pas encore de Pokémon." : "Aucun Pokémon ne correspond aux filtres.")</p>
            }
            else if (shown.Count == 0)
            {
                <p class="text-muted small">@(EmptyMessage())</p>
            }
            else
            {
                <div class="park-candidates">
                    @foreach (var candidate in shown)
                    {
                        var c = candidate;
                        <PokemonSlot Sprite="@c.SpriteUrl"
                                     Title="@($"{c.Nickname} ({c.SpeciesName}) N.{c.Level}{(c.StoredSaveId is null ? "" : " — sauvegarde stockée")}{(c.OtherPark is { } other ? $" — vit {ParkLandscapes.Where(other)}" : "")}{(c.HasSprites ? "" : " — pas encore de sprite")}{(c.Refusal is { } refusal ? $" — {refusal.ToLowerInvariant()}" : "")}")"
                                     Level="c.Level"
                                     Shiny="c.IsShiny"
                                     Marker="@Marker(c)"
                                     Locked="@(!c.HasSprites || c.Refusal is not null)"
                                     Selected="@chosen.Contains(c.Id)"
                                     OnClick="() => Toggle(c)" />
                    }
                </div>
            }
            @if (chooserMessage is not null)
            {
                <p class="small text-danger mt-2 mb-0">@chooserMessage</p>
            }
            <div class="d-flex justify-content-end gap-2 mt-3">
                <button type="button" class="btn btn-outline-danger me-auto" @onclick="UnselectAll" disabled="@(chosen.Count == 0)"
                        title="Décoche tous les Pokémon (rien ne change avant « Valider »)">Tout retirer</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="CloseChooser">Annuler</button>
                <button type="button" class="btn btn-primary" @onclick="SaveChoice" disabled="@busy">Valider</button>
            </div>
        </div>
    </div>
}

@* ---------- Confirmation de « Vider le parc » ---------- *@
@if (confirmClear && !Visitor)
{
    <div class="dialog-backdrop" @onclick="() => confirmClear = false"></div>
    <div class="dialog-panel card" role="dialog" aria-modal="true" aria-label="Vider le parc">
        <div class="card-body">
            <h5>Vider le parc ?</h5>
            <p class="mb-0">
                @(members.Count == 1 ? "Le Pokémon du parc le quitte" : $"Les {members.Count} Pokémon du parc le quittent") :
                @(members.Count == 1 ? "il reste" : "ils restent") dans ta collection, et tu pourras en choisir d'autres.
            </p>
            <div class="d-flex justify-content-end gap-2 mt-3">
                <button type="button" class="btn btn-outline-secondary" @onclick="() => confirmClear = false">Annuler</button>
                <button type="button" class="btn btn-danger" @onclick="ClearPark" disabled="@busy">Vider le parc</button>
            </div>
        </div>
    </div>
}

@* ---------- Agrandissement du parc ---------- *@
@if (expandBalance is { } balance && !Visitor)
{
    var enough = balance >= ParkService.ExpansionPrice;
    <div class="dialog-backdrop" @onclick="() => expandBalance = null"></div>
    <div class="dialog-panel card" role="dialog" aria-modal="true" aria-label="Agrandir le parc">
        <div class="card-body">
            <h5>Agrandir le parc ?</h5>
            <p>
                @ParkLandscapes.Expansion(current?.Landscape ?? ParkLandscape.Forest) : il accueille alors
                <strong>@ParkService.CapacityOf(expansions + 1) Pokémon</strong> au lieu de @Capacity
                (agrandissement @(expansions + 1) sur @ParkService.MaxExpansions).
            </p>
            <p class="mb-0">
                Prix : <strong>@InventoryService.FormatMoney(ParkService.ExpansionPrice)</strong>, payé avec ton porte-monnaie
                (@InventoryService.FormatMoney(balance)).
                @if (!enough)
                {
                    <span class="text-danger">
                        Il manque @InventoryService.FormatMoney(ParkService.ExpansionPrice - balance) : retire de l'argent d'une
                        sauvegarde depuis <a href="inventaire">« Banque d'objets »</a>.
                    </span>
                }
            </p>
            <div class="d-flex justify-content-end gap-2 mt-3">
                <button type="button" class="btn btn-outline-secondary" @onclick="() => expandBalance = null">Annuler</button>
                <button type="button" class="btn btn-success" @onclick="Expand" disabled="@(busy || !enough)">
                    Payer @InventoryService.FormatMoney(ParkService.ExpansionPrice)
                </button>
            </div>
        </div>
    </div>
}

@* ---------- Achat d'un nouveau parc (un paysage pas encore acheté) ---------- *@
@if (buyBalance is { } wallet && !Visitor)
{
    var canPay = wallet >= ParkService.ParkPrice;
    <div class="dialog-backdrop" @onclick="() => buyBalance = null"></div>
    <div class="dialog-panel card" role="dialog" aria-modal="true" aria-label="Acheter un parc">
        <div class="card-body">
            <h5>Acheter un parc ?</h5>
            <p>
                Un nouveau parc, avec ses propres Pokémon : il en accueille @ParkService.CapacityOf(0) et s'agrandit à part
                (@ParkService.MaxExpansions fois). Un Pokémon ne vit que dans un parc à la fois.
            </p>
            <fieldset class="mb-3">
                <legend class="fs-6 fw-semibold">Paysage</legend>
                @foreach (var landscape in Purchasable)
                {
                    var l = landscape;
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="parkLandscape" id="landscape-@((int)l)"
                               checked="@(buyChoice == l)" @onchange="() => buyChoice = l" />
                        <label class="form-check-label" for="landscape-@((int)l)">
                            <strong>@ParkLandscapes.Name(l)</strong>
                            <span class="d-block small text-muted">@ParkLandscapes.Description(l)</span>
                        </label>
                    </div>
                }
            </fieldset>
            <p class="mb-0">
                Prix : <strong>@InventoryService.FormatMoney(ParkService.ParkPrice)</strong>, payé avec ton porte-monnaie
                (@InventoryService.FormatMoney(wallet)).
                @if (!canPay)
                {
                    <span class="text-danger">
                        Il manque @InventoryService.FormatMoney(ParkService.ParkPrice - wallet) : retire de l'argent d'une
                        sauvegarde depuis <a href="inventaire">« Banque d'objets »</a>.
                    </span>
                }
            </p>
            <div class="d-flex justify-content-end gap-2 mt-3">
                <button type="button" class="btn btn-outline-secondary" @onclick="() => buyBalance = null">Annuler</button>
                <button type="button" class="btn btn-success" @onclick="Buy" disabled="@(busy || !canPay || buyChoice is null)">
                    Payer @InventoryService.FormatMoney(ParkService.ParkPrice)
                </button>
            </div>
        </div>
    </div>
}

}

@code {
    /// <summary>Titre de l'onglet : la page du compte, ou celle d'un autre joueur.</summary>
    private string PageName
    {
        get
        {
            if (!Visitor)
                return "Parc";
            return player is null ? "Joueur introuvable" : $"Parc de {player.Pseudo}";
        }
    }

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    /// <summary>Pseudo d'un autre joueur (adresse /joueurs/{pseudo}/parc) : son parc, en lecture seule.</summary>
    [Parameter] public string? Pseudo { get; set; }

    private bool Visitor => Pseudo is not null;
    private PlayerProfile? player; // joueur consulté, si son parc est public
    private bool playerChecked;
    private bool engineStarted;

    private string userId = "";
    private List<ParkInfo> parks = []; // parcs du joueur (liste déroulante), la Forêt d'abord
    private ParkInfo? current; // parc affiché
    private int ParkId => current?.Id ?? 0;
    private List<ParkPokemon> members = [];
    private int expansions => current?.Expansions ?? 0; // agrandissements achetés : la taille du parc (sa carte) et sa capacité
    private int Capacity => ParkService.CapacityOf(expansions);
    private List<ParkLandscape> Purchasable => [.. ParkLandscapes.All.Except(parks.Select(p => p.Landscape))];
    private long? expandBalance; // fenêtre « Agrandir le parc » ouverte : le solde du porte-monnaie
    private long? buyBalance; // fenêtre « Acheter un parc » ouverte : le solde du porte-monnaie
    private ParkLandscape? buyChoice; // paysage choisi dans cette fenêtre
    private bool debug; // mode debug du compte (page « Administration ») : boutons « + taille », « − taille », « Habitats »
    private bool showHabitats; // mode debug : types de cases colorés sur la carte
    private bool loaded;
    private bool busy;
    private string? message;
    private bool messageIsError;

    private ElementReference stage;
    private ElementReference parkBlock; // mis en plein écran (carte et fiche d'un Pokémon)
    private IJSObjectReference? module;
    private IJSObjectReference? engine;
    private DotNetObjectReference<Park>? selfRef;

    private List<ParkCandidate>? candidates; // fenêtre de choix ouverte
    private HashSet<int> chosen = [];
    private string search = "";
    private PokemonCriteria criteria = PokemonCriteria.None; // pastilles de la fenêtre de choix
    private List<int> abilities = []; // talents de la collection, pour la pastille « Talent »
    private string? chooserMessage;
    // Liste « Pokémon affichés » : d'après le parc enregistré (InPark, OtherPark), pas d'après les cases cochées : la liste
    // ne bouge pas avant « Valider », un Pokémon décoché reste affiché pour pouvoir le recocher. « Tous » à chaque ouverture.
    private ShownFilter shownFilter = ShownFilter.All;
    private bool confirmClear; // fenêtre de confirmation de « Vider le parc »

    private BankPokemon? selected;
    private PokemonView? selectedView;
    private ParkMoodResult? selectedMood; // humeur du Pokémon de la fiche, selon les habitats du parc (ParkHabitats)
    private string? selectedPortrait; // son portrait Donjon Mystère (Normal, Happy, Sad), à la place du sprite

    protected override async Task OnInitializedAsync()
    {
        if (Visitor)
        {
            player = await Players.FindAsync((await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier), Pseudo, PublicPages.Park);
            playerChecked = true;
            if (player is null)
                return;
            userId = player.Id;
        }
        else
        {
            userId = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
            debug = await Debug.IsActiveAsync(userId);
        }
        await LoadParks(null);
        members = await Parks.ListAsync(userId, ParkId);
        loaded = true;
    }

    /// <summary>Relit les parcs (taille, nombre de Pokémon) ; affiche <paramref name="parkId"/>, sinon le même, sinon la Forêt.</summary>
    private async Task LoadParks(int? parkId)
    {
        var id = parkId ?? current?.Id;
        parks = await Parks.ListParksAsync(userId);
        current = parks.FirstOrDefault(p => p.Id == id) ?? parks.FirstOrDefault();
    }

    /// <summary>Liste déroulante : un autre parc du joueur (le numéro vient du navigateur : le service le revérifie).</summary>
    private async Task ChangePark(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var id) || parks.FirstOrDefault(p => p.Id == id) is not { } park || park.Id == ParkId)
            return;
        busy = true;
        current = park;
        CloseDetail();
        message = null;
        members = await Parks.ListAsync(userId, park.Id);
        if (module is not null)
            await StartEngine();
        busy = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Le décor n'est affiché, pour un visiteur, qu'une fois le joueur trouvé : l'animation démarre alors.
        if (engineStarted || (Visitor && player is null))
            return;
        engineStarted = true;
        selfRef = DotNetObjectReference.Create(this);
        module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/parc.js");
        await StartEngine();
    }

    /// <summary>
    /// Démarre le parc dans le navigateur, avec la carte de son paysage et de sa taille (redémarré après un agrandissement,
    /// un achat ou un changement de parc).
    /// </summary>
    private async Task StartEngine()
    {
        if (engine is not null)
        {
            await engine.InvokeVoidAsync("dispose");
            await engine.DisposeAsync();
            engine = null;
        }
        // Seul le propriétaire peut déplacer ses Pokémon (dans son navigateur seulement : rien n'est enregistré)
        engine = await module!.InvokeAsync<IJSObjectReference>("create", stage, selfRef, new
        {
            canMove = !Visitor,
            map = ParkLandscapes.MapName(current?.Landscape ?? ParkLandscape.Forest),
            size = expansions + 1,
            fullscreen = parkBlock,
        });
        await engine.InvokeVoidAsync("setPokemon", members);
        if (showHabitats)
            await engine.InvokeVoidAsync("showHabitats", HabitatColors());
    }

    /// <summary>Couleur de chaque type de case, dans l'ordre des chiffres de la carte (0 : aucun).</summary>
    private static string[] HabitatColors() => [.. Enum.GetValues<Habitat>().Select(ParkHabitats.Color)];

    /// <summary>Mode debug : affiche ou cache les types de cases sur la carte.</summary>
    private async Task ToggleHabitats()
    {
        showHabitats = debug && !showHabitats;
        if (engine is not null)
            await engine.InvokeVoidAsync("showHabitats", showHabitats ? HabitatColors() : null);
    }

    private async Task OpenExpand()
    {
        if (Visitor)
            return;
        expandBalance = await InventoryStore.GetBalanceAsync(userId);
    }

    private async Task Expand()
    {
        if (Visitor)
            return;
        busy = true;
        var result = await Parks.ExpandAsync(userId, ParkId);
        expandBalance = null;
        Show(result.Message, !result.Ok);
        await LoadParks(null); // nouvelle taille (ou celle d'un achat fait dans un autre onglet)
        if (result.Ok)
        {
            await Wallet.RefreshAsync(userId); // solde du menu
            if (module is not null)
                await StartEngine();
        }
        busy = false;
    }

    private async Task OpenBuy()
    {
        if (Visitor)
            return;
        buyChoice = Purchasable.Count == 1 ? Purchasable[0] : null;
        buyBalance = await InventoryStore.GetBalanceAsync(userId);
    }

    /// <summary>Achète le paysage choisi (revérifié par le service) et l'affiche : vide, prêt pour « Choisir les Pokémon ».</summary>
    private async Task Buy()
    {
        if (Visitor || buyChoice is not { } landscape)
            return;
        busy = true;
        var result = await Parks.BuyAsync(userId, landscape);
        buyBalance = null;
        Show(result.Message, !result.Ok);
        if (result.Ok)
        {
            await Wallet.RefreshAsync(userId); // solde du menu
            CloseDetail();
            await LoadParks(result.ParkId);
            members = await Parks.ListAsync(userId, ParkId);
            if (module is not null)
                await StartEngine();
        }
        busy = false;
    }

    /// <summary>Mode debug : une taille de plus ou de moins, gratuitement (réduit : les derniers arrivés repartent).</summary>
    private async Task Resize(bool grow)
    {
        if (Visitor)
            return;
        busy = true;
        var result = await Debug.ResizeParkAsync(userId, ParkId, grow);
        Show(result.Message, !result.Ok);
        debug = await Debug.IsActiveAsync(userId); // coupé si le compte n'est plus administrateur
        showHabitats &= debug;
        if (result.Ok)
        {
            await LoadParks(null);
            members = await Parks.ListAsync(userId, ParkId);
            if (module is not null)
                await StartEngine();
        }
        busy = false;
    }

    /// <summary>Clic sur un Pokémon du parc (il s'est tourné vers toi) : sa fiche, seulement s'il est dans ce parc.</summary>
    [JSInvokable]
    public Task OnPokemonClicked(int id) => InvokeAsync(async () =>
    {
        var entry = await Parks.GetMemberAsync(userId, ParkId, id);
        if (entry is null || current is null || BankService.ToPkm(entry) is not { } pk)
            return;
        selected = entry;
        selectedView = Info.Describe(pk, entry.IsLegal);
        // Humeur selon les types de cases de ce parc (son paysage, sa taille : ses agrandissements)
        selectedMood = ParkHabitats.MoodOf(entry.Type1, entry.Type2, ParkHabitats.Map(current.Landscape, expansions + 1));
        selectedPortrait = PokemonSprites.DonjonPortraitUrl(entry, selectedMood.Portrait);
        StateHasChanged();
    });

    /// <summary>Mode debug : la fiche se ferme et le Pokémon attaque le plus proche (dans le navigateur seulement).</summary>
    private async Task AttackSelected()
    {
        if (!debug || Visitor || selected is null || engine is null)
            return;
        var id = selected.Id;
        CloseDetail();
        if (!await engine.InvokeAsync<bool>("attack", id))
            Show("Aucun autre Pokémon à attaquer.", true);
    }

    private void CloseDetail()
    {
        selected = null;
        selectedView = null;
        selectedMood = null;
        selectedPortrait = null;
    }

    private async Task RemoveSelected()
    {
        if (selected is null || Visitor)
            return;
        busy = true;
        var name = selectedView?.Nickname ?? "Le Pokémon";
        await Parks.RemoveAsync(userId, selected.Id);
        CloseDetail();
        await Reload();
        Show($"{name} a quitté le parc (il reste dans ta collection).");
        busy = false;
    }

    private async Task ClearPark()
    {
        if (Visitor)
            return;
        busy = true;
        var result = await Parks.ClearAsync(userId, ParkId);
        confirmClear = false;
        CloseDetail();
        await Reload();
        Show(result.Message, !result.Ok);
        busy = false;
    }

    // ---------- Choix des Pokémon ----------

    private async Task OpenChooser()
    {
        if (Visitor)
            return;
        search = "";
        chooserMessage = null;
        shownFilter = ShownFilter.All;
        criteria = PokemonCriteria.None;
        abilities = await BankStore.ListAbilitiesAsync(userId);
        candidates = await Parks.ListCandidatesAsync(userId, ParkId);
        chosen = candidates.Where(c => c.InPark).Select(c => c.Id).ToHashSet();
    }

    /// <summary>Pastilles modifiées : nouvelle liste ; les Pokémon déjà choisis le restent, même cachés par les filtres.</summary>
    private async Task CriteriaChanged(PokemonCriteria value)
    {
        criteria = value;
        candidates = await Parks.ListCandidatesAsync(userId, ParkId, value);
    }

    /// <summary>Pictogrammes d'un Pokémon de la fenêtre de choix : sauvegarde stockée (💾), autre parc (🏝️, 🌳).</summary>
    private static string? Marker(ParkCandidate c)
    {
        var marker = (c.StoredSaveId is null ? "" : "💾") + (c.OtherPark is { } other ? ParkLandscapes.Icon(other) : "");
        return marker.Length == 0 ? null : marker;
    }

    private void CloseChooser() => candidates = null;

    private void Toggle(ParkCandidate c)
    {
        chooserMessage = null;
        if (chosen.Remove(c.Id))
            return;
        if (!c.HasSprites)
            chooserMessage = $"{c.SpeciesName} n'a pas encore de sprites Donjon Mystère : il ne peut pas venir au parc pour l'instant.";
        else if (c.Refusal is not null)
            chooserMessage = ParkService.RefusalMessage(c.SpeciesName, current?.Landscape ?? ParkLandscape.Ocean);
        else if (chosen.Count >= Capacity && !c.InPark) // un parc déjà trop plein garde ses Pokémon : on peut les recocher
            chooserMessage = $"Le parc est plein ({Capacity} Pokémon) : retires-en un avant d'en ajouter un autre" +
                             (expansions < ParkService.MaxExpansions ? ", ou agrandis-le." : ".");
        else
            chosen.Add(c.Id);
    }

    /// <summary>« Tout retirer » : décoche tout, rien ne change avant « Valider » (« Annuler » le défait).</summary>
    private void UnselectAll()
    {
        chosen.Clear();
        chooserMessage = null;
    }

    /// <summary>Choix de la liste « Pokémon affichés » de la fenêtre de choix.</summary>
    private enum ShownFilter { All, ThisPark, NoPark }

    private bool Matches(ParkCandidate c) =>
        shownFilter switch
        {
            ShownFilter.ThisPark => c.InPark,
            ShownFilter.NoPark => !c.InPark && c.OtherPark is null,
            _ => true,
        }
        && MatchesSearch(c);

    /// <summary>Message quand la recherche, les pastilles et la liste « Pokémon affichés » ne laissent aucun Pokémon.</summary>
    private string EmptyMessage() =>
        !string.IsNullOrWhiteSpace(search) || !criteria.IsEmpty
            ? "Aucun Pokémon ne correspond."
            : shownFilter == ShownFilter.ThisPark
                ? "Ce parc n'a pas encore de Pokémon."
                : "Tous tes Pokémon vivent déjà dans un parc.";

    private bool MatchesSearch(ParkCandidate c) =>
        string.IsNullOrWhiteSpace(search)
        || French.IndexOf(c.SpeciesName, search.Trim(), IgnoreCaseAndAccents) >= 0
        || French.IndexOf(c.Nickname, search.Trim(), IgnoreCaseAndAccents) >= 0;

    private static readonly System.Globalization.CompareInfo French = System.Globalization.CultureInfo.GetCultureInfo("fr-FR").CompareInfo;
    private const System.Globalization.CompareOptions IgnoreCaseAndAccents =
        System.Globalization.CompareOptions.IgnoreCase | System.Globalization.CompareOptions.IgnoreNonSpace;

    private async Task SaveChoice()
    {
        if (Visitor)
            return;
        busy = true;
        var result = await Parks.SetAsync(userId, ParkId, chosen);
        busy = false;
        if (!result.Ok)
        {
            chooserMessage = result.Message;
            return;
        }
        candidates = null;
        await Reload();
        Show(result.Message);
    }

    private async Task Reload()
    {
        await LoadParks(null); // nombre de Pokémon de chaque parc (liste déroulante)
        members = await Parks.ListAsync(userId, ParkId);
        if (engine is not null)
            await engine.InvokeVoidAsync("setPokemon", members);
    }

    private void Show(string text, bool isError = false)
    {
        message = text;
        messageIsError = isError;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (engine is not null)
            {
                await engine.InvokeVoidAsync("dispose");
                await engine.DisposeAsync();
            }
            if (module is not null)
                await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // onglet fermé : plus rien à nettoyer côté navigateur
        }
        selfRef?.Dispose();
    }
}
