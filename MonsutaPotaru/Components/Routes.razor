@using MonsutaPotaru.Components.Account.Shared
@* Thème du compte (App.razor), transmis aux mises en page : MainLayout choisit son cadre (Ardoise ou menu classique). *@
<CascadingValue Name="SiteTheme" Value="Theme" IsFixed="true">
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            @* Joueur dont la page est affichée (MainLayout recrée la page quand il change, voir PageOwnerOf). *@
            <CascadingValue Name="PageOwner" Value="PageOwnerOf(routeData)">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated == true)
                    {
                        @* Connecté, mais sans le rôle demandé (page « Administration ») *@
                        <PageHeader Title="Accès refusé" Icon="bi-lock-nav-menu">
                            <Description>Tu n'as pas accès à cette page.</Description>
                        </PageHeader>
                    }
                    else
                    {
                        <RedirectToLogin />
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            </CascadingValue>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingValue>

@code {
    /// <summary>Clé du thème du compte (<c>SiteThemes</c>), posée par App.razor.</summary>
    [Parameter] public string? Theme { get; set; }

    /// <summary>
    /// Pseudo du joueur des pages /joueurs/{Pseudo}/... ; vide pour les pages du compte. Collection, Parc, Inventaire... ont
    /// deux adresses (la sienne, celle d'un autre joueur) pour un même composant, que Blazor garde d'une adresse à l'autre :
    /// sans clé, « Ma collection » depuis /joueurs/sacha/collection garderait la collection de sacha.
    /// </summary>
    public static string PageOwnerOf(RouteData routeData) =>
        routeData.RouteValues.TryGetValue("Pseudo", out var pseudo) ? pseudo?.ToString() ?? "" : "";
}
