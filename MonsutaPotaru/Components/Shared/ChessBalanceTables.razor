@using MonsutaPotaru.Services
@inject ChessDraftService Drafts
@* Onglet « Échecs » de l'administration : l'équilibrage des équipes d'échecs, calculé d'après ChessTeams.All et la table
   des types (ChessBalance), rien en base. Trois synthèses (part mangeable, rois menacés, solde), puis chaque équipe
   contre les lignes (pièce et type : 7 par équipe, les pions ayant deux types) de toutes les équipes, dans les deux sens. Demandé par l'utilisateur le 2026-11-24 (d'abord une page
   générée à part). Case « Avec les brouillons » (WithDrafts, gardée dans l'adresse par Admin.razor) : les brouillons
   comptés (ChessDraftService.Teams) remplacent l'équipe qu'ils modifient ou s'ajoutent, et chaque chiffre montre son écart
   avec les équipes du jeu (« (+6) »). Section « Types » (somme des types, une fois par type de pion) et sections
   repliables, l'état gardé dans le navigateur (localStorage), demandés le 2026-11-25 : le contenu attend de l'avoir lu
   (une section repliée n'est jamais calculée). *@
@inject IJSRuntime JS

@if (!stateRead)
{
    <p class="text-muted">Chargement…</p>
}
else
{
    <Block Title="Brouillons" Id="@DraftsId" Collapsible Collapsed="@IsCollapsed(DraftsId)" CollapsedChanged="c => SetCollapsed(DraftsId, c)">
        @if (drafts.Count == 0)
        {
            <p class="small text-muted mb-0">
                Aucun brouillon : crée une équipe ou modifie-en une dans l'onglet
                <a href="administration?onglet=brouillons-echecs">« Brouillons d'échecs »</a>, puis compare-la ici.
            </p>
        }
        else
        {
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="chess-balance-with-drafts" checked="@WithDrafts"
                       @onchange="e => SetWithDrafts(e.Value is true)" />
                <label class="form-check-label" for="chess-balance-with-drafts">
                    Avec les brouillons comptés : ils remplacent l'équipe qu'ils modifient (ou s'ajoutent), et chaque chiffre
                    montre l'écart avec les équipes du jeu
                </label>
            </div>
            <ul class="list-unstyled small mb-2 ms-4 chess-balance-draft-list">
                @foreach (var draft in drafts)
                {
                    var d = draft;
                    <li class="form-check">
                        <input class="form-check-input" type="checkbox" id="chess-balance-draft-@d.Id" checked="@d.Counted"
                               disabled="@busy" @onchange="e => SetCounted(d, e.Value is true)" />
                        <label class="form-check-label" for="chess-balance-draft-@d.Id">
                            @d.Title : @d.TeamName
                            <span class="text-muted">(@DraftDetails(d))</span>
                            @if (!d.Complete)
                            {
                                <span class="badge text-bg-warning">incomplet : pas compté</span>
                            }
                        </label>
                    </li>
                }
            </ul>
            @if (message is not null)
            {
                <p class="small @(messageIsError ? "text-danger" : "text-success") mb-2">@message</p>
            }
            <a href="administration?onglet=brouillons-echecs" class="small">Modifier les brouillons</a>
        }
    </Block>

    @* Un lien du menu déplie la section visée *@
    <nav class="chess-balance-nav small mb-2" aria-label="Équipes">
        <a href="@Link(SummaryId)" @onclick="() => SetCollapsed(SummaryId, false)">Synthèse</a>
        <a href="@Link(KingsId)" @onclick="() => SetCollapsed(KingsId, false)">Rois menacés</a>
        <a href="@Link(BalanceId)" @onclick="() => SetCollapsed(BalanceId, false)">Solde</a>
        <a href="@Link(TypesId)" @onclick="() => SetCollapsed(TypesId, false)">Types</a>
        @foreach (var team in Teams)
        {
            var anchor = TeamAnchor(team);
            <a href="@Link(anchor)" @onclick="() => SetCollapsed(anchor, false)">@team.ShortName</a>
        }
    </nav>
    <div class="d-flex flex-wrap gap-2 mb-3">
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => SetAll(true)">Tout replier</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => SetAll(false)">Tout déplier</button>
    </div>

    <Block Title="Synthèse" Id="@SummaryId" Collapsible Collapsed="@IsCollapsed(SummaryId)" CollapsedChanged="c => SetCollapsed(SummaryId, c)">
        <p class="small text-muted">
            Part des pièces de l'équipe en colonne que celles de la ligne peuvent manger, <strong>selon le nombre de pièces</strong>
            (8 pions, 4 de chaque type, 2 tours, 2 fous, 2 cavaliers, une reine, un roi : 16 × 16 paires), et la part super efficace. La dernière
            colonne fait la moyenne contre toutes les équipes, elle comprise (deux joueurs peuvent prendre la même).
        </p>
        <div class="form-check small mb-2">
            <input class="form-check-input" type="checkbox" id="chess-balance-without-self" checked="@withoutSelf"
                   @onchange="e => withoutSelf = e.Value is true" />
            <label class="form-check-label" for="chess-balance-without-self">Ne pas compter l'équipe contre elle-même dans la moyenne</label>
        </div>
        <div class="chess-help-scroll">
            <table class="chess-balance-summary">
                <thead>
                    <tr>
                        <th scope="col" class="chess-help-corner small text-muted">mange&nbsp;→</th>
                        @foreach (var team in Teams)
                        {
                            <th scope="col">@TeamHeader(team)</th>
                        }
                        <th scope="col">Moyenne</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var team in Teams)
                    {
                        <tr>
                            <th scope="row">@TeamHeader(team)</th>
                            @foreach (var other in Teams)
                            {
                                var m = ChessBalance.Matchup(team, other);
                                var edible = ChessBalance.Points(m.Edible);
                                <td class="@(other == team ? withoutSelf ? "chess-balance-same chess-balance-excluded" : "chess-balance-same" : "")" style="--hue: @EdibleHue(m.Edible)">
                                    <strong>@edible %</strong>@Delta(edible, Before(team, other, (a, v) => ChessBalance.Points(ChessBalance.Matchup(a, v).Edible)), true)
                                    <span class="d-block small">dont ×2 : @ChessBalance.Points(m.Super) %</span>
                                </td>
                            }
                            @{ var average = ChessBalance.Points(ChessBalance.Average(team, Teams, withoutSelf)); }
                            <td class="chess-balance-average"><strong>@average %</strong>@Delta(average, AverageBefore(team), true)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </Block>

    <Block Title="Rois menacés" Id="@KingsId" Collapsible Collapsed="@IsCollapsed(KingsId)" CollapsedChanged="c => SetCollapsed(KingsId, c)">
        <p class="small text-muted">
            Combien de pièces de l'équipe en colonne (sur 16) peuvent manger le roi de la ligne : seules celles-là peuvent le
            mettre en échec.
        </p>
        <div class="chess-help-scroll">
            <table class="chess-balance-summary">
                <thead>
                    <tr>
                        <th scope="col" class="chess-help-corner small text-muted">menacé&nbsp;par&nbsp;→</th>
                        @foreach (var team in Teams)
                        {
                            <th scope="col">@TeamHeader(team)</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var team in Teams)
                    {
                        <tr>
                            <th scope="row">@PieceHeader(team.LinesOf(ChessPiece.King)[0])</th>
                            @foreach (var other in Teams)
                            {
                                var threats = ChessBalance.KingThreats(other, team);
                                <td class="@(other == team ? "chess-balance-same" : "")" style="--hue: @ThreatHue(threats)">@threats@Delta(threats, Before(other, team, ChessBalance.KingThreats), false)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </Block>

    <Block Title="Solde" Id="@BalanceId" Collapsible Collapsed="@IsCollapsed(BalanceId)" CollapsedChanged="c => SetCollapsed(BalanceId, c)">
        <p class="small text-muted">
            Part mangeable de la ligne contre la colonne, moins celle de la colonne contre la ligne, en points. Positif : l'équipe
            de la ligne mange plus qu'elle n'est mangée.
        </p>
        <div class="chess-help-scroll">
            <table class="chess-balance-summary">
                <thead>
                    <tr>
                        <th scope="col" class="chess-help-corner small text-muted"></th>
                        @foreach (var team in Teams)
                        {
                            <th scope="col">@TeamHeader(team)</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var team in Teams)
                    {
                        <tr>
                            <th scope="row">@TeamHeader(team)</th>
                            @foreach (var other in Teams)
                            {
                                if (other == team)
                                {
                                    <td class="chess-balance-same">—</td>
                                }
                                else
                                {
                                    var points = ChessBalance.Balance(team, other);
                                    <td style="--hue: @BalanceHue(points)">@(points > 0 ? "+" : "")@points@Delta(points, Before(team, other, ChessBalance.Balance), true)</td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </Block>

    <Block Title="Types" Id="@TypesId" Collapsible Collapsed="@IsCollapsed(TypesId)" CollapsedChanged="c => SetCollapsed(TypesId, c)">
        <p class="small text-muted">
            Combien de fois chaque type est pris dans les équipes : une fois par pièce, et <strong>une fois par type de
            pion</strong> (les huit pions d'une équipe comptent pour deux). Du plus fréquent au moins fréquent ; le survol
            d'un chiffre donne les équipes.
        </p>
        <div class="chess-help-scroll">
            <table class="chess-balance-summary chess-balance-types">
                <thead>
                    <tr>
                        <th scope="col">Type</th>
                        <th scope="col">Total</th>
                        @foreach (var piece in Pieces)
                        {
                            <th scope="col"><span class="chess-piece-symbol" aria-hidden="true">@ChessTeams.Symbol(piece)</span> @ChessTeams.PieceName(piece)</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (type, lines) in TypeRows())
                    {
                        <tr class="@(lines.Count == 0 ? "text-muted" : "")">
                            <th scope="row"><span class="chess-type type-@PokeTypes.Key(type)">@PokeTypes.Name(type)</span></th>
                            <td class="chess-balance-average" title="@TypeTitle(lines, true)"><strong>@lines.Count</strong>@Delta(lines.Count, TypeBefore(type, null), null)</td>
                            @foreach (var piece in Pieces)
                            {
                                var ofPiece = lines.Where(l => l.Line.Piece == piece).ToList();
                                <td class="@(ofPiece.Count == 0 ? "chess-balance-zero" : "")" title="@TypeTitle(ofPiece, false)">@ofPiece.Count@Delta(ofPiece.Count, TypeBefore(type, piece), null)</td>
                            }
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th scope="row">Tous</th>
                        @{ var all = Teams.Sum(t => t.Lines(Pieces).Count); }
                        <td class="chess-balance-average"><strong>@all</strong>@Delta(all, WithDrafts ? ChessTeams.All.Sum(t => t.Lines(Pieces).Count) : null, null)</td>
                        @foreach (var piece in Pieces)
                        {
                            var p = piece;
                            var count = Teams.Sum(t => t.LinesOf(p).Count);
                            <td>@count@Delta(count, WithDrafts ? ChessTeams.All.Sum(t => t.LinesOf(p).Count) : null, null)</td>
                        }
                    </tr>
                </tfoot>
            </table>
        </div>
    </Block>

    <p class="chess-help-legend small">
        <span class="chess-help-mark super">×2</span> super efficace : elle mange et rejoue
        <span class="chess-help-mark eats">✓</span> elle mange
        <span class="chess-help-mark blocked">✗</span> elle ne peut pas manger (pas très efficace)
        <span class="chess-help-mark blocked">✗<sub>0</sub></span> sans effet
        <span class="text-muted">— le survol d'une case donne le multiplicateur.</span>
    </p>

    @foreach (var team in Teams)
    {
        var anchor = TeamAnchor(team);
        <Block Title="@team.Name" Id="@anchor" Collapsible Collapsed="@IsCollapsed(anchor)" CollapsedChanged="c => SetCollapsed(anchor, c)">
            @BigTable(team, true)
            @BigTable(team, false)
        </Block>
    }
}

@code {
    /// <summary>Case « Ne pas compter l'équipe contre elle-même » : la moyenne sur les six autres, la case du miroir grisée.</summary>
    private bool withoutSelf;

    // Sections repliables (leur ancre) ; les équipes : TeamAnchor.
    private const string DraftsId = "chess-balance-drafts";
    private const string SummaryId = "chess-balance-summary";
    private const string KingsId = "chess-balance-kings";
    private const string BalanceId = "chess-balance-balance";
    private const string TypesId = "chess-balance-types";

    /// <summary>Sections repliées, gardées dans le navigateur (leurs ancres, séparées par des espaces).</summary>
    private const string CollapsedStorageKey = "monsuta-potaru.administration.echecs.replie";

    private HashSet<string> collapsed = [];

    /// <summary>État des sections lu dans le navigateur : avant, rien n'est affiché (ni calculé pour rien).</summary>
    private bool stateRead;

    /// <summary>Colonnes de la section « Types » : les pièces dans l'ordre de l'échiquier (pion d'abord).</summary>
    private static readonly ChessPiece[] Pieces = Enum.GetValues<ChessPiece>();

    /// <summary>Ordre des pièces : celui des listes d'équipes (roi d'abord).</summary>
    private static readonly ChessPiece[] Order = ChessTeamList.Order;

    /// <summary>Administrateur qui regarde (les brouillons se lisent en revérifiant son rôle).</summary>
    [Parameter, EditorRequired] public string UserId { get; set; } = "";

    /// <summary>Case « Avec les brouillons » : gardée dans l'adresse (« &amp;brouillons=oui ») par la page.</summary>
    [Parameter] public bool WithDrafts { get; set; }

    [Parameter] public EventCallback<bool> WithDraftsChanged { get; set; }

    private IReadOnlyList<ChessDraft> drafts = [];
    private bool busy;
    private string? message;
    private bool messageIsError;

    /// <summary>Les équipes comparées : celles du jeu, ou avec les brouillons comptés.</summary>
    private ChessBalanceTeams set = ChessBalanceTeams.Game;

    private IReadOnlyList<ChessTeam> Teams => set.Teams;

    protected override async Task OnInitializedAsync()
    {
        drafts = await Drafts.ListAsync(UserId) ?? [];
        Refresh();
    }

    protected override void OnParametersSet() => Refresh();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", CollapsedStorageKey);
            collapsed = [.. (stored ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries)];
        }
        catch (JSException)
        {
            // stockage du navigateur indisponible (navigation privée...) : tout est ouvert
        }
        stateRead = true;
        StateHasChanged();
    }

    private bool IsCollapsed(string id) => collapsed.Contains(id);

    private Task SetCollapsed(string id, bool on) => (on ? collapsed.Add(id) : collapsed.Remove(id)) ? SaveCollapsed() : Task.CompletedTask;

    /// <summary>« Tout replier » (les sections affichées) ou « Tout déplier ».</summary>
    private Task SetAll(bool on)
    {
        if (on)
            collapsed.UnionWith([DraftsId, SummaryId, KingsId, BalanceId, TypesId, .. Teams.Select(TeamAnchor)]);
        else
            collapsed.Clear();
        return SaveCollapsed();
    }

    private async Task SaveCollapsed()
    {
        try
        {
            if (collapsed.Count == 0)
                await JS.InvokeVoidAsync("localStorage.removeItem", CollapsedStorageKey);
            else
                await JS.InvokeVoidAsync("localStorage.setItem", CollapsedStorageKey, string.Join(' ', collapsed.Order()));
        }
        catch (JSException)
        {
            // stockage indisponible : le repli vaut pour cette visite seulement
        }
    }

    /// <summary>Les 18 types et leurs lignes dans les équipes comparées, du plus fréquent au moins fréquent (ordre des types à égalité).</summary>
    private IEnumerable<(PokeType Type, IReadOnlyList<ChessTeamLine> Lines)> TypeRows() =>
        Enum.GetValues<PokeType>()
            .Select(type => (type, ChessBalance.LinesOfType(Teams, type)))
            .OrderByDescending(row => row.Item2.Count);

    /// <summary>Même somme avec les équipes du jeu (pour l'écart) ; null sans les brouillons.</summary>
    private int? TypeBefore(PokeType type, ChessPiece? piece) =>
        WithDrafts ? ChessBalance.LinesOfType(ChessTeams.All, type).Count(l => piece is null || l.Line.Piece == piece) : null;

    /// <summary>
    /// Survol d'un chiffre de la section « Types » : une équipe par ligne (« Dracaufeu : Salamèche (pion) ») ; sans la
    /// pièce dans une colonne de pièce. Null s'il n'y en a aucune.
    /// </summary>
    private static string? TypeTitle(IReadOnlyList<ChessTeamLine> lines, bool withPiece) => lines.Count == 0 ? null
        : string.Join("\n", lines.GroupBy(l => l.Team).Select(g =>
            $"{g.Key.ShortName}{(g.Key.Draft is null ? "" : $" ({g.Key.Draft})")} : "
            + string.Join(", ", g.Select(l => withPiece ? $"{l.Line.Names} ({ChessTeams.PieceName(l.Line.Piece).ToLowerInvariant()})" : l.Line.Names))));

    /// <summary>Refait la liste des équipes comparées (case, ou brouillons changés).</summary>
    private void Refresh() => set = WithDrafts ? ChessDraftService.Teams(drafts) : ChessBalanceTeams.Game;

    private async Task SetWithDrafts(bool on)
    {
        WithDrafts = on;
        Refresh();
        await WithDraftsChanged.InvokeAsync(on);
    }

    private async Task SetCounted(ChessDraft draft, bool counted)
    {
        busy = true;
        try
        {
            var result = await Drafts.SetCountedAsync(UserId, draft.Id, counted);
            (message, messageIsError) = (result.Message, !result.Ok);
            drafts = await Drafts.ListAsync(UserId) ?? [];
            Refresh();
        }
        finally
        {
            busy = false;
        }
    }

    /// <summary>« modifie l'équipe Gallame ; sans Combat ».</summary>
    private static string DraftDetails(ChessDraft draft) =>
        (draft.Base is { } b ? $"modifie l'{b.InSentence}" : "nouvelle équipe") + (draft.Note.Length > 0 ? $" ; {draft.Note}" : "");

    /// <summary>
    /// Valeur des deux équipes du jeu que <paramref name="first"/> et <paramref name="second"/> remplacent (pour l'écart) ;
    /// null sans les brouillons, quand l'une est une nouvelle équipe, ou quand ce sont deux équipes du jeu.
    /// </summary>
    private int? Before(ChessTeam first, ChessTeam second, Func<ChessTeam, ChessTeam, int> value) =>
        WithDrafts && set.OriginOf(first) is { } a && set.OriginOf(second) is { } b && (a != first || b != second) ? value(a, b) : null;

    /// <summary>
    /// Moyenne de l'équipe du jeu que <paramref name="team"/> remplace (elle-même pour une équipe du jeu : une nouvelle
    /// équipe change la moyenne des autres), contre les équipes du jeu ; null sans les brouillons ou pour une nouvelle équipe.
    /// </summary>
    private int? AverageBefore(ChessTeam team) =>
        WithDrafts && set.OriginOf(team) is { } origin ? ChessBalance.Points(ChessBalance.Average(origin, ChessTeams.All, withoutSelf)) : null;

    /// <summary>
    /// Écart avec les équipes du jeu (« (+6) »), rien s'il est nul ou sans objet ; vert s'il va dans le bon sens pour
    /// l'équipe de la ligne (<paramref name="higherIsBetter"/> : plus elle mange, mieux c'est ; un roi plus menacé, moins
    /// bien ; null : ni l'un ni l'autre, sans couleur, comme la somme des types).
    /// </summary>
    private static RenderFragment Delta(int now, int? before, bool? higherIsBetter) => __builder =>
    {
        if (before is { } b && now != b)
        {
            var color = higherIsBetter is not { } higher ? "" : now > b == higher ? "chess-balance-better" : "chess-balance-worse";
            <span class="chess-balance-delta @color"
                  title="@($"Avec les équipes du jeu : {b}")">(@(now > b ? "+" : "−")@Math.Abs(now - b))</span>
        }
    };

    /// <summary>Ancre d'une équipe (« equipe-psy »).</summary>
    private static string TeamAnchor(ChessTeam team) => $"equipe-{team.Id}";

    /// <summary>Lien vers une ancre de l'onglet : l'adresse entière (le lien « #… » seul partirait vers l'accueil, base « / »).</summary>
    private static string Link(string anchor) => $"administration?onglet=echecs#{anchor}";

    /// <summary>Couleur d'une part mangeable : rouge à 40 % ou moins, vert à 100 %.</summary>
    private static int EdibleHue(double edible) => Math.Clamp((int)Math.Round((edible - 0.4) / 0.6 * 120), 0, 120);

    /// <summary>Couleur d'un roi : vert s'il est peu menacé, rouge s'il l'est par les 16 pièces.</summary>
    private static int ThreatHue(int threats) => Math.Clamp((16 - threats) * 12, 0, 120);

    /// <summary>Couleur d'un solde : jaune à 0, vert au-delà de +30 points, rouge en deçà de −30.</summary>
    private static int BalanceHue(int points) => Math.Clamp(60 + points * 2, 0, 120);

    /// <summary>En-tête d'une équipe dans les synthèses : l'image de son roi et son nom.</summary>
    private static RenderFragment TeamHeader(ChessTeam team) => __builder =>
    {
        var king = team.Of(ChessPiece.King);
        <span class="chess-balance-team @(team.Draft is null ? "" : "chess-balance-draft")">
            <img src="@king.SpriteUrl" alt="" data-remplacement="images/pokemon/inconnu.png" />
            <span>@team.Name</span>
        </span>
    };

    /// <summary>
    /// Une ligne (pièce d'un type) : images (deux pour les pions Nidoran), nom, type, pièce. <paramref name="column"/> :
    /// en-tête d'une des 49 colonnes, le nom au survol seulement (dans 3,6rem, il se coupait au milieu ; écrit en entier,
    /// la table passait de ~2 200 à ~2 700 px CSS, avec 42 colonnes).
    /// </summary>
    private static RenderFragment PieceHeader(ChessLine line, bool column = false) => __builder =>
    {
        <span class="chess-balance-piece" title="@(column ? line.Names : null)">
            <span class="chess-mon-images">
                @foreach (var member in line.Members)
                {
                    <img src="@member.SpriteUrl" alt="" data-remplacement="images/pokemon/inconnu.png" />
                }
            </span>
            <span class="chess-balance-piece-text">
                @if (!column)
                {
                    <span class="chess-mon-name">@line.Names</span>
                }
                <span class="chess-type type-@PokeTypes.Key(line.Type)">@PokeTypes.Name(line.Type)</span>
                <span class="chess-help-piece">
                    <span class="chess-piece-symbol" aria-hidden="true">@ChessTeams.Symbol(line.Piece)</span>
                    <span class="chess-piece-name">@ChessTeams.PieceName(line.Piece)</span>
                </span>
            </span>
        </span>
    };

    /// <summary>
    /// Les lignes de <paramref name="team"/> en lignes, celles de toutes les équipes en colonnes (la sienne d'abord) ;
    /// <paramref name="attacking"/> : la ligne mange la colonne, sinon la colonne mange la ligne.
    /// </summary>
    private RenderFragment BigTable(ChessTeam team, bool attacking) => __builder =>
    {
        var columns = Teams.OrderBy(t => t == team ? 0 : 1).ToList();
        <div class="chess-help-scroll chess-balance-big-scroll">
            <table class="chess-help-table chess-balance-big">
                <caption>@(attacking ? "Ce que mangent ses pièces (la ligne mange la colonne)" : "Qui peut manger ses pièces (la colonne mange la ligne)")</caption>
                <thead>
                    <tr>
                        <th scope="col" rowspan="2" class="chess-balance-sticky chess-help-corner small text-muted">@(attacking ? "mange →" : "← mangée par")</th>
                        @foreach (var other in columns)
                        {
                            <th scope="colgroup" colspan="@other.Lines(Order).Count" class="chess-balance-group">@(other == team ? "Même équipe" : other.Name)</th>
                        }
                    </tr>
                    <tr>
                        @foreach (var other in columns)
                        {
                            var lines = other.Lines(Order);
                            @foreach (var line in lines)
                            {
                                <th scope="col" class="chess-balance-col @(line == lines[0] ? "chess-balance-first" : "")">@PieceHeader(line, true)</th>
                            }
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in team.Lines(Order))
                    {
                        <tr>
                            <th scope="row" class="chess-balance-sticky chess-balance-row">@PieceHeader(row)</th>
                            @foreach (var other in columns)
                            {
                                var lines = other.Lines(Order);
                                @foreach (var column in lines)
                                {
                                    var mark = attacking ? ChessBalance.Mark(row, column) : ChessBalance.Mark(column, row);
                                    @ChessMarkCell.Cell(mark, true, column == lines[0] ? "chess-balance-first" : null)
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    };
}
