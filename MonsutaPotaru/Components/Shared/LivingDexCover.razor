@using MonsutaPotaru.Data
@using MonsutaPotaru.Services
@* Image d'un living dex : la jaquette officielle du jeu ; pour les living dex globaux, qui n'ont pas de jeu, la Master Ball
   ou le Charme Chroma (images des objets sur le site, agrandies sans flou). Living dex chromatique d'un jeu : sa jaquette,
   avec un petit Charme Chroma dans le coin. *@
@if (GlobalLivingDex.IsGlobal(Game.Game))
{
    <img class="livingdex-pokeball @Class" src="@PokemonInfo.ItemSpriteUrl(GlobalLivingDex.CoverItem(Game.Game))" alt="@Alt" loading="lazy" />
}
else if (Game.Shiny)
{
    <span class="livingdex-shiny-cover @Class">
        <img src="@Game.Cover" alt="@Alt" loading="lazy" data-cacher-si-absente />
        <img class="livingdex-shiny-badge livingdex-pokeball" src="@PokemonInfo.ItemSpriteUrl(ShinyCharm)" alt="" title="Chromatique" loading="lazy" />
    </span>
}
else
{
    <img class="@Class" src="@Game.Cover" alt="@Alt" loading="lazy" data-cacher-si-absente />
}

@code {
    /// <summary>Charme Chroma (objet n° 632), comme pour le global chromatique.</summary>
    private static readonly int ShinyCharm = GlobalLivingDex.CoverItem(LivingDexGame.GlobalShiny);

    [Parameter, EditorRequired] public LivingDexGameInfo Game { get; set; } = default!;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string Alt { get; set; } = "";
}
