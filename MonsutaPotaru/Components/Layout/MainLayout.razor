@inherits LayoutComponentBase

@* Thème Ardoise : son propre cadre (menu repliable, barre du haut). Les autres thèmes : menu latéral classique. *@
@if (Theme == MonsutaPotaru.Services.SiteThemes.Ardoise)
{
    <ArdoiseLayout>
        <MonsutaPotaru.Components.Account.Shared.PseudoGuard @key="PageOwner">
            @Body
        </MonsutaPotaru.Components.Account.Shared.PseudoGuard>
    </ArdoiseLayout>
}
else
{
    <div class="page">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <div class="top-row">
            </div>

            <article class="content">
                <MonsutaPotaru.Components.Account.Shared.PseudoGuard @key="PageOwner">
                    @Body
                </MonsutaPotaru.Components.Account.Shared.PseudoGuard>
            </article>
        </main>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    Une erreur inattendue s'est produite.
    <a href="." class="reload">Recharger</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    /// <summary>Clé du thème du compte, transmise par Routes.razor.</summary>
    [CascadingParameter(Name = "SiteTheme")] private string? Theme { get; set; }

    /// <summary>
    /// Joueur de la page (Routes.PageOwnerOf) : la clé recrée la page quand il change. Collection, Parc, Inventaire...
    /// lisent le compte affiché une seule fois ; sans elle, « Ma collection » depuis la collection d'un autre joueur
    /// garderait la sienne.
    /// </summary>
    [CascadingParameter(Name = "PageOwner")] private string? PageOwner { get; set; }
}
