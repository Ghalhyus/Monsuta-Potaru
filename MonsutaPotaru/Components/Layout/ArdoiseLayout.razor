@* Cadre du thème Ardoise (choisi par MainLayout) : menu latéral sombre repliable en colonne d'icônes (le compte en bas),
   barre du haut avec le fil d'Ariane, le porte-monnaie et le menu du compte. Styles : wwwroot/themes/ardoise.css. Compteurs et adresse de la
   page : SiteMenuBase (communs au menu des autres thèmes).
   Doit marcher sans interactivité (pages du compte, rendu statique) : replier le menu, ouvrir une rubrique ou le menu du
   compte passe par wwwroot/js/app.js, jamais par un @onclick. *@
@inherits SiteMenuBase

<div class="ardoise">
    <aside class="ardoise-menu" id="ardoise-menu" aria-label="Menu du site">
        <a class="ardoise-brand" href="" title="Monsuta Potaru">
            <span class="ardoise-logo" aria-hidden="true">M</span>
            <span class="ardoise-label">Monsuta Potaru</span>
        </a>

        <nav class="ardoise-nav">
            <NavLink class="ardoise-link" href="" Match="NavLinkMatch.All" title="Accueil">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span><span class="ardoise-label">Accueil</span>
            </NavLink>
            @* Rubriques : ouvertes d'elles-mêmes sur l'une de leurs pages (classe « ouvert », SiteMenuBase), ouvertes et
               fermées d'un clic (app.js). Menu replié : leur icône seule, leurs pages à côté au survol. *@
            <div class="ardoise-group @(pokemonOpen ? "ouvert" : "")">
                <button type="button" class="ardoise-link ardoise-group-title" aria-expanded="@(pokemonOpen ? "true" : "false")" title="Mes Pokémon">
                    <span class="bi bi-pokeball-nav-menu" aria-hidden="true"></span><span class="ardoise-label">Mes Pokémon</span>
                </button>
                <div class="ardoise-subitems">
                    <span class="ardoise-subitems-title">Mes Pokémon</span>
                    <NavLink class="ardoise-link" href="collection">
                        <span class="ardoise-label">Ma collection</span>
                    </NavLink>
                    <NavLink class="ardoise-link" href="parc">
                        <span class="ardoise-label">Parc</span>
                    </NavLink>
                    <NavLink class="ardoise-link" href="transfert">
                        <span class="ardoise-label">Dépôt / Retrait</span>
                    </NavLink>
                    <NavLink class="ardoise-link" href="echange-interne">
                        <span class="ardoise-label">Échange interne</span>
                    </NavLink>
                </div>
            </div>
            <div class="ardoise-group @(inventoryOpen ? "ouvert" : "")">
                <button type="button" class="ardoise-link ardoise-group-title" aria-expanded="@(inventoryOpen ? "true" : "false")" title="Inventaire">
                    <span class="bi bi-bag-nav-menu" aria-hidden="true"></span><span class="ardoise-label">Inventaire</span>
                </button>
                <div class="ardoise-subitems">
                    <span class="ardoise-subitems-title">Inventaire</span>
                    <NavLink class="ardoise-link" href="inventaire" Match="NavLinkMatch.All">
                        <span class="ardoise-label">Banque d'objets</span>
                    </NavLink>
                    <NavLink class="ardoise-link" href="inventaire/transfert">
                        <span class="ardoise-label">Transfert d'inventaire</span>
                    </NavLink>
                </div>
            </div>
            <div class="ardoise-group @(challengesOpen ? "ouvert" : "")">
                <button type="button" class="ardoise-link ardoise-group-title" aria-expanded="@(challengesOpen ? "true" : "false")" title="Défis">
                    <span class="bi bi-trophy-nav-menu" aria-hidden="true"></span><span class="ardoise-label">Défis</span>
                </button>
                <div class="ardoise-subitems">
                    <span class="ardoise-subitems-title">Défis</span>
                    <NavLink class="ardoise-link" href="livingdex">
                        <span class="ardoise-label">Living dex</span>
                    </NavLink>
                    <NavLink class="ardoise-link" href="rubans">
                        <span class="ardoise-label">Rubans</span>
                    </NavLink>
                    <NavLink class="ardoise-link" href="completion">
                        <span class="ardoise-label">Complétion (100&nbsp;%)</span>
                    </NavLink>
                </div>
            </div>
            <div class="ardoise-group @(playersOpen ? "ouvert" : "")">
                <button type="button" class="ardoise-link ardoise-group-title" aria-expanded="@(playersOpen ? "true" : "false")" title="Multijoueurs">
                    <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span><span class="ardoise-label">Multijoueurs</span>
                    @if (PlayerRequests > 0)
                    {
                        <span class="ardoise-badge ardoise-group-badge" title="Demandes d'ami, d'échange et de combat reçues">@PlayerRequests</span>
                    }
                </button>
                <div class="ardoise-subitems">
                    <span class="ardoise-subitems-title">Multijoueurs</span>
                    <NavLink class="ardoise-link" href="joueurs">
                        <span class="ardoise-label">Rechercher un joueur</span>
                    </NavLink>
                    <NavLink class="ardoise-link" href="amis">
                        <span class="ardoise-label">Amis</span>
                        @if (pendingRequests > 0)
                        {
                            <span class="ardoise-badge" title="Demandes d'ami reçues">@pendingRequests</span>
                        }
                    </NavLink>
                    <NavLink class="ardoise-link" href="echanges">
                        <span class="ardoise-label">Échange</span>
                        @if (tradeRequests > 0)
                        {
                            <span class="ardoise-badge" title="Demandes d'échange reçues">@tradeRequests</span>
                        }
                    </NavLink>
                    <NavLink class="ardoise-link" href="combats">
                        <span class="ardoise-label">Combat</span>
                        @if (battleRequests > 0)
                        {
                            <span class="ardoise-badge" title="Demandes de combat reçues">@battleRequests</span>
                        }
                    </NavLink>
                </div>
            </div>
            <div class="ardoise-group @(savesOpen ? "ouvert" : "")">
                <button type="button" class="ardoise-link ardoise-group-title" aria-expanded="@(savesOpen ? "true" : "false")" title="Sauvegardes">
                    <span class="bi bi-save-nav-menu" aria-hidden="true"></span><span class="ardoise-label">Sauvegardes</span>
                </button>
                <div class="ardoise-subitems">
                    <span class="ardoise-subitems-title">Sauvegardes</span>
                    <NavLink class="ardoise-link" href="sauvegardes" Match="NavLinkMatch.All">
                        <span class="ardoise-label">Mes sauvegardes</span>
                    </NavLink>
                    <NavLink class="ardoise-link" href="sauvegardes/3ds">
                        <span class="ardoise-label">Synchronisation 3DS</span>
                    </NavLink>
                </div>
            </div>

            <AuthorizeView Roles="@MonsutaPotaru.Data.SiteRoles.Admin">
                <NavLink class="ardoise-link" href="administration" title="Administration">
                    <span class="bi bi-lock-nav-menu" aria-hidden="true"></span><span class="ardoise-label">Administration</span>
                </NavLink>
            </AuthorizeView>
        </nav>

        @* Le compte, en bas du menu (en plus de la pastille de la barre du haut) : rubrique au pseudo, ouverte d'elle-même
           sur ses pages ; menu replié, la pastille seule et ses pages à côté, au survol. Sans compte : inscription et
           connexion. *@
        <div class="ardoise-side-account">
            <AuthorizeView>
                <Authorized>
                    <div class="ardoise-group @(accountOpen ? "ouvert" : "")">
                        <button type="button" class="ardoise-link ardoise-group-title" aria-expanded="@(accountOpen ? "true" : "false")" title="Ton compte">
                            <span class="ardoise-avatar" aria-hidden="true">@Initial(context.User.Identity?.Name)</span><span class="ardoise-label">@context.User.Identity?.Name</span>
                        </button>
                        <div class="ardoise-subitems">
                            <span class="ardoise-subitems-title">@context.User.Identity?.Name</span>
                            <NavLink class="ardoise-link" href="Account/Manage">
                                <span class="ardoise-label">Paramètres du profil</span>
                            </NavLink>
                            <NavLink class="ardoise-link" href="statistiques">
                                <span class="ardoise-label">Statistiques</span>
                            </NavLink>
                            <form action="Account/Logout" method="post">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                                <button type="submit" class="ardoise-link">
                                    <span class="ardoise-label">Déconnexion</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <NavLink class="ardoise-link" href="Account/Register" title="Inscription">
                        <span class="bi bi-person-nav-menu" aria-hidden="true"></span><span class="ardoise-label">Inscription</span>
                    </NavLink>
                    <NavLink class="ardoise-link" href="Account/Login" title="Connexion">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span><span class="ardoise-label">Connexion</span>
                    </NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <button type="button" class="ardoise-link ardoise-collapse" title="Replier ou déplier le menu">
            <span class="ardoise-collapse-icon" aria-hidden="true"></span><span class="ardoise-label">Replier le menu</span>
        </button>
    </aside>
    @* Téléphone : le menu s'ouvre par-dessus la page ; un clic à côté le referme (app.js). *@
    <div class="ardoise-backdrop" aria-hidden="true"></div>

    <div class="ardoise-main">
        <header class="ardoise-topbar">
            <button type="button" class="ardoise-burger" aria-controls="ardoise-menu" aria-label="Ouvrir le menu"></button>

            <nav class="ardoise-breadcrumb" aria-label="Fil d'Ariane">
                <ol>
                    <li>
                        <a href="" title="Accueil"><span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span><span class="visually-hidden">Accueil</span></a>
                    </li>
                    @{ var crumbs = Breadcrumbs.For(currentUrl); }
                    @for (var i = 0; i < crumbs.Count; i++)
                    {
                        var crumb = crumbs[i];
                        <li>
                            @if (crumb.Href is null)
                            {
                                <span aria-current="@(i == crumbs.Count - 1 ? "page" : null)">@crumb.Label</span>
                            }
                            else
                            {
                                <a href="@crumb.Href">@crumb.Label</a>
                            }
                        </li>
                    }
                </ol>
            </nav>

            <div class="ardoise-topbar-end">
                <AuthorizeView>
                    <Authorized>
                        <WalletLink Class="ardoise-wallet" />
                        @* Menu du compte : élément details (marche sans interactivité) ; app.js le referme après un clic. *@
                        <details class="ardoise-account">
                            <summary title="Ton compte">
                                <span class="ardoise-avatar" aria-hidden="true">@Initial(context.User.Identity?.Name)</span>
                                <span class="ardoise-account-name">@context.User.Identity?.Name</span>
                            </summary>
                            <div class="ardoise-account-menu">
                                <a href="Account/Manage">
                                    <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Paramètres du profil
                                </a>
                                <a href="statistiques">
                                    <span class="bi bi-grid-nav-menu" aria-hidden="true"></span> Statistiques
                                </a>
                                <form action="Account/Logout" method="post">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                                    <button type="submit">
                                        <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Déconnexion
                                    </button>
                                </form>
                            </div>
                        </details>
                    </Authorized>
                    <NotAuthorized>
                        <a class="btn btn-sm btn-outline-secondary" href="Account/Register">Inscription</a>
                        <a class="btn btn-sm btn-primary" href="Account/Login">Connexion</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <main class="ardoise-content">
            @ChildContent
        </main>
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Première lettre du pseudo, en majuscule : la pastille du compte.</summary>
    private static string Initial(string? pseudo) =>
        string.IsNullOrEmpty(pseudo) ? "?" : char.ToUpper(pseudo[0], System.Globalization.CultureInfo.GetCultureInfo("fr-FR")).ToString();
}
